---
import DevNotice from "../../components/docs/DevNotice.astro";
// The docs landing (board Docs2Landing): search first, with a few examples;
// a door per product with four pages each; pages picked by hand; and the line
// that each product works alone. Links go through src/data/docs-homes.ts.
//
// The search box hands off to Starlight's: submitting opens the product's docs
// with the search dialog open and the words typed (PageFrame reads ?q=).
import { docsProducts } from "../../components/docs/products";
import { landing, page } from "../../data/docs-homes";
import Page from "../../layouts/Page.astro";

const line = {
  doze: "Wakes your stack when you start. Sleeps it when you stop.",
  aws: "Wakes AWS on your laptop. No account, no bill.",
  kafka: "Wakes a Kafka broker. No JVM to put to bed.",
};
const doors = docsProducts.map((p) => ({
  ...p,
  sub: landing.doors[p.id].sub,
  line: line[p.id],
  links: landing.doors[p.id].keys.map((k) => {
    const [key, label] = typeof k === "string" ? [k] : k;
    const to = page(p.id, key);
    return { ...to, title: label ?? to.title };
  }),
}));
const logo = Object.fromEntries(docsProducts.map((p) => [p.id, p]));
const picked = landing.picked.map((x) => {
  const to = page(x.product, x.key);
  const name = logo[x.product].name;
  const group = to.where.split(" › ")[0];
  return { ...x, href: to.href, logo: logo[x.product].logo, where: `${name} › ${group}` };
});
---
<Page title="Docs" description="Docs for doze, doze AWS and doze Kafka. Search first, or pick a product." theme="light" current="docs">
<DevNotice />
<div class="ld">
  <div class="ld-in">
    <div class="ld-top">
      <h1>Docs</h1>
      <p class="ld-lede">For doze, doze AWS and doze Kafka. Search first, or pick a product.</p>
      <form class="ld-form" role="search" action="/docs/doze/" method="get">
        <label for="docs-q" class="sr-only">Search the docs for doze, doze AWS and doze Kafka</label>
        <div class="ld-search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6E5F79" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="docs-q" type="search" name="q" placeholder="Search all docs" autocomplete="off" required aria-keyshortcuts="Meta+K Control+K" />
          <kbd aria-hidden="true">⌘K</kbd>
        </div>
      </form>
      <div class="ld-try"><span>Try:</span>{landing.tries.map((t) => <a href={`/docs/${t.product}/?q=${encodeURIComponent(t.q)}`}>{t.q}</a>)}</div>
    </div>

    <div class="ld-doors">
      {doors.map((d) => (
        <section class={`door door-${d.id}`} aria-label={`${d.name} docs`}>
          <div class="door-h"><img src={d.logo} alt="" width="52" height="52" /><div><b>{d.name}</b><span>{d.sub}</span></div></div>
          <p>{d.line}</p>
          <ul>
            {d.links.map((l) => <li><a href={l.href}>{l.title} <span aria-hidden="true">→</span></a></li>)}
          </ul>
          <a class="door-go" href={d.href}>{d.name} docs</a>
        </section>
      ))}
    </div>

    <section class="ld-pop-s" aria-labelledby="pop">
      <h2 id="pop">Pages to start with</h2>
      <p class="ld-sub">Picked by hand: doze collects no analytics, so there is no “most read” list.</p>
      <div class="ld-pop">
        {picked.map((x) => (
          <a href={x.href}><img src={x.logo} alt="" width="28" height="28" /><span><b>{x.title}</b><span>{x.where}</span></span></a>
        ))}
      </div>
    </section>

    <div class="ld-alone"><img src="/brand/family-ink.svg" alt="" width="30" height="30" /><span>Each product works alone. doze AWS and doze Kafka also run inside a doze stack: <code>doze add aws</code>, <code>doze add kafka</code>.</span></div>
  </div>
</div>
</Page>

<script>
  // ⌘K (or Ctrl+K) and "/" go to the search box, as the hint says.
  const input = document.querySelector<HTMLInputElement>("#docs-q");
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
    if (!input || !(cmdK || (e.key === "/" && !t.closest("input, textarea, [contenteditable]")))) return;
    e.preventDefault();
    input.focus();
  });
  // Off a Mac the shortcut is Ctrl+K.
  if (!/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
    const kbd = document.querySelector(".ld-search kbd");
    if (kbd) kbd.textContent = "Ctrl K";
  }
</script>

<style>
  .ld { font-family: var(--font-text); color: #140c1b; background: #fffaf4; }
  .ld a { color: #a85a0c; text-decoration: none; }
  .ld :focus-visible { outline: 2px solid #a85a0c; outline-offset: 2px; }
  .ld-in { box-sizing: content-box; max-width: 1240px; margin: 0 auto; padding: 0 32px 72px; }
  .ld-top { padding: 56px 0 40px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; }
  .ld h1 { margin: 0; font: 800 52px/1.05 var(--font-display); letter-spacing: -0.03em; }
  .ld-lede { margin: 0; font-size: 19px; line-height: 1.5; color: #4a3d55; }
  .ld-form { margin-top: 14px; width: 100%; max-width: 680px; }
  .ld-search { display: flex; align-items: center; gap: 12px; height: 60px; padding: 0 14px 0 20px; border-radius: 16px; border: 1px solid #dccfc2; background: #ffffff; box-shadow: 0 12px 30px rgba(20, 12, 27, 0.08); box-sizing: border-box; }
  .ld-search:focus-within { border-color: #a85a0c; box-shadow: 0 0 0 3px #ffe2b8, 0 12px 30px rgba(20, 12, 27, 0.08); }
  .ld-search svg { flex: none; }
  .ld-search input { flex: 1; min-width: 0; height: 56px; border: 0; outline: 0; background: transparent; font: 17px var(--font-text); color: #140c1b; }
  .ld-search input::placeholder { color: #6e5f79; }
  .ld-search kbd { flex: none; font: 13px var(--font-mono); color: #4a3d55; background: #fff4e8; border: 1px solid #eadfd3; border-radius: 6px; padding: 3px 8px; }
  .ld-try { font-size: 14px; color: #6e5f79; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; align-items: center; }
  .ld .ld-try a { background: #ffffff; border: 1px solid #eadfd3; border-radius: 999px; padding: 4px 12px; color: #4a3d55; min-height: 32px; box-sizing: border-box; display: inline-flex; align-items: center; }
  .ld .ld-try a:hover { border-color: #f0a24b; color: #140c1b; }

  .ld-doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .door { background: #ffffff; border: 1px solid #eadfd3; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .door-h { display: flex; align-items: center; gap: 14px; }
  .door-h img { width: 52px; height: 52px; border-radius: 13px; }
  .door-h b { display: block; font: 700 24px var(--font-display); letter-spacing: -0.015em; }
  .door-h span { font-size: 12.5px; color: #6e5f79; }
  .door p { margin: 0; font-size: 15.5px; line-height: 1.5; color: #4a3d55; }
  .door ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid #f0e6db; }
  .ld .door li a { display: flex; justify-content: space-between; align-items: center; min-height: 44px; box-sizing: border-box; padding: 10px 0; border-bottom: 1px solid #f0e6db; color: #140c1b; font-size: 15px; }
  .ld .door li a:hover { color: #a85a0c; }
  .door li a span { color: #a85a0c; }
  .ld .door-go { display: inline-flex; align-items: center; justify-content: center; height: 44px; border-radius: 10px; font-weight: 600; font-size: 14px; margin-top: auto; }
  .ld .door-doze .door-go { background: #f0a24b; color: #2a1534; }
  .ld .door-aws .door-go { background: #e3f2fb; color: #0c3a57; border: 1px solid #bfe0f3; }
  .ld .door-kafka .door-go { background: #fff6c7; color: #4a3d05; border: 1px solid #f1e39a; }
  .door-doze { border-top: 4px solid #f0a24b; }
  .door-aws { border-top: 4px solid #5bb8e8; }
  .door-kafka { border-top: 4px solid #ffd60a; }

  .ld-pop-s { margin-top: 48px; }
  .ld h2 { margin: 0 0 6px; font: 700 26px var(--font-display); letter-spacing: -0.015em; }
  .ld-sub { margin: 0 0 16px; font-size: 15px; color: #6e5f79; }
  .ld-pop { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .ld .ld-pop a { display: flex; gap: 12px; align-items: center; background: #ffffff; border: 1px solid #eadfd3; border-radius: 14px; padding: 14px 16px; color: #140c1b; }
  .ld .ld-pop a:hover { border-color: #f0a24b; }
  .ld-pop img { width: 28px; height: 28px; border-radius: 7px; flex: none; }
  .ld-pop b { display: block; font-weight: 600; font-size: 15px; }
  .ld-pop a > span > span { font-size: 13px; color: #6e5f79; }
  .ld-alone { margin: 40px 0 0; padding: 18px 22px; border-radius: 14px; background: #fff4e8; border: 1px solid #eadfd3; font-size: 15px; line-height: 1.5; color: #4a3d55; display: flex; gap: 14px; align-items: center; }
  .ld-alone img { flex: none; }
  .ld-alone code { font: 13px var(--font-mono); font-variant-ligatures: none; }

  @media (max-width: 1000px) {
    .ld-doors, .ld-pop { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .ld-top { padding: 36px 0 28px; }
    .ld h1 { font-size: 40px; }
    .ld-lede { font-size: 17px; }
    .ld-search { padding: 0 12px 0 14px; }
    .ld-search kbd { display: none; }
    .ld-alone { align-items: flex-start; }
  }
</style>
