---
// doze, the product. The app leads (design/BRAND.md): hero and the window,
// then a guided tour of the app, then "everything is a command too", one
// file, the pains it fixes, any language, compared, install.
import "../components/product/product.css";
import DomainsTeaser from "../components/domains/Teaser.astro";
import FirstStack from "../components/doze/FirstStack.astro";
import MenuBar from "../components/doze/MenuBar.astro";
import { maybe, pick } from "../components/doze/media";
import Themes from "../components/doze/Themes.astro";
import Views from "../components/doze/Views.astro";
import VCarousel from "../components/motion/VCarousel.astro";
import Cmd from "../components/product/Cmd.astro";
import Endorse from "../components/product/Endorse.astro";
import Family from "../components/product/Family.astro";
import Shot from "../components/product/Shot.astro";
import SubNav from "../components/product/SubNav.astro";
import Page from "../layouts/Page.astro";

// ── The media map ─────────────────────────────────────────────────────────
// Each entry: what we want first, then stand-ins, as [file in public/media, alt].
// The first file that exists is shown, so a new capture replaces its stand-in
// by being dropped into public/media; reorder or edit a line here to change one.
const demo = "from the demo stack";
const media = {
  hero: pick(
    [
      "app-rec-request-wakes.webm",
      "A request reaches Larder's gateway in the doze app, and the services it needs wake one after another",
    ],
    [
      "app-overview-map.webp",
      "The doze app's map of the Larder stack: who needs whom, and what is awake, dozing or asleep",
    ],
    ["app-map.webp", `The doze app's map of a stack, ${demo}: who needs whom, and what is awake, dozing or asleep`],
  ),
  library: pick(
    ["app-library.webp", "The doze app's Library: every stack on this Mac, each with its switch"],
    ["app-stack.webp", `The doze app's tiles for one stack, ${demo}`],
  ),
  tiles: pick(
    ["app-overview-tiles.webp", "Larder as tiles: every service with its state, memory and address"],
    ["app-stack.webp", `A stack as tiles, ${demo}: every service with its state, memory and address`],
  ),
  list: pick(
    ["app-overview-list.webp", "Larder as a list: one row per service"],
    ["app-rec-views.webm", "Switching a stack between tiles, list and map"],
    ["tour-views.webm", `Switching a stack between tiles, list and map, ${demo}`],
  ),
  map: pick(
    ["app-overview-map.webp", "Larder as a map: who needs whom"],
    ["app-map.webp", `A stack as a map, ${demo}: who needs whom`],
  ),
  sleep: pick(
    [
      "app-rec-cascade.webm",
      "Switching Postgres off in Larder; doze offers to sleep the services that need it, and memory comes back",
    ],
    [
      "tour-cascade.webm",
      `Switching a database off; doze offers to sleep the service that needs it, and memory drops, ${demo}`,
    ],
  ),
  inside: pick(
    ["app-service-gateway.webp", "Inside Larder's gateway: its state, its address and its logs by run"],
    ["app-logs.webp", "A service's logs in the doze app, grouped by run"],
    ["app-module-postgres.webp", "Larder's Postgres inside the doze app, with its console"],
    ["app-stack.webp", `The doze app's tiles for one stack, ${demo}`],
  ),
  palette: pick(
    ["app-rec-palette.webm", "Typing wake and a service name in the doze command palette, then return"],
    ["app-palette.webp", "The doze command palette with a verb and a name typed"],
    ["tour-palette.webm", `Typing wake and a service name in the command palette, ${demo}`],
  ),
  needs: pick(
    ["app-needs-you.webp", "Needs you: what went wrong in Larder, each with its fix"],
    ["tour-needs-you.webm", `The Needs you panel with two items and their fixes, ${demo}`],
  ),
  menubar: maybe([
    "app-menubar.webp",
    "The doze menu in the macOS menu bar: every stack, and Quit doze, stacks keep running",
  ]),
  themes: maybe(["app-light.webp", "The doze app in a light theme"]),
};

const tour = [
  {
    label: "Library",
    title: "Every stack on this machine. A switch each.",
    say: "Open doze and every project you've brought up is there, running or not. One switch brings a whole stack up; the same switch puts it to bed.",
    cli: ["doze", "doze status"],
    m: media.library,
  },
  {
    label: "Tiles, list, map",
    title: "One stack, three ways.",
    say: "Tiles for how each service is doing, a list when there are many, and a map that draws who needs whom. Awake, waking, dozing, asleep: the same four words everywhere.",
    cli: ["doze status"],
    views: true,
  },
  {
    label: "Wake and sleep",
    title: "Turn one off. What needs it follows.",
    say: "Switch a database off and doze asks whether the services that need it should sleep too; the memory comes back. Switch one on and it wakes with what it depends on.",
    cli: ["doze sleep postgres", "doze wake catalog"],
    m: media.sleep,
  },
  {
    label: "Inside a service",
    title: "Its logs, its address, its console.",
    say: "Logs grouped by run, so this run isn't buried under yesterday's. The connect line, one click to copy. And for a module like Postgres, its own console in the window.",
    cli: ["doze logs gateway", "doze url postgres"],
    m: media.inside,
  },
  {
    label: "⌘K",
    title: "⌘K. A verb and a name.",
    say: "Type “wake cat”, press return. Sleep, wake, restart, pin, logs, copy, open, up, down: every action is a few keys away, across every stack.",
    cli: ["doze wake catalog"],
    m: media.palette,
  },
  {
    label: "Needs you",
    title: "What's wrong, with its fix.",
    say: "A crash, a task that failed, a mistake in doze.hcl: each says what happened and offers the fix. A broken file shows the line and exactly what to write.",
    cli: [],
    m: media.needs,
  },
  {
    label: "Menu bar",
    title: "Every stack, from the menu bar.",
    say: "The bat stays in the menu bar after the window closes: each stack and how it's doing, a red dot when something needs you. Quit doze and your stacks keep running.",
    cli: ["doze up", "doze down"],
    m: media.menubar,
    drawn: "menubar",
  },
  {
    label: "Themes",
    title: "Five themes, in light and dark.",
    say: "Violet, teal, burgundy, amber and slate, each light or dark, or following your Mac. A module's console opens in the same light.",
    cli: [],
    m: media.themes,
    drawn: "themes",
  },
];
const views = [
  { name: "Tiles", media: media.tiles, alt: media.tiles.alt },
  { name: "List", media: media.list, alt: media.list.alt },
  { name: "Map", media: media.map, alt: media.map.alt },
];
const viewsPending = views.some((v) => v.media.pending) ? ["app-overview-tiles / list / map"] : [];
const pad = (n: number) => String(n).padStart(2, "0");

const commands: [string, string][] = [
  ["Flip a stack on", "doze up"],
  ["Flip a service on", "doze wake catalog"],
  ["Switch it off, keep its data", "doze sleep postgres"],
  ["Keep it awake through a demo", "doze pin postgres"],
  ["Read what it printed", "doze logs gateway"],
  ["Copy its connect line", "doze url postgres"],
  ["Put the stack to bed", "doze down"],
  ["Hand it to a script, or an agent", "doze status --json"],
];

const pains = [
  {
    old: "npm run dev · make api · ./worker.sh",
    title: "Which terminal was that?",
    fix: "Seven things, seven ways to start them. doze.hcl says how each one runs, doze up starts them all, and the app keeps each one's logs.",
  },
  {
    old: "port 5432 is already allocated",
    title: "Port roulette.",
    fix: "Every service gets a name of its own, like gateway.larder.doze in our example. Two projects can both have their 5432, and you stop keeping ports in your head.",
  },
  {
    old: "fans: full tilt · battery 31%",
    title: "The fan.",
    fix: "No VM holding every database all day. Native processes that sleep when nothing calls (after two minutes, in Larder) and wake on the next connection.",
  },
  {
    old: "“I can't see your running services”",
    title: "The AI that can't see your machine.",
    fix: "Every command answers in --json: status, logs, the connect line. The agent in your terminal can read your stack instead of guessing at it.",
  },
  {
    old: "SETUP.md · last updated 2023",
    title: "Coming back after months.",
    fix: "The setup doc is doze.hcl, and it runs. Clone, doze up, and the map shows the services you've never met and who needs whom.",
  },
  {
    old: "docker ps -a · 23 exited",
    title: "Closing the lid with 23 things up.",
    fix: "Quiet services already went to sleep on their own. The menu bar shows what's still awake, and doze down puts a whole stack to bed.",
  },
];
---
<Page notice title="doze, the app" description="doze wakes your stack when you start and sleeps it when you stop. A Mac app first, every switch a command too: Postgres, Kafka, a local AWS and your own services, native, no VM." current="doze">
<div class="pp pp-doze dz">
  <SubNav name="doze" icon="/brand/doze.svg" links={[["First stack", "#start"], ["The app", "#app"], ["Commands", "#cli"], ["One file", "#file"], ["Why", "#why"], ["Any language", "#polyglot"], ["Your domain", "/doze/domains/"], ["Compared", "#compare"], ["Install", "#install"], ["Docs", "/docs/doze/"]]} />

  <!-- Hero: the product's own identity, then the window, big -->
  <section class="pp-hero dz-hero">
    <div class="pp-wrap dz-hero-in">
      <span class="pp-lockup"><img src="/brand/doze.svg" alt="" width="112" height="112" /><b>doze</b></span>
      <h1 class="pp-h1 dz-h1"><span>Wakes your stack when you start.</span> <span class="pp-soft">Sleeps it when you stop.</span></h1>
      <p class="pp-tag">Run your whole stack. Feel none of it.</p>
      <p class="pp-lede dz-hero-lede">Postgres, Kafka, a whole local AWS and your own services, running natively on your Mac, each awake only while your code is using it. No VM. No port clashes. No setup doc.</p>
      <div class="dz-cta">
        <a class="pp-btn pp-btn-acc" href="/download/"><img src="/brand/doze.svg" alt="" width="22" height="22" />Get the doze app</a>
        <div class="dz-cta-cmd"><Cmd cmd="brew install --cask doze-dev/tap/doze" label="Copy the Homebrew install command" /></div>
      </div>
      <span class="pp-small">Free and open source · macOS on Apple silicon · Linux x86_64 and arm64 · no account, no telemetry</span>
      <Endorse />
    </div>
    <div class="dz-hero-win">
      <Shot src={media.hero.src} alt={media.hero.alt} title="doze" glow eager />
      <p class="pp-cap"><span class="pp-breathe" aria-hidden="true"></span>&nbsp; The doze app. Close the window and it stays in your menu bar; quit it and your stacks keep running.
        {media.hero.pending && <> <span class="pp-pending">stand-in {demo} · {media.hero.pending} pending</span></>}</p>
    </div>
  </section>

  <!-- Your first stack, in the app: before the tour, the way in -->
  <div class="pp-sec dz-first">
    <div class="pp-wrap dz-first-in">
      <FirstStack id="start" title="Drop a folder. Flip a switch." sub="Before the tour, the way in: from a fresh install to a running stack in three steps, all in the window." />
    </div>
  </div>

  <!-- The app, a guided tour -->
  <section class="pp-sec dz-tour" id="app">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">The app, a guided tour</span>
        <h2 class="pp-h2">See your whole stack. Touch nothing.</h2>
        <p class="pp-lede">doze is an app first. Eight stops, each a real screen. Scroll inside the frame, use the arrow keys, or pick a stop from the dots.</p>
      </div>
      <VCarousel label="The doze app, a guided tour" height="min(780px, 86vh)" class="pp-vc">
        {tour.map((s, i) => {
          const pending = s.views ? viewsPending.join(", ") : s.m ? s.m.pending : undefined;
          return (
            <div data-slide data-label={s.label} class="pp-slide dz-slide">
              <div class="pp-slide-top">
                <div>
                  <span class="pp-step">{pad(i + 1)} / {pad(tour.length)} · {s.label}</span>
                  <h3>{s.title}</h3>
                </div>
                <div class="pp-slide-say">
                  <p>{s.say}</p>
                  <span class="pp-also">
                    {s.cli.length > 0 && <>From a terminal {s.cli.map((c) => <code>{c}</code>)}</>}
                    {pending && <span class="pp-pending">stand-in {demo} · {pending} pending</span>}
                    {!s.m && s.drawn && <span class="pp-pending">drawn from the app's own {s.drawn === "menubar" ? "menu" : "theme tokens"} · capture pending</span>}
                  </span>
                </div>
              </div>
              <div class="pp-slide-media">
                {s.views ? <Views views={views} />
                  : s.m ? <Shot src={s.m.src} alt={s.m.alt} title={s.label === "Menu bar" ? "" : "doze"} />
                  : s.drawn === "menubar" ? <div class="dz-drawn"><MenuBar /></div>
                  : <div class="pp-slide-panel dz-drawn"><Themes /></div>}
              </div>
            </div>
          );
        })}
      </VCarousel>
    </div>
  </section>

  <!-- Everything is a command too -->
  <section class="pp-sec pp-sec-tint" id="cli">
    <div class="pp-wrap dz-cli">
      <div class="dz-cli-say" data-reveal>
        <span class="pp-eyebrow">And everything is a command too</span>
        <h2 class="pp-h2">Every switch is a command.</h2>
        <p class="pp-lede">So a script, a Makefile or CI can do what you just clicked. Over SSH, with no screen, <code class="dz-c">doze</code> is a dash in your terminal; piped, it prints the status table.</p>
        <dl class="dz-map">
          {commands.map(([app, cmd]) => <div><dt>{app}</dt><dd><code>{cmd}</code></dd></div>)}
        </dl>
      </div>
      <div class="dz-cli-term" data-reveal>
        <div class="pp-term-head"><span>~/code/larder</span><span>our example project</span></div>
        <pre class="pp-term"><span class="c">$</span> <span class="w">doze up</span>
<span class="k">✓</span> migrate-catalog, migrate-orders … ran
<span class="k">✓</span> storefront  <span class="a">http://storefront.larder.doze</span>
<span class="k">✓</span> gateway     <span class="a">http://gateway.larder.doze</span>
<span class="c">○</span> catalog     asleep, wakes on a connection
<span class="c">○</span> mailpit     asleep, wakes on a connection

<span class="c">$</span> <span class="w">psql "$(doze url postgres)"</span>
<span class="c"># its connection string; postgres wakes on the connection</span>

<span class="c">$</span> <span class="w">doze run -- go test ./...</span>
<span class="c"># the same file runs your tests in CI</span></pre>
      </div>
    </div>
  </section>

  <!-- One file -->
  <section class="pp-sec" id="file">
    <div class="pp-wrap dz-file">
      <div class="dz-file-say" data-reveal>
        <span class="pp-eyebrow">One file in your repo</span>
        <h2 class="pp-h2">Onboarding is <code class="dz-c dz-c-big">doze up</code>.</h2>
        <p class="pp-lede">doze.hcl says what your app needs; doze.lock pins every engine, byte for byte, so your Postgres is your teammate's Postgres. This is a slice of the one in <a href="/examples/">Larder</a>, a made-up grocery service we built as our example: seven services in Go, Python and TypeScript, a gateway and a web shop.</p>
        <ul class="dz-ticks">
          <li>One Postgres, a role and a schema per service</li>
          <li>Connection strings that wire themselves</li>
          <li>Migrations that run once, before the code that needs them, and again only when a .sql file changes</li>
          <li>Kafka topics declared as contracts, not created by whoever writes first</li>
          <li>Your own domain over https, for when OAuth refuses localhost: <code class="dz-c">doze trust</code></li>
        </ul>
        <a class="pp-more" href="https://github.com/doze-dev/doze-examples/blob/main/larder/doze.hcl">Read all of Larder's doze.hcl on GitHub →</a>
      </div>
      <div data-reveal>
        <div class="pp-term-head"><span>larder/doze.hcl</span><span>a slice</span></div>
        <pre class="pp-term dz-hcl"><span class="w">stack</span> = <span class="s">"larder"</span>

<span class="a">defaults</span> &#123;
  sleep = <span class="s">"2m"</span>
&#125;

<span class="a">module</span> postgres <span class="s">"postgres"</span> &#123;
  version = <span class="n">18</span>
  role   <span class="s">"catalog"</span> &#123; password = <span class="s">"catalog"</span> &#125;
  schema <span class="s">"catalog"</span> &#123; owner = <span class="s">"catalog"</span> &#125;
&#125;

<span class="a">module</span> kafka <span class="s">"kafka"</span> &#123;
  version            = <span class="n">4</span>
  auto_create_topics = <span class="n">false</span>
  topic <span class="s">"orders.placed"</span> &#123; partitions = <span class="n">3</span> &#125;
&#125;

<span class="a">task</span> <span class="s">"migrate-catalog"</span> &#123;
  run    = <span class="s">"go run ./platform/cmd/migrate services/catalog/migrations"</span>
  inputs = [<span class="s">"services/catalog/migrations/*.sql"</span>]
&#125;

<span class="a">app</span> <span class="s">"catalog"</span> &#123;
  run   = <span class="s">"go run ./services/catalog"</span>
  port  = <span class="n">8002</span>
  after = [task.migrate-catalog]
  env = &#123;
    DATABASE_URL = <span class="s">"postgres://catalog:catalog@$&#123;module.postgres.address&#125;/postgres"</span>
  &#125;
&#125;</pre>
      </div>
    </div>
  </section>

  <!-- Your own domain, over https -->
  <div class="pp-sec dz-dom">
    <div class="pp-wrap">
      <DomainsTeaser id="dz-domains" />
    </div>
  </div>

  <!-- The pains, and what doze does about each -->
  <section class="pp-sec pp-sec-tint" id="why">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Sound familiar?</span>
        <h2 class="pp-h2">Nobody designed your local setup. It grew.</h2>
        <p class="pp-lede">Containers, brew services, half-remembered ports and a setup doc that worked once. Here is each small embarrassing truth, and what changes.</p>
      </div>
      <div class="dz-pains">
        {pains.map((p) => (
          <article class="dz-pain" data-reveal>
            <span class="pp-chip">{p.old}</span>
            <h3 class="pp-h3">{p.title}</h3>
            <p>{p.fix}</p>
          </article>
        ))}
      </div>
      <article class="dz-moved" data-reveal>
        <div class="dz-moved-say">
          <span class="pp-eyebrow">And the big one</span>
          <h3 class="dz-moved-h">Local development didn't get fixed. It got moved.</h3>
          <p>Teams gave up on local and moved to remote dev environments run by a platform team. Debuggers that won't attach through the tunnel. Port-forwards to juggle. Logs in another tool. And when the dev environment is down, with no ETA and the platform team busy with production, nobody can work. You needed a platform team just to write code, while the most powerful machine you've ever owned sat on your desk.</p>
        </div>
        <ul class="dz-moved-fix">
          <li><b>It all runs on your laptop again,</b> natively, one file per repo.</li>
          <li><b>A breakpoint just hits.</b> Your debugger attaches to a local process.</li>
          <li><b>Nobody's pager is involved.</b> Your stack is down when you closed the lid, not when someone else's cluster is.</li>
          <li><b>Platform teams build the platform</b> instead of babysitting dev boxes.</li>
        </ul>
        <a class="dz-moved-link" href="/the-long-way-round/">Take the long way round <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <!-- Polyglot -->
  <section class="pp-sec" id="polyglot">
    <div class="pp-wrap">
      <div class="dz-poly-head" data-reveal>
        <div class="pp-head">
          <span class="pp-eyebrow">Polyglot by default</span>
          <h2 class="pp-h2">doze runs the command you'd run.</h2>
          <p class="pp-lede">No SDK, no base image, no plugin per language. Each team keeps its toolchain; doze gives every service a name, a port, its connection strings, and sleep.</p>
        </div>
        <a class="pp-more" href="/examples/">See all three in Larder →</a>
      </div>
      <div class="dz-langs">
        <div class="dz-lang" data-reveal><b><i style="background:#5BB8E8"></i>Go</b><span>gateway, identity, catalog, orders, payments</span><code>run = "go run ./services/orders"</code></div>
        <div class="dz-lang" data-reveal><b><i style="background:#FFD60A"></i>Python</b><span>fulfilment and recommendations, with uv</span><code>run = "uv run --frozen python -m fulfilment"</code></div>
        <div class="dz-lang" data-reveal><b><i style="background:#F0A24B"></i>TypeScript</b><span>notifications and the storefront, on bun</span><code>run = "bun run dev"</code></div>
        <div class="dz-lang dz-lang-any" data-reveal><b><i style="background:#8BE39B"></i>Anything else</b><span>If it starts from your terminal, it starts from doze.hcl.</span><code>run = "[the command you type today]"</code></div>
      </div>
    </div>
  </section>

  <!-- Compared -->
  <section class="pp-sec pp-sec-tint" id="compare">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Compared</span>
        <h2 class="pp-h2">doze or docker compose?</h2>
        <p class="pp-lede">Both are good tools. Containers win at shipping. For the code you write all day, here is what changes.</p>
      </div>
      <div class="dz-cmp" data-reveal>
        <table>
          <thead><tr><th><span class="sr-only">Question</span></th><th class="dz-cmp-me">doze</th><th>docker compose</th></tr></thead>
          <tbody>
            <tr><th scope="row">What runs</th><td data-l="doze">Native processes</td><td data-l="docker compose">Containers in a Linux VM</td></tr>
            <tr><th scope="row">While you're in a meeting</th><td data-l="doze">Asleep</td><td data-l="docker compose">Running</td></tr>
            <tr><th scope="row">Memory at rest</th><td data-l="doze">[measured, named Mac]</td><td data-l="docker compose">[measured, same Mac]</td></tr>
            <tr><th scope="row">Your debugger</th><td data-l="doze">Attaches to a local process</td><td data-l="docker compose">Crosses a VM boundary</td></tr>
            <tr><th scope="row">Two projects on 5432</th><td data-l="doze">Fine: each has its own address</td><td data-l="docker compose">Remap one by hand</td></tr>
            <tr><th scope="row">Three languages in one repo</th><td data-l="doze">Each runs with its own toolchain</td><td data-l="docker compose">A Dockerfile per service</td></tr>
            <tr><th scope="row">https on your own domain</th><td data-l="doze">One line, one password prompt</td><td data-l="docker compose">A proxy and a CA you set up</td></tr>
            <tr><th scope="row">Shipping to production</th><td data-l="doze">Not its job</td><td data-l="docker compose">Images you can ship</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section class="pp-sec" id="install">
    <div class="pp-wrap">
      <div class="dz-inst-head" data-reveal>
        <div class="pp-head">
          <span class="pp-eyebrow">Install</span>
          <h2 class="pp-h2">Fans off. Stack on.</h2>
          <p class="pp-lede">doze 0.2 · [0.2 release date] · <a href="/changelog/">what's new</a></p>
        </div>
        <a class="pp-more" href="/download/">Every way to install →</a>
      </div>
      <div class="dz-inst">
        <div class="dz-inst-app" data-reveal>
          <div class="dz-inst-top">
            <img src="/brand/doze.svg" alt="" width="56" height="56" />
            <div>
              <span class="dz-inst-k">Start here</span>
              <h3 class="pp-h3">Get the app</h3>
            </div>
          </div>
