---
// doze, the product (design: Doze). The app, one file, any language, compared, install.
import Popular from "../components/home/Popular.astro";
import Tour from "../components/home/Tour.astro";
import Page from "../layouts/Page.astro";
---
<Page title="The app and the CLI" current="doze">
<div class="dz dz-s1">
  <div class="dz-sub dz-s2">
    <nav class="dz-s3" aria-label="On this page">
      <span class="dz-s4"><span class="dz-s5"></span>doze</span>
      <a href="#before">Before and after</a><a href="#app">The app</a><a href="#file">One file</a><a href="#polyglot">Any language</a><a href="#compare">Compared</a><a href="#download">Install</a><a href="/docs/doze/">Docs</a>
    </nav>
  </div>

  <!-- Hero -->
  <section class="dz-s6">
    <img class="dz-s7" src="/brand/doze.svg" alt="doze">
    <h1 class="dz-hero-title dz-s8">The local stack that knows when to quit.</h1>
    <p class="dz-s9">Postgres, MariaDB, Valkey, Kafka, Temporal and a local AWS, running natively, each awake only while your code is using it. No VM. No port clashes. No setup doc.</p>
    <div class="dz-stack-sm dz-s10">
      <a class="dz-btn dz-btn-lamp" href="/download/">Download for Mac</a>
      <a class="dz-btn dz-btn-ghost" href="/docs/doze/">Your first stack</a>
    </div>
    <span class="dz-s11">Free and open source · macOS on Apple silicon · Linux x86_64 and arm64</span>
  </section>

  <!-- The real app -->
  <section class="dz-s12">
    <div class="dz-s13"></div>
    <div class="dz-s14">
      <div class="dz-s15"><span class="dz-s16"></span><span class="dz-s17"></span><span class="dz-s18"></span><span class="dz-s19">doze</span></div>
      <img class="dz-s20" src="/media/app-stack.webp" alt="The doze app's tiles for a demo stack, with memory, cores and every service awake, dozing, waking or asleep">
    </div>
    <p class="dz-s21">The doze app, from its demo stack. <span class="dz-recap">[re-capture with Larder]</span></p>
  </section>

  <!-- Before / after -->
  <section class="dz-s22" id="before">
    <h2 class="dz-h2 dz-s23">Monday morning, two ways.</h2>
    <div class="dz-s24">
      <div class="dz-s25">
        <span class="dz-s26">The usual</span>
        <pre class="dz-term dz-s27"><span class="dz-s28">$</span> docker compose up
Error: Bind for 0.0.0.0:5432 failed:
  port is already allocated
<span class="dz-s28">$</span> lsof -i :5432          <span class="dz-s28"># who is it this time</span>
<span class="dz-s28">$</span> brew services stop postgresql@14
<span class="dz-s28">$</span> docker compose up
kafka-1  | waiting for controller quorum…
<span class="dz-s28">$</span> cp .env.example .env    <span class="dz-s28"># then ask in Slack</span>
<span class="dz-s28"># 40 minutes later, fans at full tilt</span></pre>
      </div>
      <div class="dz-s25">
        <span class="dz-s29">With doze, on Larder</span>
        <pre class="dz-term dz-s30"><span class="dz-s31">$</span> doze up
<span class="dz-s32">✓</span> migrate-catalog, migrate-orders … ran
<span class="dz-s32">✓</span> storefront  http://storefront.larder.doze
<span class="dz-s32">✓</span> gateway     http://gateway.larder.doze
<span class="dz-s31">○</span> catalog     asleep, wakes on a connection
<span class="dz-s31">○</span> mailpit     asleep, wakes on a connection

<span class="dz-s31"># that's it. go write code.</span></pre>
      </div>
    </div>
  </section>

  <!-- See it move: real recordings -->
  <section class="dz-s33" id="live">
    <div class="dz-s34">
      <span class="dz-eyebrow">See it move</span>
      <h2 class="dz-h2 dz-s35">Six things you'll do on day one.</h2>
      <p class="dz-s36">Each one recorded from the real app. Pick one.</p>
    </div>
    <Tour set="doze" />
  </section>

  <!-- The app: product-true fragments -->
  <section class="dz-s37" id="app">
    <div class="dz-s38">
      <div class="dz-s34">
        <span class="dz-eyebrow">The app</span>
        <h2 class="dz-h2">See your whole stack. Touch nothing.</h2>
        <p class="dz-s36">What's awake, what's asleep, what needs you. Wake or sleep a whole stack in one click, from the window or the menu bar.</p>
      </div>

      <div class="dz-s39">
        <!-- Fragment 1: tiles mid-wake -->
        <figure class="dz-s40">
          <div class="dz-s41">
            <div class="dz-s42"><b class="dz-s43">larder</b><span class="dz-s44">~/code/larder · up [41 min]</span></div>
            <div class="dz-tiles dz-s45">
              <div class="dz-tile"><b>● gateway</b><span class="dz-s46">awake · [3] connections</span><span class="dz-s47">gateway.<wbr>larder.<wbr>doze</span></div>
              <div class="dz-tile"><b>◐ catalog</b><span class="dz-s48">waking · gateway asked for it</span><span class="dz-s47">catalog.<wbr>larder.<wbr>doze</span></div>
              <div class="dz-tile"><b>◐ redis</b><span class="dz-s49">dozing · sleeps in [1:12]</span><span class="dz-s47">redis.<wbr>larder.<wbr>doze:6379</span></div>
              <div class="dz-tile dz-s50"><b class="dz-s51">○ mailpit</b><span class="dz-s44">asleep · wakes on a connection</span><span class="dz-s47">mailpit.<wbr>larder.<wbr>doze</span></div>
            </div>
          </div>
          <figcaption class="dz-s52"><b class="dz-s53">Every service, at a glance.</b> Awake, waking, dozing, asleep: the four words doze uses everywhere.</figcaption>
        </figure>

        <!-- Fragment 2: the menu bar -->
        <figure class="dz-s40">
          <div class="dz-s54">
            <div class="dz-s55">
              <div class="dz-s56">Needs you</div>
              <div class="dz-mi dz-s57"><span>● acme · postgres crashed</span><span class="dz-s58">Fix…</span></div>
              <div class="dz-s59"></div>
              <div class="dz-s60">Stacks</div>
              <div class="dz-mi"><span>●&#160;&#160;larder</span><span class="dz-s58">›</span></div>
              <div class="dz-mi"><span>●&#160;&#160;acme</span><span class="dz-s58">›</span></div>
              <div class="dz-mi"><span>○&#160;&#160;billing</span><span class="dz-s58">›</span></div>
              <div class="dz-s59"></div>
              <div class="dz-mi"><span>Open doze</span><span class="dz-s58">⇧⌘D</span></div>
              <div class="dz-mi"><span>Settings…</span><span class="dz-s58">⌘,</span></div>
              <div class="dz-mi"><span>Quit doze · stacks keep running</span></div>
            </div>
          </div>
          <figcaption class="dz-s52"><b class="dz-s53">Lives in your menu bar.</b> Every stack one click from awake or asleep. Quit the app and your stacks keep running.</figcaption>
        </figure>

        <!-- Fragment 3: a mistake, explained -->
        <figure class="dz-s40">
          <div class="dz-s61">
            <b class="dz-s62">doze.hcl has a mistake</b>
            <div class="dz-s63">
              <div class="dz-s64">19&#160;&#160;defaults &#123;</div>
              <div class="dz-s65">20&#160;&#160;&#160;&#160;idle_timeout = "2m"</div>
              <div class="dz-s64">21&#160;&#160;&#125;</div>
            </div>
            <span class="dz-s66">`idle_timeout` is now `sleep`</span>
            <div class="dz-s67"><span class="dz-s68">To fix it</span>Write: sleep = "2m"</div>
          </div>
          <figcaption class="dz-s52"><b class="dz-s53">Mistakes that explain themselves.</b> The file, the line, and exactly what to write.</figcaption>
        </figure>
      </div>
      <span class="dz-s44">Drawn from the app's own screens and wording, in its brand theme, with Larder's names.</span>
    </div>
  </section>

  <!-- One file -->
  <section id="file" class="dz-file-grid dz-s69">
    <div class="dz-s70">
      <span class="dz-eyebrow">One file in your repo</span>
      <h2 class="dz-h2">Onboarding is <code class="dz-s71">doze up</code>.</h2>
      <p class="dz-s36">doze.hcl says what your app needs. Connection strings wire themselves, and doze.lock pins every engine, byte for byte, so your Postgres is your teammate's Postgres. This is a slice of Larder's.</p>
      <ul class="dz-s72">
        <li>One Postgres, a role and a schema per service</li>
        <li>Your own domain over https, for when OAuth refuses localhost</li>
        <li>Migrations that run once, before the code that needs them</li>
        <li>The same file runs your tests in CI: <code class="dz-s73">doze run -- go test ./...</code></li>
        <li>Postgres extensions by name, <span class="dz-s31">coming in postgres 0.3</span></li>
      </ul>
      <a class="dz-s74" href="https://github.com/doze-dev/doze-examples/blob/main/larder/doze.hcl">Read all of Larder's doze.hcl on GitHub →</a>
    </div>
    <pre class="dz-term dz-s75"><span class="dz-s31"># doze.hcl</span>
stack = "larder"

module postgres "postgres" &#123;
  version = 18
  role   "catalog" &#123; password = "catalog" &#125;
  schema "catalog" &#123; owner = "catalog" &#125;
&#125;

module valkey "redis" &#123; version = 9 &#125;

task "migrate-catalog" &#123;
  run    = "go run ./platform/cmd/migrate services/catalog/migrations"
  inputs = ["services/catalog/migrations/*.sql"]
&#125;

app "catalog" &#123;
  run   = "go run ./services/catalog"
  port  = 8002
  after = [task.migrate-catalog]
  env   = &#123;
    DATABASE_URL = "postgres://catalog:catalog@$&#123;module.postgres.address&#125;/postgres?sslmode=disable"
  &#125;
&#125;</pre>
  </section>

  <!-- Polyglot by default -->
  <section class="dz-s37" id="polyglot">
    <div class="dz-s76">
      <div class="dz-s77">
        <div class="dz-s78">
          <span class="dz-eyebrow">Polyglot by default</span>
          <h2 class="dz-h2">doze runs the command you'd run.</h2>
          <p class="dz-s36">No SDK, no base image, no plugin per language. Each team keeps its toolchain; doze gives every service a name, a port, its connection strings, and sleep.</p>
        </div>
        <a class="dz-s79" href="/examples/">See all three in Larder →</a>
      </div>
      <div class="dz-s80">
        <div class="dz-poly"><b class="dz-s81"><span class="dz-lang-dot dz-s82"></span>Go</b><span class="dz-s83">gateway, identity, catalog, orders, payments</span><code>run = "go run ./services/orders"</code></div>
        <div class="dz-poly"><b class="dz-s81"><span class="dz-lang-dot dz-s84"></span>Python</b><span class="dz-s83">fulfilment, recommendations, with uv</span><code>run = "uv run --frozen python -m fulfilment"</code></div>
        <div class="dz-poly"><b class="dz-s81"><span class="dz-lang-dot dz-s85"></span>TypeScript</b><span class="dz-s83">notifications, storefront, on bun</span><code>run = "bun run dev"</code></div>
        <div class="dz-poly dz-s86"><b class="dz-s81"><span class="dz-lang-dot dz-s87"></span>Anything else</b><span class="dz-s83">If it starts from your terminal, it starts from doze.hcl.</span><code>run = "[the command you type today]"</code></div>
      </div>
    </div>
  </section>

  <!-- Popular tools, one line each -->
  <section class="dz-s88">
    <div class="dz-s89">
      <span class="dz-eyebrow">Add anything</span>
      <h2 class="dz-h2 dz-s35">Need Kafka? <code class="dz-s90">doze add kafka</code>.</h2>
      <p class="dz-s36">The newest version, its usual port, a name, wired into your app. The same for every tool below.</p>
    </div>
    <Popular />
  </section>

  <!-- Compared -->
  <section class="dz-s37" id="compare">
    <div class="dz-s91">
      <h2 class="dz-h2 dz-s92">doze or docker compose?</h2>
      <p class="dz-s93">Both are good tools. Containers win at shipping. For the code you write all day, here is what changes.</p>
      <div class="dz-cmp">
        <table>
          <thead><tr><th><span class="dz-s94">Question</span></th><th class="dz-s95">doze</th><th>docker compose</th></tr></thead>
          <tbody>
            <tr><th scope="row">What runs</th><td data-l="doze">Native processes</td><td data-l="docker compose">Containers in a Linux VM</td></tr>
            <tr><th scope="row">While you're in a meeting</th><td data-l="doze">Asleep</td><td data-l="docker compose">Running</td></tr>
            <tr><th scope="row">Memory at rest</th><td data-l="doze">[measured, named Mac]</td><td data-l="docker compose">[measured, same Mac]</td></tr>
            <tr><th scope="row">Your debugger</th><td data-l="doze">Attaches to a local process</td><td data-l="docker compose">Crosses a VM boundary</td></tr>
            <tr><th scope="row">Two projects on 5432</th><td data-l="doze">Fine: each has its own address</td><td data-l="docker compose">Remap one by hand</td></tr>
            <tr><th scope="row">Three languages in one repo</th><td data-l="doze">Each runs with its own toolchain</td><td data-l="docker compose">A Dockerfile per service</td></tr>
            <tr><th scope="row">https on your own domain</th><td data-l="doze">One line, one password prompt</td><td data-l="docker compose">A proxy and a CA you set up</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Download -->
  <section class="dz-s96" id="download">
    <div class="dz-s97">
      <div class="dz-s98"><h2 class="dz-h2 dz-s35">Fans off. Stack on.</h2><p class="dz-s99">doze 0.2 · [0.2 release date] · <a href="/changelog/">what's new</a></p></div>
      <a class="dz-s79" href="/download/">Every way to install →</a>
    </div>
    <div class="dz-s100"><h3 class="dz-s101">Mac app</h3><p class="dz-s102">The menu bar app with the CLI inside, for Apple silicon. One password prompt sets up .doze names.</p><a class="dz-btn dz-s103" href="/download/">Download for Mac</a></div>
    <div class="dz-s104"><h3 class="dz-s101">Homebrew</h3>
      <div class="dz-cmd"><code>brew install --cask doze-dev/tap/doze</code><button type="button" class="dz-copy" data-copy="brew install --cask doze-dev/tap/doze" aria-label="Copy the app install command">Copy</button></div>
      <div class="dz-cmd"><code>brew install doze-dev/tap/doze</code><button type="button" class="dz-copy" data-copy="brew install doze-dev/tap/doze" aria-label="Copy the CLI install command">Copy</button></div>
      <span class="dz-s105">The first installs the app; the second, the CLI alone.</span></div>
    <div class="dz-s104"><h3 class="dz-s101">Linux</h3><span class="dz-s106">x86_64 and arm64: Homebrew, mise or a tarball. On Windows, WSL2 works.</span><a class="dz-btn dz-btn-ghost dz-s107" href="/download/">Linux install options</a></div>
  </section>
</div>
</Page>

