---
import Hero from "../components/Hero.astro";
import Base from "../layouts/Base.astro";
---
<Base title="doze AWS" theme="aws" description="17 AWS services in one small Go binary, with a console that shows every call.">
  <Hero
    eyebrow="doze AWS"
    title="All of AWS. None of the account."
    lede="S3, DynamoDB, SQS, SNS, Lambda, Step Functions, EventBridge, IAM and more in one small binary. Every call your app makes, live, and why the refused one was refused."
    cmd="doze add aws"
    docs="/docs/aws/"
  />
</Base>
