.aw-fid tbody th{font-weight:400}
@media (max-width:1100px){.aw-svcs{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:600px){.aw-svcs{grid-template-columns:repeat(2,minmax(0,1fr))}.aw-fid thead{display:none}.aw-fid table,.aw-fid tbody,.aw-fid tr,.aw-fid th,.aw-fid td{display:block}.aw-fid tbody tr{padding:12px 16px}.aw-fid tbody tr:first-child{border-top:0}.aw-fid tbody th{padding:0 0 6px;font-weight:600}.aw-fid td{padding:3px 0;display:flex;gap:12px}.aw-fid td::before{content:attr(data-l);flex:0 0 140px;color:#9DB0C6;font-size:14px}}
.aw-recap{display:inline-block;font-family:var(--font-mono);font-size:11px;color:#AFC0D4;background:#13203A;border:1px dashed #3A5675;border-radius:6px;padding:2px 7px;white-space:nowrap}
@media (max-width:760px){.aw-hero-title{font-size:44px !important}.aw-stack-sm{flex-direction:column !important;align-items:stretch !important}.aw-float{position:relative !important;right:auto !important;bottom:auto !important;margin-top:14px;max-width:none !important}.aw-inst{padding:28px !important}.aw-inst h2{font-size:30px !important}.aw-inst > div{flex:none !important;width:100%}.aw-inst img{display:none}}
