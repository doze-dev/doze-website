---
// doze AWS. Its own identity first (sky on its own night), then the real
// console, the services one by one, alone or inside doze, honest fidelity,
// install, and the family it belongs to.
import "../components/product/product.css";
import AwsServices from "../components/product/AwsServices.astro";
import Cmd from "../components/product/Cmd.astro";
import Endorse from "../components/product/Endorse.astro";
import Family from "../components/product/Family.astro";
import Shot from "../components/product/Shot.astro";
import SubNav from "../components/product/SubNav.astro";
import Page from "../layouts/Page.astro";

const install = "curl -fsSL https://raw.githubusercontent.com/doze-dev/doze-aws/main/install.sh | sh";
const services: [string, string][] = [
  ["S3", "buckets, objects, notifications"],
  ["SQS", "FIFO, DLQ redrive, long polling"],
  ["SNS", "fanout, filter policies"],
  ["DynamoDB", "expressions, GSI/LSI, transactions"],
  ["Lambda", "host processes, no Docker"],
  ["Step Functions", "Standard and Express, JSONata"],
  ["EventBridge", "patterns, schedules, targets"],
  ["API Gateway", "REST and HTTP APIs into Lambda"],
  ["IAM", "real policy evaluation"],
  ["CloudFormation", "sam deploy, cdk deploy"],
  ["Kinesis", "resharding, no JVM"],
  ["CloudWatch", "metrics, alarms"],
  ["CloudWatch Logs", "groups, streams, tail --follow"],
  ["KMS", "real stdlib crypto"],
  ["Secrets Manager", "version stages, encrypted"],
  ["SSM Parameter Store", "versions, labels, SecureString"],
  ["STS", "identity, assume role"],
];
---
<Page notice title="doze AWS" description="doze AWS wakes AWS on your laptop. No account, no bill. 17 services in one Go binary on 127.0.0.1:4566, speaking the real wire protocols, with a console that opens on your own traffic." theme="aws" current="aws">
<div class="pp pp-aws aw">
  <SubNav name="doze AWS" icon="/brand/doze-aws.svg" links={[["The wire", "#console"], ["Services", "#services"], ["Alone or in doze", "#run"], ["Fidelity", "#fidelity"], ["Install", "#install"], ["Docs", "/docs/aws/"], ["Changelog", "/changelog/"]]} />

  <!-- Hero: its own identity -->
  <section class="pp-hero">
    <div class="pp-wrap aw-hero">
      <div class="aw-hero-say">
        <span class="pp-lockup"><img src="/brand/doze-aws.svg" alt="" width="112" height="112" /><b>doze AWS</b></span>
        <h1 class="pp-h1 aw-h1">Wakes AWS on your laptop. <span class="pp-soft">No account, no bill.</span></h1>
        <Endorse />
        <p class="pp-lede">Stop waiting on a deploy to find out if your Lambda works. Stop sharing one dev account with the whole team. 17 services in one Go binary, speaking the real wire protocols, so your SDK, the AWS CLI, SAM and CDK point at it unchanged. No Docker, no JVM.</p>
        <div class="pp-chips" aria-label="What it replaces"><span class="pp-chip">waiting for CloudFormation…</span><span class="pp-chip">AccessDenied (the shared dev account)</span><span class="pp-chip">works on my machine, fails in AWS</span></div>
        <div class="aw-cta">
          <a class="pp-btn pp-btn-acc" href="#install">Install doze AWS</a>
          <a class="pp-btn pp-btn-ghost" href="/docs/aws/">Getting started</a>
        </div>
      </div>
      <div class="aw-hero-term">
        <div class="pp-term-head"><span>on its own</span><span>loopback only</span></div>
        <pre class="pp-term"><span class="c">$</span> <span class="w">doze-aws</span>

  <span class="w">doze-aws is up.</span>

    endpoint  <span class="a">http://127.0.0.1:4566</span>
    console   <span class="a">http://127.0.0.1:4566/_console/</span>
    serving   17 services in us-east-1

    eval "$(doze-aws env)"   point this shell at it
    doze-aws doctor          when something looks wrong

<span class="c">$</span> <span class="w">aws sts get-caller-identity</span>
&#123; "Account": "000000000000", … &#125;</pre>
      </div>
    </div>
  </section>

  <!-- The real console: the wire -->
  <section class="pp-sec aw-wire" id="console">
    <div class="pp-wrap">
      <div class="pp-head pp-head-c" data-reveal>
        <span class="pp-eyebrow">The console</span>
        <h2 class="pp-h2">It opens on your own traffic.</h2>
        <p class="pp-lede">Every call your app makes, newest first, with what it was on, how AWS would have answered, and how long it took. Real AWS cannot show you this, because it is not sitting between your code and the answer.</p>
      </div>
      <div class="aw-wire-shot" data-reveal>
        <Shot src="/media/aws-wire.webp" alt="The doze AWS console's wire for Larder: every AWS call Larder made, newest first, with Step Functions' own calls nested under it and one receipt PutObject refused" title="doze AWS · /_console" glow />
        <div class="pp-float aw-float"><b>1 call was refused</b>The same request would fail on AWS. You found out on your laptop.</div>
      </div>
      <p class="pp-cap aw-cap">The real console, running Larder: its traffic, not a diagram.</p>

      <div class="aw-pair">
        <figure class="aw-fig" data-reveal>
          <Shot src="/media/aws-live.webm" alt="Larder's AWS calls streaming into the doze AWS console, then the refused receipt PutObject opened" title="doze AWS · /_console" />
          <figcaption><b>Watch it fill up.</b> Real AWS CLI calls (product pictures into S3, pick lists off SQS, orders through Step Functions) land on the wire as they happen.</figcaption>
        </figure>
        <figure class="aw-fig" data-reveal>
          <Shot src="/media/aws-call.webp" alt="A refused PutObject opened: a receipt written twice with If-None-Match, S3's PreconditionFailed, the receipt it sent, and the ledger entry for the operation" title="doze AWS · /_console" />
          <figcaption><b>Open the refused one.</b> What you sent, why it was refused, a request id you can quote, and copy as curl.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- The services, one by one -->
  <section class="pp-sec pp-sec-tint" id="services">
    <div class="pp-wrap aw-svc-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Not just the wire</span>
        <h2 class="pp-h2">Every service gets a real console.</h2>
        <p class="pp-lede">Browse buckets, peek at queues, query tables, invoke functions and read their logs, follow a state machine, and generate the IAM policy your tests needed. One binary, no cloud account.</p>
      </div>
      <AwsServices />

      <div class="aw-all">
        <div class="aw-all-say" data-reveal>
          <h3 class="pp-h3">17 services that talk to each other.</h3>
          <p>An S3 upload fires EventBridge, which invokes a Lambda, which writes to DynamoDB, with IAM policies evaluated on the way, as on AWS.</p>
        </div>
        <ul class="aw-grid">
          {services.map(([name, what]) => <li><b>{name}</b><span>{what}</span></li>)}
          <li class="aw-grid-more"><a href="/docs/aws/"><b>All 17, in the docs →</b><span>what each one does, and how faithfully</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Alone, or inside doze -->
  <section class="pp-sec" id="run">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Works alone</span>
        <h2 class="pp-h2">On its own, or inside a doze stack.</h2>
        <p class="pp-lede">The same binary either way. On its own it answers on loopback. Inside doze it gets a name, wakes when your code calls and sleeps when it stops.</p>
      </div>
      <div class="aw-two">
        <div class="aw-way" data-reveal>
          <span class="aw-way-tag">On its own</span>
          <h3 class="pp-h3">One command, one address.</h3>
          <p>Run <code>doze-aws</code> and point your tools at <code class="aw-hi">127.0.0.1:4566</code>; the console is at <code>/_console/</code> on the same address. <code>eval "$(doze-aws env)"</code> sets up the shell you're in.</p>
          <pre class="pp-term"><span class="c">$</span> <span class="w">doze-aws</span>
    endpoint  <span class="a">http://127.0.0.1:4566</span>

<span class="c">$</span> <span class="w">eval "$(doze-aws env)"</span>     <span class="c"># in another shell</span>
<span class="c">$</span> <span class="w">aws s3 mb s3://receipts</span>
make_bucket: receipts</pre>
        </div>
        <div class="aw-way" data-reveal>
          <span class="aw-way-tag aw-way-doze"><img src="/brand/doze.svg" alt="" width="18" height="18" />Inside doze</span>
          <h3 class="pp-h3">Buckets and queues, in the same file as the app.</h3>
          <p><code>doze add aws</code>, and in <a href="/examples/">Larder</a>, our made-up example project, doze names it <code class="aw-hi">aws.larder.doze</code> and hands each service its address. The Python fulfilment service works through pick lists on SQS with boto3; doze AWS stays asleep until one of them calls.</p>
          <pre class="pp-term"><span class="c"># doze.hcl, from the Larder example</span>
<span class="a">module</span> aws <span class="w">"aws"</span> &#123;
  port = 4566

  bucket <span class="w">"product-images"</span> &#123;&#125;
  bucket <span class="w">"receipts"</span> &#123; versioning = true &#125;

  queue <span class="w">"pick-lists"</span> &#123;
    dlq          = <span class="w">"auto"</span>
    max_receives = 5
  &#125;
&#125;

<span class="c"># and in the app that uses it</span>
AWS_ENDPOINT_URL = module.aws.url</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Fidelity, honestly -->
  <section class="pp-sec pp-sec-tint" id="fidelity">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Honest by design</span>
        <h2 class="pp-h2">A fidelity ledger for every service.</h2>
        <p class="pp-lede">An emulator that is too permissive is the dangerous kind: your code passes here and fails on deploy. So each service states what really works, and every refusal AWS's own service models state is checked in CI.</p>
      </div>
      <div class="aw-fid-row">
        <div class="aw-fid" data-reveal>
          <table>
            <thead><tr><th>Service</th><th>Operations</th><th>Constraint cases</th></tr></thead>
            <tbody>
              <tr><th scope="row">DynamoDB</th><td data-l="Operations">27 of 27</td><td data-l="Constraint cases">333 / 333</td></tr>
              <tr><th scope="row">EventBridge</th><td data-l="Operations">40 of 40</td><td data-l="Constraint cases">448 / 448</td></tr>
              <tr><th scope="row">IAM</th><td data-l="Operations">89 of 93</td><td data-l="Constraint cases">702 / 702</td></tr>
              <tr><th scope="row">Lambda</th><td data-l="Operations">47 routed</td><td data-l="Constraint cases">612 / 621</td></tr>
            </tbody>
          </table>
          <p class="aw-fid-foot">4 of 17 shown · <a href="/docs/aws/">the full ledger →</a></p>
        </div>
        <div class="aw-honest" data-reveal>
          <h3 class="pp-h3">What it isn't, and what's not yet proven</h3>
          <ul>
            <li><b>Not checked against a live account yet.</b> boto3 scenarios are written for every service; their recordings against real AWS are pending, and until they exist nothing here is called verified.</li>
            <li><b>Not more forgiving than AWS, on purpose.</b> If it accepts something AWS refuses, that is a bug worth reporting.</li>
            <li><b>Not your cloud.</b> No VPCs, custom domains or TLS termination: the operations that act on cloud infrastructure are declined, each with its reason.</li>
            <li><b>Nothing sent anywhere.</b> No outbound connections of its own, no account, no telemetry, nothing outside the data directory you name.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section class="pp-sec" id="install">
    <div class="pp-wrap">
      <div class="aw-inst" data-reveal>
        <div class="aw-inst-say">
          <h2 class="aw-inst-h">All of AWS. None of the account.</h2>
          <span class="aw-inst-k">On its own, macOS or Linux</span>
          <Cmd cmd={install} label="Copy the doze AWS install command" />
          <span class="aw-inst-k">In a doze stack</span>
          <Cmd cmd="doze add aws" label="Copy doze add aws" />
          <span class="aw-inst-more">More ways, and doze itself: <a href="/download/">Download</a> · <a href="/docs/aws/">Docs</a></span>
        </div>
        <img class="aw-inst-icon" src="/brand/doze-aws.svg" alt="" width="132" height="132" />
      </div>
    </div>
  </section>

  <p class="pp-wrap pp-small aw-tm">doze AWS is not affiliated with Amazon Web Services. AWS and the service names are trademarks of Amazon.com, Inc. or its affiliates.</p>
  <Family current="aws" />
</div>
</Page>

<style>
  .aw-hero { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .aw-hero-say { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .aw-h1 { font-size: clamp(42px, 5.2vw, 72px); }
  .aw-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .aw-hero-term .pp-term { font-size: 13.5px; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45); }

  .aw-wire-shot { position: relative; max-width: 1180px; margin: 0 auto; }
  .aw-float { right: -12px; bottom: -28px; }
  .aw-cap { margin-top: 48px; }
  .aw-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 80px; }
  .aw-fig { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .aw-fig figcaption { color: var(--t2); line-height: 1.55; }
  .aw-fig figcaption b { color: var(--t1); }

  .aw-svc-wrap { max-width: 1340px; }
  .aw-all { margin-top: 72px; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: 40px; align-items: start; }
  .aw-all-say { display: flex; flex-direction: column; gap: 10px; }
  .aw-all-say p { margin: 0; color: var(--t2); line-height: 1.6; }
  .aw-grid { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .aw-grid li { overflow-wrap: anywhere; background: var(--g); border: 1px solid var(--ln); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .aw-grid b { font-size: 15px; }
  .aw-grid span { font-size: 13px; color: var(--t3); }
  .aw-grid .aw-grid-more { padding: 0; border-style: dashed; border-color: var(--ln2); background: transparent; }
  .aw-grid-more a { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; min-height: 44px; }
  .aw-grid-more span { color: var(--t2); }

  .aw-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .aw-way { background: var(--g2); border: 1px solid var(--ln); border-radius: 22px; padding: 30px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .aw-way p { margin: 0; color: var(--t2); line-height: 1.6; }
  .aw-way code { font: 0.9em var(--font-mono); color: var(--t1); }
  .aw-way .aw-hi { color: var(--acc); }
  .aw-way .pp-term { font-size: 13px; }
  .aw-way-tag { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--acc); border: 1px solid var(--ln2); border-radius: 999px; padding: 6px 12px; }
  .aw-way-doze { color: #f0a24b; border-color: rgba(240, 162, 75, 0.4); }
  .aw-way-tag img { border-radius: 5px; }

  .aw-fid-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .aw-fid { border: 1px solid var(--ln); border-radius: 18px; overflow: hidden; background: var(--g); }
  .aw-fid table { width: 100%; border-collapse: collapse; font-size: 15px; font-variant-numeric: tabular-nums; }
  .aw-fid th, .aw-fid td { padding: 15px 20px; text-align: left; }
  .aw-fid thead th { background: var(--g3); color: var(--t2); font-weight: 600; }
  .aw-fid tbody tr { border-top: 1px solid var(--ln); }
  .aw-fid tbody th { font-weight: 500; }
  .aw-fid tbody td { color: var(--t2); }
  .aw-fid-foot { margin: 0; padding: 4px 20px; border-top: 1px solid var(--ln); font-size: 14px; color: var(--t3); }
  .aw-fid-foot a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .aw-honest { display: flex; flex-direction: column; gap: 16px; }
  .aw-honest ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .aw-honest li { color: var(--t2); line-height: 1.55; padding-left: 18px; border-left: 2px solid var(--ln2); }
  .aw-honest b { color: var(--t1); }

  .aw-inst { background: var(--acc); color: var(--acc-ink); border-radius: 28px; padding: 48px; display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .aw-inst-say { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; max-width: 720px; }
  .aw-inst-h { margin: 0 0 8px; font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -0.025em; line-height: 1.05; }
  .aw-inst-k { font-weight: 600; font-size: 15px; margin-top: 4px; }
  .aw-inst :global(.pp-cmd) { background: #0c1a2c; border-color: #0c1a2c; }
  .aw-inst-more { font-size: 15px; }
  .pp .aw-inst-more a { color: var(--acc-ink); text-decoration: underline; font-weight: 600; display: inline-flex; min-height: 44px; align-items: center; }
  .aw-inst-icon { width: 132px; height: 132px; border-radius: 30px; box-shadow: 0 0 0 3px var(--acc-ink); flex: none; }
  .aw-tm { margin-top: -64px; padding-bottom: 40px; }

  @media (max-width: 1000px) {
    .aw-hero, .aw-all, .aw-fid-row, .aw-two { grid-template-columns: minmax(0, 1fr); }
    .aw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .aw-pair { grid-template-columns: minmax(0, 1fr); margin-top: 48px; }
    .aw-cta { flex-direction: column; align-items: stretch; width: 100%; }
    .aw-way { padding: 22px; }
    .aw-inst { padding: 26px; }
    .aw-inst-icon { display: none; }
    .aw-fid thead { display: none; }
    .aw-fid table, .aw-fid tbody, .aw-fid tr, .aw-fid th, .aw-fid td { display: block; }
    .aw-fid tbody tr { padding: 12px 18px; }
    .aw-fid tbody tr:first-child { border-top: 0; }
    .aw-fid tbody th { padding: 0 0 6px; font-weight: 600; }
    .aw-fid td { padding: 3px 0; display: flex; gap: 12px; }
    .aw-fid td::before { content: attr(data-l); flex: 0 0 140px; color: var(--t3); font-size: 14px; }
  }
</style>
