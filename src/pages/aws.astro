.aw-svcard{background:#13203A;border:1px solid #22344B;border-radius:14px;padding:16px 18px}
.aw-svcard div{font-size:14px;color:#9DB0C6}
.aw code,.aw pre{font-variant-ligatures:none}
.aw pre{white-space:pre}
.aw-svcs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
.aw .aw-more{background:transparent;border-style:dashed;border-color:#3A5675;color:#EEF4FA}.aw .aw-more b{color:#5BB8E8}
.aw-cmd{display:flex;align-items:center;gap:8px;background:#0C1A2C;border-radius:10px;padding:6px 6px 6px 16px;min-width:0}
