---
// The long way round: how local development left home, and how it comes
// back. A scroll story in the shape of /tuesday/: one pinned stage (a map of
// how far your running code is from you) and short beats beside it; each beat
// sets the stage to a complete state (see components/longway/steps.ts).
import Stage from "../components/longway/Stage.astro";
import { beat as b, chapters } from "../components/longway/steps";
import Page from "../layouts/Page.astro";

// One ledger per stop: what it honestly fixed, and what it cost.
const ledger = (fixed: string, cost: string) => ({ fixed, cost });
const L = {
  readme: ledger(
    "Nothing in the way. Native speed, a debugger that just attached, logs in the terminal you started it from.",
    "It worked on one laptop. Versions drifted, services ran forever, and the setup lived in somebody's head.",
  ),
  vm: ledger(
    "Reproducible. The setup became a file in the repo instead of a page in a wiki.",
    "A whole operating system per project. Minutes to boot, a slow shared folder, and the first wall between you and your code.",
  ),
  compose: ledger(
    "One declarative file for the whole stack, pinned versions, a clean slate on demand. A real step forward.",
    "A VM in the middle again, always on. Slow mounts, debugging through a wall, and a fan that never stops.",
  ),
  cluster: ledger(
    "Development finally looked like production: the same manifests, the same networking, real service names.",
    "A cluster to learn before you can write a feature. Templates for a hello world, sync tools, a tunnel per port.",
  ),
  cloud: ledger(
    "Onboarding in minutes. Big machines on demand, a clean environment every time, previews you can link in a review.",
    "Everything is a network hop away: lag on every keystroke, a bill by the hour, and nothing works offline.",
  ),
  platform: ledger(
    "Somebody owns it. Paved roads, guardrails, security reviews, one way to do things.",
    "A team on call for your inner loop. Tickets for a database, quotas, cost reviews, and when it's down, nobody works.",
  ),
};

const end = { ...b("h-e", false), "data-step": "end" };
---
<Page title="The long way round" theme="dark" current="none" description="How local development left home: six honest stops, what each one fixed, what it cost, and the way back to the most powerful computer you own.">
<div class="lw" data-lw data-light="warm">

  <div class="lw-skyw" aria-hidden="true"><div class="lw-sky">
    <i data-l="warm"></i><i data-l="pale"></i><i data-l="steel"></i><i data-l="cold"></i><i data-l="frost"></i><i data-l="ice"></i><i data-l="dusk"></i><i data-l="home"></i><i data-l="night"></i>
  </div></div>

  <!-- the rail: the stops -->
  <nav class="lw-rail" aria-label="The stops on the way">
    <span class="lw-rail-t">The long way round</span>
    <ol>
      {chapters.map((c) => (
        <li><a href={`#l-${c.id}`} data-rail={c.id} aria-label={c.name}><span class="w">{c.label}</span><span class="s">{c.short}</span></a></li>
      ))}
    </ol>
    <i class="lw-prog" aria-hidden="true"></i>
  </nav>

  <!-- cold open -->
  <section class="lw-cold" id="l-top" {...b("cold", false)} aria-labelledby="lw-title">
    <p class="lw-kick" style="--d:0">A short history of local development</p>
    <p class="lw-cold-l" style="--d:1">Your code used to run where you wrote it.</p>
    <p class="lw-cold-l" style="--d:2">Then, one sensible decision at a time, it moved away.</p>
    <h1 class="lw-cold-h" id="lw-title" style="--d:3">The long way round.</h1>
    <p class="lw-cold-s" style="--d:4">Six stops. What each one really fixed, what it cost, and the way back home.</p>
    <span class="lw-cue" aria-hidden="true" style="--d:5">Scroll</span>
  </section>

  <div class="lw-film">
    <Stage />

    <div class="lw-beats">

      <!-- 01 -->
      <section class="lw-era" aria-labelledby="lw-h1">
        <div class="lw-ch" id="l-readme" tabindex="-1">
          <article class="lw-beat" {...b("r1a")}>
            <h2 class="lw-era-h" id="lw-h1"><span>Stop one · Services and a README</span>It ran on your laptop.</h2>
            <p>A package manager, a few background services, and a README that said what to type. Postgres on 5432, because that's where Postgres goes.</p>
            <p>Save the file, refresh the page. Between you and your running code: nothing at all.</p>
          </article>
          <article class="lw-beat" {...b("r1b")}>
            <p>Then a second project needed a different Postgres. Then a new hire's laptop didn't have one running.</p>
            <p>The README was right on exactly one machine: the one that wrote it.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.readme.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.readme.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- 02 -->
      <section class="lw-era" aria-labelledby="lw-h2">
        <div class="lw-ch" id="l-vm" tabindex="-1">
          <article class="lw-beat" {...b("vm-a")}>
            <h2 class="lw-era-h" id="lw-h2"><span>Stop two · A VM per project</span>A computer inside the computer.</h2>
            <p>So each project got its own virtual machine, built from a file in the repo. The same OS and the same versions, for everyone.</p>
            <p>One command. Go and make a coffee.</p>
          </article>
          <article class="lw-beat" {...b("vm-b")}>
            <p>It worked. It was also a whole operating system per project: memory reserved whether you used it or not, and a shared folder that made every file read slower.</p>
            <p>Three projects meant three machines, warming your lap.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.vm.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.vm.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- 03 -->
      <section class="lw-era" aria-labelledby="lw-h3">
        <div class="lw-ch" id="l-compose" tabindex="-1">
          <article class="lw-beat" {...b("c-a")}>
            <h2 class="lw-era-h" id="lw-h3"><span>Stop three · One compose file</span>One file. Real wins.</h2>
            <p>Containers made the machine small and the file short. One compose file named the database, the cache, the queue and the apps, and one command brought them all up, the same for everyone.</p>
            <p>This was a genuine step forward. For packaging and shipping software, it still is.</p>
          </article>
          <article class="lw-beat" {...b("c-b")}>
            <p>But on a Mac or a Windows laptop, a container means a Linux VM. The VM came back: smaller, always on, holding every service all day, used or not. The fan noticed.</p>
            <p>Every file change crossed a mount. Reloads got slow, so the web app quietly moved back outside to run natively.</p>
          </article>
          <article class="lw-beat" {...b("c-c")}>
            <p>Debugging meant publishing a port from inside the container and mapping source paths across the wall.</p>
            <p class="lw-line">“Works on my machine” became “works in my container”.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.compose.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.compose.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- 04 -->
      <section class="lw-era" aria-labelledby="lw-h4">
        <div class="lw-ch" id="l-cluster" tabindex="-1">
          <article class="lw-beat" {...b("k-a")}>
            <h2 class="lw-era-h" id="lw-h4"><span>Stop four · Kubernetes for dev</span>Then production became a cluster.</h2>
            <p>So development tried to look like it. A cluster on the laptop, inside the VM, inside the laptop.</p>
            <p>A chart of ten templates, to say hello world.</p>
          </article>
          <article class="lw-beat" {...b("k-b")}>
            <p>The laptop gave up, and the stack moved to a shared cluster: a namespace per developer.</p>
            <p>Now every save is a sync and a rebuild, somewhere else. Every database you want to look at is a port-forward back to your laptop, and 5432 is still taken on this side.</p>
          </article>
          <article class="lw-beat" {...b("k-c")}>
            <p>The debugger waits on the tunnel. The tunnel waits on the debugger. The logs are in another tool, in another tab.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.cluster.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.cluster.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- 05 -->
      <section class="lw-era" aria-labelledby="lw-h5">
        <div class="lw-ch" id="l-cloud" tabindex="-1">
          <article class="lw-beat" {...b("cl-a")}>
            <h2 class="lw-era-h" id="lw-h5"><span>Stop five · Cloud dev environments</span>Then the editor left too.</h2>
            <p>A dev box per developer, in the cloud. The editor in a browser tab, or attached over SSH. A fresh machine in minutes, the same for everyone.</p>
            <p>Your laptop became a window onto somebody else's computer. On a train, the cursor runs a little behind your typing.</p>
          </article>
          <article class="lw-beat" {...b("cl-b")}>
            <p>Every pull request got a preview environment of its own, billed by the hour. And everyone shared one staging, which everyone, eventually, broke.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.cloud.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.cloud.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- 06 -->
      <section class="lw-era" aria-labelledby="lw-h6">
        <div class="lw-ch" id="l-platform" tabindex="-1">
          <article class="lw-beat" {...b("pl-a")}>
            <h2 class="lw-era-h" id="lw-h6"><span>Stop six · The platform team</span>A team to hold it all up.</h2>
            <p>Somebody has to run all of this. So there's a platform team, and between you and a new database there is now a ticket.</p>
          </article>
          <article class="lw-beat" {...b("pl-b")}>
            <p>Then quotas: your namespace is out of memory. On Thursday, a cost review for dev environments.</p>
            <p>A new hire spends their first week on access requests. The VPN, the cluster, the dev box, the secrets.</p>
          </article>
          <article class="lw-beat" {...b("pl-c")}>
            <p>Then <code>#platform</code>: <em>Dev environments degraded. No ETA.</em> The platform team is on a production incident first, as they should be. Nobody on your team can run anything.</p>
            <p>Your AI agent can read every file in the repo. It can't reach the cluster either.</p>
            <p class="lw-line">One of the walls is a person.</p>
            <dl class="lw-ledger"><div><dt>What it fixed</dt><dd>{L.platform.fixed}</dd></div><div><dt>What it cost</dt><dd>{L.platform.cost}</dd></div></dl>
          </article>
        </div>
      </section>

      <!-- THE TURN -->
      <section class="lw-era" aria-labelledby="lw-ht">
        <div class="lw-ch" id="l-desk" tabindex="-1">
          <article class="lw-beat lw-turn" {...b("t-a")}>
            <h2 class="lw-turn-h" id="lw-ht">Meanwhile.</h2>
            <p>On your desk sits the most powerful computer you have ever owned.</p>
            <p>It's running a browser tab of a dev box, a chat app and a video call about the ETA. Mostly idle, except for the fan.</p>
          </article>
          <article class="lw-beat lw-turn" {...b("t-b")}>
            <p>Every stop on the way fixed something real. None of them asked whether the laptop was the problem.</p>
            <p>It wasn't. The problem was everything on it running at once, all day, with nothing to tell it to rest.</p>
            <p class="lw-line">Local development didn't get fixed. It got moved.</p>
          </article>
        </div>
      </section>

      <!-- HOME -->
      <section class="lw-era lw-home" aria-labelledby="lw-hh">
        <div class="lw-ch" id="l-home" tabindex="-1">
          <article class="lw-beat" {...b("h-a")}>
            <h2 class="lw-era-h" id="lw-hh"><span>The way home · doze</span>Bring it home.</h2>
            <p>doze runs the whole stack on your machine as native processes. Postgres is a process. Your API is a process. One file in the repo, <code>doze.hcl</code>, says what runs and what it needs, and <code>doze.lock</code> pins the versions for everyone.</p>
            <p>Here that's Larder, our made-up grocery example: real code, seven services in Go, Python and TypeScript, a gateway and a web shop, on Postgres, Valkey, Kafka and AWS.</p>
            <p><code>doze up</code>. Everything comes back. Between you and your running code: nothing, again.</p>
          </article>
          <article class="lw-beat" {...b("h-b")}>
            <p>Everything sleeps until it's called. Two minutes with no connections and a service goes to sleep; the next connection wakes it. At rest it's one daemon: it held 27.1 MB on our Mac, and 1.3 MB more after 100,000 log lines (<code>make bench</code>).</p>
            <p>And the app shows all of it: what's awake, what's asleep, and what woke what.</p>
          </article>
          <article class="lw-beat" {...b("h-c")}>
            <p>Your debugger attaches to a process on your own machine. A breakpoint just hits. No published ports, no path maps, no tunnel.</p>
            <p>Need the real hostname for a sign-in callback? Give the app your own domain, over https: one line in the file and one admin prompt.</p>
          </article>
          <article class="lw-beat" {...b("h-d")}>
            <p>Your agent runs <code>doze status</code> and <code>doze logs</code> and sees what you see. Offline, on a train, during somebody else's outage: you keep working.</p>
            <p>The platform team builds the platform: the deploy pipeline, production, the paved road. Not babysit dev boxes. Nobody's pager is part of your inner loop.</p>
            <p>Containers and clusters stay where they shine: shipping and running production. They just don't have to be where you write code.</p>
          </article>
          <article class="lw-beat lw-close" {...b("h-e")}>
            <p>Evening. You close the lid.</p>
            <p>Nothing's still running. The fan is off. You go home.</p>
          </article>
        </div>
      </section>
    </div>
  </div>

  <!-- ending -->
  <section class="lw-end" id="l-end" {...end} aria-labelledby="lw-end-h">
    <img class="lw-end-moon" src="/brand/family-moon.svg" alt="" width="56" height="56" />
    <h2 class="lw-end-h" id="lw-end-h">Every stop fixed something.<br />doze keeps the fixes, and drops the distance.</h2>
    <div class="lw-keep">
      <div class="lw-keep-h" aria-hidden="true"><span>The stop</span><span>What it fixed</span><span>How doze keeps it</span></div>
      <dl>
        <div><dt>Services and a README</dt><dd>Native speed; your debugger just attached</dd><dd class="k">Native processes, on your machine</dd></div>
        <div><dt>A VM per project</dt><dd>The setup is a file in the repo</dd><dd class="k">One <code>doze.hcl</code> in the repo</dd></div>
        <div><dt>One compose file</dt><dd>The whole stack, declared, pinned</dd><dd class="k">Every service declared; versions pinned in <code>doze.lock</code></dd></div>
        <div><dt>Kubernetes for dev</dt><dd>Real names instead of ports</dd><dd class="k">A name for every service; your own domain over https</dd></div>
        <div><dt>Cloud dev environments</dt><dd>A new machine is ready fast</dd><dd class="k"><code>git clone</code>, <code>doze up</code></dd></div>
        <div><dt>The platform team</dt><dd>Somebody owns the paved road</dd><dd class="k">They still do. Your inner loop just stops needing them.</dd></div>
      </dl>
    </div>
    <div class="lw-tally" aria-label="Walls between you and your running code: six at the last stop, none with doze">
      <span><small>The last stop</small><b class="was">6</b></span>
      <span class="arrow" aria-hidden="true">→</span>
      <span><small>With doze</small><b class="now">0</b></span>
      <p>walls between you and your running code. The story's own count; draw yours.</p>
    </div>
    <p class="lw-family">Work hard. Then close the lid.</p>
    <div class="lw-cta">
      <a class="lw-btn" href="/download/">Get doze</a>
      <a class="lw-btn2" href="/docs/doze/why/not-containers/">Native processes vs containers <small>the debugger story, in detail</small></a>
      <a class="lw-btn2" href="/tuesday/">A Tuesday, honestly <small>one day, told twice</small></a>
    </div>
    <a class="lw-again" href="#l-top">Take the long way round again</a>
  </section>
</div>
</Page>

<script>import "../scripts/longway.ts";</script>

<style is:global>
/* ── Skin ── */
.lw {
  --lw-text: #f4ece4;
  --lw-text-2: #d6c8df;
  --lw-dim: #b3a3c0;
  --lw-amber: #f0a24b;
  --lw-amber-ink: #2a1534;
  --lw-good: #8be39b;
  --lw-bad: #ff9aa8;
  --lw-cold: #a9c6ee;
  --lw-cold-line: rgba(160, 195, 245, 0.42);
  --lw-term: #120b18;
  --lw-term-text: #e9dff0;
  --lw-term-dim: #9c8aab;
  --lw-display: var(--font-display);
  --lw-body: var(--font-text);
  --lw-mono: var(--font-mono);
  --sky-warm: radial-gradient(90% 70% at 8% 100%, #4c2a1d 0%, transparent 60%), linear-gradient(180deg, #24162a 0%, #170d1d 100%);
  --sky-pale: radial-gradient(90% 70% at 8% 100%, #3a2422 0%, transparent 55%), linear-gradient(180deg, #211b2b 0%, #15111d 100%);
  --sky-steel: radial-gradient(80% 60% at 95% 0%, #263245 0%, transparent 65%), linear-gradient(180deg, #1b1a27 0%, #131220 100%);
  --sky-cold: radial-gradient(90% 70% at 100% 0%, #1f3550 0%, transparent 65%), linear-gradient(180deg, #141b2a 0%, #0f1320 100%);
  --sky-frost: radial-gradient(100% 80% at 100% 10%, #23456a 0%, transparent 65%), linear-gradient(180deg, #111a28 0%, #0c111b 100%);
  --sky-ice: radial-gradient(100% 80% at 100% 0%, #2a5276 0%, transparent 62%), linear-gradient(180deg, #0f1826 0%, #0a0e17 100%);
  --sky-dusk: radial-gradient(70% 60% at 22% 70%, #5a3220 0%, transparent 60%), linear-gradient(180deg, #121624 0%, #150d1b 100%);
  --sky-home: radial-gradient(90% 70% at 15% 80%, #4a2a20 0%, transparent 62%), linear-gradient(180deg, #1f1428 0%, #170f21 100%);
  --sky-night: radial-gradient(60% 50% at 85% 10%, #2a1e3a 0%, transparent 70%), linear-gradient(180deg, #100a18 0%, #0b0711 100%);
  --rail-h: 60px;
  --stage-h: calc(100svh - var(--rail-h));
  /* the map: band 0 (your laptop) and each band beyond it, in % of the map */
  --b0: 26;
  --bw: 12.333;
  --r0: 14;
  --rs: 15;
}

/* ── Frame ── */
.lw { position: relative; isolation: isolate; color: var(--lw-text); font-family: var(--lw-body); }
.lw code, .lw pre { font-family: var(--lw-mono); font-variant-ligatures: none; }
.lw-skyw { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
.lw-sky { position: sticky; top: 0; height: 100svh; overflow: hidden; }
.lw-sky i { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s ease; }
.lw-sky i[data-l="warm"] { background: var(--sky-warm); }
.lw-sky i[data-l="pale"] { background: var(--sky-pale); }
.lw-sky i[data-l="steel"] { background: var(--sky-steel); }
.lw-sky i[data-l="cold"] { background: var(--sky-cold); }
.lw-sky i[data-l="frost"] { background: var(--sky-frost); }
.lw-sky i[data-l="ice"] { background: var(--sky-ice); }
.lw-sky i[data-l="dusk"] { background: var(--sky-dusk); }
.lw-sky i[data-l="home"] { background: var(--sky-home); }
.lw-sky i[data-l="night"] { background: var(--sky-night); }
.lw[data-light="warm"] .lw-sky i[data-l="warm"], .lw[data-light="pale"] .lw-sky i[data-l="pale"], .lw[data-light="steel"] .lw-sky i[data-l="steel"], .lw[data-light="cold"] .lw-sky i[data-l="cold"], .lw[data-light="frost"] .lw-sky i[data-l="frost"], .lw[data-light="ice"] .lw-sky i[data-l="ice"], .lw[data-light="dusk"] .lw-sky i[data-l="dusk"], .lw[data-light="home"] .lw-sky i[data-l="home"], .lw[data-light="night"] .lw-sky i[data-l="night"] { opacity: 1; }

/* ── Rail ── */
.lw-rail { position: sticky; top: 0; z-index: 20; height: var(--rail-h); display: flex; align-items: center; gap: 16px; padding: 0 24px; background: rgba(12, 8, 16, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.lw-rail-t { font: 700 15px/1 var(--lw-display); letter-spacing: -0.01em; color: var(--lw-text-2); white-space: nowrap; flex: 0 0 auto; }
.lw-rail ol { list-style: none; margin: 0 auto; padding: 0; display: flex; align-items: center; gap: 2px; }
.lw-rail a { display: flex; align-items: center; justify-content: center; min-width: 52px; height: 44px; padding: 0 10px; border-radius: 10px; text-decoration: none; color: var(--lw-dim); font: 500 13px/1 var(--lw-mono); position: relative; transition: color 0.3s; white-space: nowrap; }
.lw-rail a .s { display: none; }
.lw-rail a::before { content: ""; position: absolute; left: 50%; bottom: 5px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: currentColor; opacity: 0.45; transition: transform 0.3s, opacity 0.3s; }
.lw-rail a:hover { color: var(--lw-text); }
.lw-rail a:focus-visible, .lw-end a:focus-visible, .lw-beat a:focus-visible { outline: 2px solid var(--lw-amber); outline-offset: 2px; }
.lw-rail a.past { color: var(--lw-text-2); }
.lw-rail a[aria-current] { color: var(--lw-amber); }
.lw-rail a[aria-current]::before { opacity: 1; transform: scale(1.5); }
.lw-rail a[data-rail="home"] { font-family: var(--lw-display); font-weight: 700; font-size: 15px; }
.lw-prog { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--lw-amber); transform-origin: 0 50%; transform: scaleX(0); opacity: 0.8; }

/* ── Cold open ── */
.lw-cold { min-height: calc(100svh - var(--rail-h)); display: flex; flex-direction: column; justify-content: center; max-width: 1100px; margin: 0 auto; padding: 72px 40px 96px; position: relative; scroll-margin-top: var(--rail-h); }
.lw-kick { margin: 0 0 22px; font: 600 13px/1 var(--lw-body); letter-spacing: 0.16em; text-transform: uppercase; color: var(--lw-amber); }
.lw-cold-l { margin: 0 0 10px; font: 500 clamp(22px, 2.6vw, 30px)/1.35 var(--lw-body); color: var(--lw-text-2); }
.lw-cold-h { margin: 40px 0 18px; font: 800 clamp(52px, 8vw, 112px)/0.95 var(--lw-display); letter-spacing: -0.035em; color: var(--lw-text); }
.lw-cold-s { margin: 0; font-size: 19px; color: var(--lw-text-2); max-width: 36ch; }
.lw-cue { position: absolute; left: 40px; bottom: 32px; font: 500 12px/1 var(--lw-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--lw-dim); }
.lw-cue::after { content: ""; display: block; width: 1px; height: 36px; margin: 12px 0 0 4px; background: linear-gradient(var(--lw-dim), transparent); }
.lw-js .lw-cold [style*="--d"] { animation: lw-rise 0.9s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--d) * 0.5s + 0.15s); }

/* ── Film ── */
.lw-film { display: grid; grid-template-columns: minmax(300px, 400px) minmax(0, 1fr); column-gap: clamp(32px, 5vw, 72px); max-width: 1440px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 56px); }
.lw-beats { grid-column: 1; grid-row: 1; }
.lw-stage { grid-column: 2; grid-row: 1; position: sticky; top: var(--rail-h); align-self: start; height: var(--stage-h); display: flex; flex-direction: column; gap: 14px; padding: 20px 0 22px; min-width: 0; }
.lw:not(.lw-js) .lw-stage { display: none; }
.lw:not(.lw-js) .lw-film { grid-template-columns: minmax(0, 640px); justify-content: center; }

.lw-ch, .lw-beat { scroll-margin-top: var(--rail-h); outline: none; }
.lw-beat { min-height: 88svh; display: flex; flex-direction: column; justify-content: center; padding: 8vh 0; opacity: 0.4; transition: opacity 0.6s ease; }
.lw-beat.on, .lw:not(.lw-js) .lw-beat, .lw-rm .lw-beat { opacity: 1; }
.lw-beat > p { margin: 0 0 14px; font-size: 20px; line-height: 1.5; color: var(--lw-text-2); max-width: 34ch; text-wrap: pretty; }
.lw-beat > p:first-of-type { color: var(--lw-text); }
.lw-beat > p a { color: var(--lw-amber); text-underline-offset: 3px; }
.lw-beat > p code, .lw-end code { font-size: 0.86em; padding: 1px 6px; border-radius: 6px; background: rgba(255, 255, 255, 0.08); color: var(--lw-text); white-space: nowrap; }
.lw-beat > p em { font-style: normal; color: var(--lw-text); background: rgba(240, 162, 75, 0.14); padding: 0 4px; border-radius: 4px; }
.lw-line { font: 700 clamp(28px, 2.6vw, 36px)/1.15 var(--lw-display) !important; letter-spacing: -0.02em; color: var(--lw-text) !important; margin-top: 10px !important; max-width: 18ch !important; text-wrap: balance; }
.lw-era-h { margin: 0 0 30px; font: 800 clamp(38px, 3.8vw, 50px)/1.02 var(--lw-display); letter-spacing: -0.03em; color: var(--lw-text); text-wrap: balance; }
.lw-era-h span { display: block; margin-bottom: 14px; font: 600 13px/1.3 var(--lw-body); letter-spacing: 0.16em; text-transform: uppercase; color: var(--lw-dim); }
.lw-home .lw-era-h span { color: var(--lw-amber); }
.lw-turn { min-height: 100svh; }
.lw-turn-h { margin: 0 0 22px; font: 800 clamp(52px, 5.2vw, 76px)/0.9 var(--lw-display); letter-spacing: -0.04em; }
.lw-close p:last-child { font: 700 30px/1.2 var(--lw-display); color: var(--lw-text); letter-spacing: -0.015em; }
.lw-close { min-height: 100svh; }

/* the honest ledger, one per stop */
.lw-ledger { margin: 22px 0 0; display: grid; gap: 10px; max-width: 40ch; }
.lw-ledger > div { padding: 12px 16px; border-radius: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); }
.lw-ledger dt { margin: 0 0 6px; font: 600 12px/1 var(--lw-body); letter-spacing: 0.14em; text-transform: uppercase; }
.lw-ledger > div:first-child dt { color: var(--lw-good); }
.lw-ledger > div:last-child dt { color: var(--lw-bad); }
.lw-ledger dd { margin: 0; font-size: 16px; line-height: 1.45; color: var(--lw-text-2); }

/* ── Stage: the meter ── */
.lw-meter { flex: 0 0 auto; display: flex; align-items: center; gap: 20px; min-width: 0; }
.lw-meter-n { flex: 0 0 auto; display: flex; flex-direction: column; gap: 4px; }
.lw-meter-n small { font: 600 11px/1.2 var(--lw-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--lw-dim); max-width: 24ch; }
.lw-meter-n span { display: flex; align-items: baseline; gap: 8px; }
.lw-meter-n b { font: 800 46px/0.9 var(--lw-display); letter-spacing: -0.03em; color: var(--lw-amber); font-variant-numeric: tabular-nums; min-width: 1ch; transition: color 0.6s; }
.lw-meter-n em { font: 500 14px/1 var(--lw-body); font-style: normal; color: var(--lw-text-2); }
.lw-stage:not([data-d="0,0,0,0,0,0"]) .lw-meter-n b { color: var(--lw-cold); }
.lw-chain { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 4px; min-width: 0; }
.lw-chain li { display: inline-flex; align-items: center; gap: 6px; font: 500 12px/1 var(--lw-mono); color: var(--lw-cold); white-space: nowrap; animation: lw-pop 0.28s ease both; }
.lw-chain li:not(:first-child)::before { content: "→"; color: var(--lw-dim); }
.lw-chain li.mid { padding: 0; }
.lw-chain li b { font-weight: 500; padding: 4px 8px; border-radius: 6px; background: rgba(140, 180, 240, 0.1); border: 1px solid rgba(160, 195, 245, 0.22); }
.lw-chain li.end { color: var(--lw-amber); font-weight: 600; }
.lw-chain li.person b { color: #ffc2cb; background: rgba(255, 140, 160, 0.12); border-color: rgba(255, 150, 170, 0.35); }
.lw-chain.none li.end:last-child::before { content: "→ nothing in between →"; color: var(--lw-amber); opacity: 0.8; }

/* ── Stage: the map ── */
.lw-map { flex: 1 1 auto; min-height: 0; position: relative; container-type: size; border-radius: 18px; background: rgba(10, 6, 14, 0.4); border: 1px solid rgba(255, 255, 255, 0.07); overflow: hidden; }
.lw-band { position: absolute; top: 0; bottom: 0; left: calc((var(--b0) + (var(--k) - 1) * var(--bw)) * 1%); width: calc(var(--bw) * 1%); border-left: 1px dashed var(--lw-cold-line); background: rgba(120, 165, 230, calc(0.025 + var(--k) * 0.016)); opacity: 0; transition: opacity 0.6s ease; }
.lw-band.on { opacity: 1; }
.lw-band span { position: absolute; left: 4px; right: 4px; top: 10px; text-align: center; font: 500 11px/1.2 var(--lw-mono); color: var(--lw-cold); overflow-wrap: anywhere; }
.lw-band[data-band="6"] { background: rgba(255, 140, 160, 0.08); border-left-color: rgba(255, 150, 170, 0.45); }
.lw-band[data-band="6"] span { color: #ffc2cb; }

.lw-laptop { position: absolute; left: 1.2%; top: 2.5%; bottom: 2.5%; width: calc((var(--b0) - 2.4) * 1%); }
.lw-lid { position: absolute; inset: 0; border-radius: 14px; background: linear-gradient(180deg, rgba(74, 44, 40, 0.55), rgba(40, 24, 40, 0.55)); border: 1px solid rgba(240, 162, 75, 0.28); box-shadow: 0 0 40px rgba(240, 162, 75, 0.1); transform-origin: 50% 100%; transition: transform 0.8s cubic-bezier(.6, 0, .2, 1), opacity 0.6s, box-shadow 0.8s; }
.lw-lt-h { position: absolute; left: 12px; top: 11px; font: 600 11px/1 var(--lw-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--lw-amber); }
.lw-lid .lw-fan { position: absolute; right: 10px; top: 7px; width: 20px; height: 20px; }
.lw-lt-idle { position: absolute; left: 0; right: 0; bottom: 12px; text-align: center; font: 600 12px/1 var(--lw-mono); color: var(--lw-amber); }
.lw-stage[data-laptop="hi"] .lw-lid { box-shadow: 0 0 0 2px rgba(240, 162, 75, 0.8), 0 0 70px rgba(240, 162, 75, 0.35); }
.lw-stage[data-laptop="hi"] .lw-chip:not([data-dist="0"]), .lw-stage[data-laptop="hi"] .lw-lines, .lw-stage[data-laptop="hi"] .lw-person { opacity: 0.35; }
.lw-stage[data-lid="closed"] .lw-lid { transform: scaleY(0.04); opacity: 0.7; }
.lw-stage[data-lid="closed"] .lw-chip { opacity: 0; }
.lw-moon { position: absolute; left: 50%; top: 42%; width: 44px; height: 44px; margin: -22px 0 0 -22px; transform: translateY(24px); filter: drop-shadow(0 0 22px rgba(240, 162, 75, 0.5)); transition: opacity 1.4s ease, transform 2s cubic-bezier(.2, .7, .2, 1) !important; }
.lw-moon.on { transform: none; }

.lw-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; transition: opacity 0.4s; }
.lw-lines line { stroke: var(--lw-cold-line); stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: 0; transition: opacity 0.45s ease 0.1s; }
.lw-lines line.on { opacity: 1; }
.lw-lines line.tunnel { stroke-dasharray: 5 5; }
.lw-lines line[data-line="you"] { stroke: rgba(240, 162, 75, 0.6); }
.lw-moving .lw-lines line { opacity: 0 !important; transition: none; }

.lw-chip { position: absolute; left: 0; top: 0; z-index: 2; --x: calc(var(--b0) / 2 + var(--d) * var(--bw) + min(var(--d), 1) * (var(--b0) / 2 - var(--bw) / 2)); --y: calc(var(--r0) + var(--i) * var(--rs)); transform: translate(calc(var(--x) * 1cqw - 50%), calc(var(--y) * 1cqh - 50%)); display: flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: 999px; background: #2a1d33; border: 1px solid rgba(240, 162, 75, 0.3); font: 500 13px/1 var(--lw-mono); color: var(--lw-text); white-space: nowrap; transition: transform 0.8s var(--ease-settle, ease), opacity 0.4s, background 0.6s, border-color 0.6s; }
.lw-chip:not([data-dist="0"]) { background: #18202e; border-color: rgba(160, 195, 245, 0.35); }
.lw-dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--lw-good); transition: background 0.3s, box-shadow 0.3s; }
.lw-chip[data-s="sleep"] { color: var(--lw-dim); }
.lw-chip[data-s="sleep"] .lw-dot { background: transparent; box-shadow: inset 0 0 0 1.5px var(--lw-dim); animation: lw-breathe 4s ease-in-out infinite; }
.lw-chip[data-s="pause"] .lw-dot { background: var(--lw-amber); border-radius: 1px; width: 7px; box-shadow: none; }
.lw-chip[data-s="pause"] { border-color: var(--lw-amber); }
.lw-chip[data-s="down"] { color: var(--lw-dim); }
.lw-chip[data-s="down"] .lw-dot { background: var(--lw-bad); }
.lw-ed .lw-dot { width: 2px; height: 13px; border-radius: 1px; background: var(--lw-amber); animation: lw-blink 1.1s steps(2) infinite; }

.lw-person { position: absolute; left: calc((var(--b0) + 5.5 * var(--bw)) * 1%); top: 47%; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 4px; translate: -50% -50%; opacity: 0; transform: translateY(10px); transition: opacity 0.5s, transform 0.6s cubic-bezier(.2, .7, .2, 1); }
.lw-stage[data-person="on"] .lw-person, .lw-stage[data-person="paged"] .lw-person { opacity: 1; transform: none; }
.lw-person svg { width: 36px; height: 36px; overflow: visible; }
.lw-person .h, .lw-person .b { fill: #ffc2cb; }
.lw-person .ring { fill: none; stroke: var(--lw-bad); stroke-width: 2; opacity: 0; transform-origin: 20px 20px; }
.lw-stage[data-person="paged"] .lw-person .ring { animation: lw-page 1.2s ease-out infinite; }
.lw-person span { font: 500 11px/1.1 var(--lw-mono); color: #ffc2cb; text-align: center; white-space: nowrap; }
.lw-page { position: absolute; bottom: calc(100% + 4px); left: 50%; translate: -50% 0; padding: 2px 5px; border-radius: 4px; background: var(--lw-bad); color: #2a0b12; font: 700 11px/1 var(--lw-body); opacity: 0; }
.lw-stage[data-person="paged"] .lw-page { opacity: 1; }

/* at home: each service's own name, and whether it's awake */
.lw-addr { position: absolute; left: calc((var(--b0) + 2) * 1%); top: calc((var(--r0) + var(--i) * var(--rs)) * 1%); translate: 0 -50%; display: flex; align-items: baseline; gap: 12px; font: 500 13px/1 var(--lw-mono); white-space: nowrap; transform: translateX(-12px); }
.lw-addr::before { content: ""; align-self: center; width: 18px; height: 1px; background: rgba(240, 162, 75, 0.45); }
.lw-addr b { font-weight: 500; color: var(--lw-text); }
.lw-addr em { font-style: normal; color: var(--lw-dim); }
.lw-addr em::after { content: attr(data-more); }
.lw-addr[data-addr="ed"] b { color: var(--lw-amber); }
.lw-chip .lx, .lw-stage[data-ch="home"] .lw-chip .g { display: none; }
.lw-stage[data-ch="home"] .lw-chip .lx { display: inline; }

/* ── Stage: the cards ── */
.lw-cards { flex: 0 0 auto; height: clamp(150px, 27%, 220px); position: relative; }
.lw-card { position: absolute; top: 0; bottom: 0; border-radius: 12px; overflow: hidden; background: var(--lw-term); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 14px 34px rgba(0, 0, 0, 0.45); transform: translateY(10px); }
.lw-l { left: 0; width: calc(50% - 6px); }
.lw-r { right: 0; width: calc(50% - 6px); }
.lw-w { left: 0; right: 0; }
.lw-stage [data-in] { opacity: 0; transition: opacity 0.45s ease, transform 0.6s cubic-bezier(.2, .7, .2, 1); }
.lw-stage [data-in].on { opacity: 1; transform: none; }
.lw-ct { height: 28px; display: flex; align-items: center; padding: 0 12px 0 58px; font: 600 12px/1 var(--lw-body); color: #cbbfd4; background: #241a2d; position: relative; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lw-ct::before { content: ""; position: absolute; left: 12px; top: 50%; width: 9px; height: 9px; translate: 0 -50%; border-radius: 50%; background: #ff6b5f; box-shadow: 14px 0 #f6bd3b, 28px 0 #3fc950; }
.lw-cb { margin: 0; padding: 12px 14px; font-size: 12px; line-height: 1.6; color: var(--lw-term-text); white-space: pre; overflow: hidden; }
.lw-cb i { font-style: normal; color: var(--lw-term-dim); }
.lw-cb b { font-weight: 500; color: var(--lw-bad); }
.lw-cb u { text-decoration: none; color: var(--lw-good); }
.lw-paper { background: #fbf6ee; }
.lw-paper .lw-ct { background: #ebe2d6; color: #3a2d44; }
.lw-paper .lw-cb { color: #2b2033; }
.lw-paper .lw-cb b { color: #1a1020; font-weight: 700; }
.lw-paper .lw-cb i { color: #7b6c86; }
.lw-mem { display: flex; flex-direction: column; gap: 10px; padding: 14px; }
.lw-mem p { margin: 0; display: grid; grid-template-columns: 88px 1fr auto; gap: 10px; align-items: center; font: 500 12px/1 var(--lw-mono); color: var(--lw-term-text); }
.lw-mem i { height: 10px; border-radius: 3px; background: rgba(255, 255, 255, 0.07); position: relative; overflow: hidden; }
.lw-mem i::after { content: ""; position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(var(--w)); background: linear-gradient(90deg, #f0a24b, #ff6a2b); }
.lw-mem em { font-style: normal; color: var(--lw-term-dim); }
.lw-envs { display: flex; flex-direction: column; gap: 9px; padding: 14px; }
.lw-envs p { margin: 0; display: flex; align-items: center; gap: 9px; font: 500 12px/1.2 var(--lw-mono); color: var(--lw-term-text); }
.lw-envs i { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: var(--lw-term-dim); }
.lw-envs i.g { background: var(--lw-good); }
.lw-envs i.r { background: var(--lw-bad); }
.lw-envs em { margin-left: auto; font-style: normal; color: var(--lw-term-dim); white-space: nowrap; }
.lw-msgs { display: flex; flex-direction: column; gap: 8px; padding: 12px; }
.lw-msgs p { margin: 0; max-width: 92%; padding: 7px 10px; border-radius: 10px; font: 400 12.5px/1.35 var(--lw-body); }
.lw-msgs .o { align-self: flex-start; background: #2d2338; color: #eee4f3; }
.lw-msgs .o b { margin-right: 6px; color: #d9c5ea; }
.lw-msgs .me { align-self: flex-end; background: #5b3b7a; color: #fff; }
.lw-msgs .ai { align-self: flex-start; background: #2d2338; color: #eee4f3; }
.lw-msgs .tool { align-self: flex-start; background: none; padding: 0 2px; color: #a796b5; font-size: 12px; }
.lw-msgs code { font-size: 0.92em; padding: 0 4px; border-radius: 4px; background: rgba(255, 255, 255, 0.1); }
.lw-msgs .bot { align-self: flex-start; background: #3a1f28; color: #ffdfe4; }
.lw-msgs .bot b { display: block; margin-bottom: 3px; font-size: 11px; color: var(--lw-bad); text-transform: uppercase; letter-spacing: 0.08em; }
.lw-tk { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; font: 400 12.5px/1.3 var(--lw-body); color: var(--lw-term-text); }
.lw-tk b { font-weight: 600; font-size: 13.5px; }
.lw-tk p { margin: 0; display: grid; grid-template-columns: 80px 1fr; gap: 8px; }
.lw-tk span { color: var(--lw-term-dim); }
.lw-tk em { font-style: normal; }
.lw-tk p:nth-of-type(1) em { color: #ffd59a; }
.lw-url { display: inline-block; padding: 4px 10px; border-radius: 6px; background: rgba(255, 255, 255, 0.07); font: 500 11.5px/1 var(--lw-mono); color: #d8cce2; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.lw-lock::before { content: "🔒 "; font-size: 10px; }
.lw-browser .lw-cb i { display: inline-block; width: 26px; }
.lw-cur { display: inline-block; width: 0.55em; height: 1.1em; vertical-align: -0.2em; background: var(--lw-term-text); animation: lw-blink 1.1s steps(2) infinite; }
.lw-recon { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; padding: 6px 12px; border-radius: 99px; background: rgba(0, 0, 0, 0.5); font: 500 12px/1 var(--lw-body); color: #eee4f3; white-space: normal; }
.lw-recon span { width: 11px; height: 11px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.2); border-top-color: #eee4f3; animation: lw-spin 0.9s linear infinite; }
.lw-shot img { display: block; width: 100%; height: calc(100% - 28px); object-fit: cover; object-position: 50% 52%; }
.lw-ed2 { padding: 10px 0 0; }
.lw-ed2 i { display: inline-block; width: 34px; padding-right: 10px; text-align: right; }
.lw-ed2 em { display: block; font-style: normal; background: rgba(240, 162, 75, 0.18); box-shadow: inset 3px 0 var(--lw-amber); }
.lw-ed2 em i { color: var(--lw-amber); }
.lw-paused { position: absolute; left: 0; right: 0; bottom: 0; padding: 7px 14px; font: 600 12px/1 var(--lw-body); color: var(--lw-amber-ink); background: var(--lw-amber); }

/* ── Stage: the strip ── */
.lw-strip { flex: 0 0 auto; align-self: center; display: flex; gap: clamp(16px, 3vw, 40px); align-items: center; padding: 9px 22px; border-radius: 999px; background: rgba(10, 6, 14, 0.5); border: 1px solid rgba(255, 255, 255, 0.07); }
.lw-st { display: flex; align-items: center; gap: 10px; }
.lw-st > span:last-child { display: flex; flex-direction: column; gap: 3px; }
.lw-st small { font: 500 11px/1 var(--lw-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--lw-dim); }
.lw-st b { font: 600 14px/1 var(--lw-mono); color: var(--lw-text); white-space: nowrap; }
.lw-st-wait b { min-width: 16ch; }
.lw-fan { width: 28px; height: 28px; fill: var(--lw-text-2); }
.lw-fan circle { fill: #2a2030; }
.lw-fan g { transform-origin: 20px 20px; animation: lw-spin linear infinite paused; }
.lw-fan .a { animation-duration: 2.4s; }
.lw-fan .b { animation-duration: 1.1s; }
.lw-fan .c { animation-duration: 0.5s; }
.lw-stage[data-fan="1"] .lw-fan .a, .lw-stage[data-fan="2"] .lw-fan .a, .lw-stage[data-fan="2"] .lw-fan .b, .lw-stage[data-fan="3"] .lw-fan g { animation-play-state: running; }
.lw-stage[data-fan="3"] .lw-fan { fill: #ffb08a; }
.lw-stage[data-fan="0"] .lw-fan { fill: var(--lw-dim); }
.lw-bill { display: flex; gap: 3px; align-items: flex-end; height: 26px; }
.lw-bill i { width: 7px; border-radius: 2px; background: rgba(255, 255, 255, 0.12); transition: background 0.5s; }
.lw-bill i:nth-child(1) { height: 10px; }
.lw-bill i:nth-child(2) { height: 17px; }
.lw-bill i:nth-child(3) { height: 25px; }
.lw-stage[data-bill="1"] .lw-bill i:nth-child(-n+1), .lw-stage[data-bill="2"] .lw-bill i:nth-child(-n+2), .lw-stage[data-bill="3"] .lw-bill i { background: var(--lw-bad); }

/* ── Ending ── */
.lw-end { position: relative; max-width: 1040px; margin: 0 auto; padding: 18vh 40px 120px; text-align: center; scroll-margin-top: var(--rail-h); }
.lw-end-moon { width: 56px; height: 56px; margin-bottom: 26px; filter: drop-shadow(0 0 24px rgba(240, 162, 75, 0.45)); }
.lw-end-h { margin: 0 0 48px; font: 800 clamp(36px, 4.6vw, 64px)/1.04 var(--lw-display); letter-spacing: -0.03em; text-wrap: balance; }
.lw-keep { text-align: left; padding: 8px 28px 16px; border-radius: 22px; background: rgba(30, 19, 40, 0.75); border: 1px solid #34233f; }
.lw-keep-h, .lw-keep dl > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1.3fr); gap: 20px; align-items: baseline; }
