---
// The postgres module's Extensions tab (design: RegistryExtensions): a Neon-style matrix,
// rows = extensions, columns = Postgres 14 – 18. Facts from src/data/extensions.ts.
import ModuleHead from "../../../../../components/ModuleHead.astro";
import RegistryBar from "../../../../../components/RegistryBar.astro";
import { type Cell, contrib, extensions, licences, pgMajors, uses } from "../../../../../data/extensions";
import Page from "../../../../../layouts/Page.astro";
import { getModule } from "../../../../../lib/registry";
import "../../../../../components/registry/FindBase.css";

const count = (f: (e: (typeof extensions)[number]) => string, v: string) => extensions.filter((e) => f(e) === v).length;
const preloads = extensions.filter((e) => e.preload === "yes").length;
const waves = [
  { n: 1, label: "Wave 1", note: "Coming in postgres 0.3 · built and tested on a branch" },
  { n: 2, label: "Wave 2", note: "planned [to confirm] · not in doze-binaries' catalog yet" },
] as const;
const cellClass = (c: Cell) =>
  ({ coming: "coming", planned: "planned", none: "none", no: "no", unverified: "unv" })[c.state];
const postgres = getModule("postgres");
if (!postgres) throw new Error("postgres is not in the registry index");
const extHref = (name: string) => `/registry/doze/postgres/extensions/${name}/`;
---
<Page title="Extensions · postgres · Registry" description="Postgres extensions by name: each built per version, per Postgres major and per platform, pinned in doze.lock." theme="light" current="registry">
  <RegistryBar section="modules" />
  <ModuleHead module={postgres} tab="extensions" />
  <div class="rg">
    <div class="rg-wrap">
      <section class="x-hero">
        <div class="x-col">
          <span class="rg-eyebrow">Extensions · {extensions.length}</span>
          <h2 class="rg-h2">Extensions for Postgres, by name</h2>
          <p class="rg-lead">Write a name; doze fetches the build for your Postgres and your machine. Each extension is built per version, per Postgres major and per platform, checked against its digest and pinned in doze.lock, like the engine itself. Ones that must be preloaded are added to <code class="rg-mono x-lead-code">shared_preload_libraries</code> for you.</p>
        </div>
        <div class="x-col x-col-tight">
          <div class="rg-code">
            <div class="rg-code-top"><span>doze.hcl</span><button class="rg-copy" type="button" data-copy-from="#x-hcl">Copy</button></div>
            <pre id="x-hcl"><span class="k">module</span> postgres <span class="s">"postgres"</span> {"{"}
  version    = 17
  extensions = [<span class="s">"vector"</span>, <span class="s">"pg_cron"</span>]
{"}"}

<span class="k">module</span> postgres <span class="s">"metrics"</span> {"{"}
  version = 17
  <span class="k">extension</span> <span class="s">"timescaledb"</span> {"{"} version = <span class="s">"2.31"</span> {"}"} <span class="c"># pinned</span>
{"}"}</pre>
          </div>
          <div class="rg-note x-coming"><span class="rg-chip info x-none">Coming</span><span>Arrives with <b>postgres 0.3</b> [date]; built and tested on a branch today. Ten extensions (50 bundles) built on macOS arm64 and checked against each major's x.0 and newest minor. The six in wave 2 are planned and not built yet; their versions are to confirm.</span></div>
        </div>
      </section>

      <div class="x-body">
        <aside id="x-filters" aria-label="Filters" class="x-aside">
          <div class="rg-facet x-first">
            <h3>Use</h3>
            {uses.map((u) => <label class="rg-opt"><input type="checkbox" name="use" value={u} /><span>{u}</span><span class="n">{count((e) => e.use, u)}</span></label>)}
          </div>
          <div class="rg-facet">
            <h3>Preload</h3>
            <label class="rg-opt"><span>Needs preload</span><input type="checkbox" role="switch" name="preload" class="rg-switch" /></label>
            <span class="rg-small">{preloads} do. Adding or removing one restarts the instance once; doze up says so.</span>
          </div>
          <div class="rg-facet">
            <h3>Licence</h3>
            {licences.map((l) => <label class="rg-opt"><input type="checkbox" name="licence" value={l} /><span>{l}</span><span class="n">{count((e) => e.licence, l)}</span></label>)}
            <span class="rg-small">GPL and AGPL bundles link the exact upstream source and the recipe that built them.</span>
          </div>
        </aside>

        <div class="x-main">
          <section aria-labelledby="matrix" class="x-sec">
            <div class="x-head">
              <h2 class="rg-h2" id="matrix">By Postgres version</h2>
              <button class="rg-btn sec rg-filters-btn" type="button" aria-controls="x-filters" aria-expanded="false" id="x-fbtn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>Filters</button>
            </div>
            <div class="x-legend" aria-label="Legend">
              <span><i class="l-coming">0.8.7</i>Coming in postgres 0.3: built and tested on a branch</span>
              <span><i class="l-planned">3.6</i>planned line [to confirm]: not built yet</span>
              <span><i class="l-none">—</i>not built</span>
              <span><i class="l-no">×</i>not possible: upstream doesn't support it</span>
              <span><i class="l-unv">?</i>unverified upstream</span>
            </div>
            <span class="x-cue"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>Scroll the table sideways for PG 15 – 18, preload and licence</span>
            <div class="x-box" role="region" aria-label="Extensions by Postgres version" tabindex="0">
              <table class="x-tbl">
                <thead><tr><th scope="col">Extension</th>{pgMajors.map((m) => <th scope="col" class="pg">PG {m}</th>)}<th scope="col">Preload</th><th scope="col">Licence</th><th scope="col">What it's for</th></tr></thead>
                <tbody>
                  {waves.map((w) => (
                    <Fragment>
                      <tr class="x-wave" data-wave={w.n}><th scope="rowgroup">{w.label}</th><td colspan="8">{w.note}</td></tr>
                      {extensions.filter((e) => e.wave === w.n).map((e) => (
                        <tr data-ext={e.name} data-wave-row={w.n} data-use={e.use} data-licence={e.licence} data-preload={e.preload === "yes" ? "1" : "0"}>
                          <th scope="row"><a href={extHref(e.name)} class="x-n">{e.name}</a>{e.sub && <span class="x-sub">{e.sub}</span>}</th>
                          {e.cells.map((c) => (
                            c.state === "no" ? <td class="x-c no" title="Not possible: upstream does not support this Postgres"><span aria-label="not possible">×</span></td>
                            : c.state === "unverified" ? <td class="x-c unv" title="Unverified upstream">?</td>
                            : c.state === "none" ? <td class="x-c none"><span aria-label="not built">—</span></td>
                            : <td class={`x-c ${cellClass(c)}`}>{c.v}</td>
                          ))}
                          <td>{e.preload === "yes" ? <span class="rg-chip warn">preloads</span> : <span class="x-dim">{e.preload}</span>}</td>
                          <td class="x-lic">{e.licence}</td>
                          <td class="x-what">{e.what}</td>
                        </tr>
                      ))}
                    </Fragment>
                  ))}
                  <tr class="x-empty" hidden><td colspan="9">No extension matches these filters. <button type="button" class="x-clear" id="x-clear">Clear filters</button></td></tr>
                </tbody>
              </table>
            </div>
            <p class="rg-small x-m0">Versions are each extension's own, from doze-binaries' catalog. pg_hint_plan and pgaudit cut one line per Postgres major, so the version changes across the row. TimescaleDB and pg_search start at 15 upstream; pgvectorscale is verified on 18 only. Postgres 14 reaches end of life upstream on 12 Nov 2026; pinned 14 builds stay served.</p>
            <div class="rg-sunk x-miss">
              <b>A name doze doesn't have</b>
              <code class="rg-mono">doze has no extension vectr for Postgres 17; did you mean vector?</code>
              <span class="rg-small">Aliases work too: pgvector → vector, timescale → timescaledb, pgvectorscale → vectorscale. Names PostGIS provides (postgis_topology, postgis_raster…) resolve to its bundle.</span>
            </div>
          </section>

          <section aria-labelledby="contrib" class="x-sec x-sec-tight">
            <h2 class="rg-h2" id="contrib">Ships with Postgres <span class="x-count">{contrib.length}</span></h2>
            <p class="rg-p">The contrib extensions are inside every Postgres doze runs: nothing to fetch, nothing to pin. List them the same way: <code class="rg-mono x-inl">extensions = ["pg_trgm", "citext"]</code>.</p>
            <div class="x-contrib">
              {contrib.map((x) => <code title={x.what}>{x.name}</code>)}
            </div>
            <p class="rg-small x-m0">By version: <code class="rg-mono">pg_walinspect</code> from 15, <code class="rg-mono">pg_logicalinspect</code> from 18; <code class="rg-mono">adminpack</code> and <code class="rg-mono">old_snapshot</code> up to 16.</p>
          </section>
        </div>
      </div>
    </div>
  </div>
</Page>

<script>
  // Facets: Use and Licence are any-of within the group; groups and the preload switch narrow together.
  const aside = document.getElementById("x-filters")!;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("tr[data-ext]")];
  const waves = [...document.querySelectorAll<HTMLTableRowElement>("tr[data-wave]")];
  const empty = document.querySelector<HTMLTableRowElement>("tr.x-empty")!;
  const picked = (name: string) => [...aside.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);

  function apply() {
    const use = picked("use"), lic = picked("licence");
    const pre = aside.querySelector<HTMLInputElement>('input[name="preload"]')!.checked;
    let shown = 0;
    for (const r of rows) {
      const ok = (!use.length || use.includes(r.dataset.use!)) && (!lic.length || lic.includes(r.dataset.licence!)) && (!pre || r.dataset.preload === "1");
      r.hidden = !ok;
      if (ok) shown++;
    }
    for (const w of waves) w.hidden = !rows.some((r) => r.dataset.waveRow === w.dataset.wave && !r.hidden);
    empty.hidden = shown > 0;
  }
  aside.addEventListener("change", apply);
  document.getElementById("x-clear")!.addEventListener("click", () => {
    for (const i of aside.querySelectorAll<HTMLInputElement>("input")) i.checked = false;
    apply();
  });
  // Phone: the filters fold away behind a button.
  const btn = document.getElementById("x-fbtn")!;
  btn.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    btn.setAttribute("aria-expanded", String(open));
    aside.classList.toggle("x-open", open);
  });
  apply();
</script>

<style>
  .rg { font-family: var(--font-text); background: #fffaf4; color: #140c1b; }
  .rg .rg-switch { appearance: none; margin: 0; border: 0; cursor: pointer; }
  .rg .rg-switch:checked { background: #a85a0c; justify-content: flex-end; }
  .rg-opt input[type="checkbox"].rg-switch { width: 38px; height: 22px; }
  .rg-facet.x-first { border-top: 0; padding-top: 0; }
  .rg-opt input[type="checkbox"]:not(.rg-switch) { width: 16px; height: 16px; margin: 0; accent-color: #a85a0c; flex: none; }
  .rg-switch:focus-visible, .rg-opt input:focus-visible { outline: 2px solid #a85a0c; outline-offset: 2px; }

  .x-col { display: flex; flex-direction: column; gap: 14px; }
  .x-col-tight { gap: 10px; min-width: 0; }
  .x-lead-code { font-size: 15px; }
  .x-coming { border: 1px solid #c9d6f7; background: #f4f7fe; }
  .x-none { flex: none; }
  .x-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; padding: 40px 0 30px; }
  .x-body { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 36px; align-items: start; padding-bottom: 72px; }
  .x-aside { position: sticky; top: 16px; }
  .x-main { display: flex; flex-direction: column; gap: 40px; min-width: 0; }
  .x-sec { display: flex; flex-direction: column; gap: 14px; }
  .x-sec-tight { gap: 12px; }
  .x-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .x-m0 { margin: 0; }
  .x-count { color: #6e5f79; font-weight: 500; }
  .x-inl { font-size: 13.5px; }
  .x-miss { padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .x-miss b { font-size: 14px; }
  .x-miss code { font-size: 13px; color: #140c1b; white-space: normal; }
  .x-box { overflow-x: auto; border: 1px solid #eadfd3; border-radius: 14px; background: #fff; }
  .x-box:focus-visible { outline: 2px solid #a85a0c; outline-offset: 2px; }
  .x-box {
    background: linear-gradient(to right, #fff 30%, rgba(255, 255, 255, 0)), linear-gradient(to left, #fff 30%, rgba(255, 255, 255, 0)) 100% 0, radial-gradient(farthest-side at 100% 50%, rgba(20, 12, 27, 0.16), rgba(20, 12, 27, 0)) 100% 0;
    background-repeat: no-repeat; background-size: 40px 100%, 40px 100%, 14px 100%; background-attachment: local, local, scroll;
  }
  .x-tbl { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 880px; font-size: 13.5px; }
  .x-tbl thead th { position: sticky; top: 0; background: #fff4e8; text-align: left; font: 600 13px var(--font-text); letter-spacing: 0.05em; text-transform: uppercase; color: #4a3d55; padding: 11px 12px; border-bottom: 1px solid #eadfd3; white-space: nowrap; }
  .x-tbl thead th.pg { text-align: center; width: 66px; }
  .x-tbl tbody th { position: sticky; left: 0; z-index: 1; background: #fff; text-align: left; font-weight: 400; padding: 10px 14px; border-bottom: 1px solid #f1e8de; border-right: 1px solid #eadfd3; white-space: nowrap; min-width: 150px; }
  .x-tbl thead th:first-child { position: sticky; left: 0; z-index: 2; border-right: 1px solid #eadfd3; }
  .x-tbl td { padding: 10px 12px; border-bottom: 1px solid #f1e8de; vertical-align: middle; }
  .rg .x-n { font: 600 13.5px var(--font-mono); color: #140c1b; display: block; }
  .x-sub { display: block; font-size: 13px; color: #6e5f79; margin-top: 2px; }
  .x-c { text-align: center; font: 500 13px var(--font-mono); white-space: nowrap; border-left: 1px solid #f7f1ea; }
  .x-c.coming { color: #2f62d9; background: #f4f7fe; }
  .x-c.planned { color: #2f62d9; background: #fff; font-style: italic; outline: 1px dashed #afc2f2; outline-offset: -5px; }
  .x-c.none { color: #6e5f79; }
  .x-c.no { color: #b4233c; background: repeating-linear-gradient(135deg, #fcf1f3 0 6px, #fff 6px 12px); font-weight: 700; font-size: 15px; }
  .x-c.unv { color: #8a5300; background: #fff8ea; font-weight: 700; }
  .x-dim { color: #6e5f79; font-size: 13px; white-space: nowrap; }
  .x-lic { white-space: nowrap; color: #4a3d55; }
  .x-what { color: #4a3d55; font-size: 13px; line-height: 1.4; }
  .x-wave td { background: #fffaf4; font: 600 13px var(--font-text); letter-spacing: 0.05em; text-transform: uppercase; color: #6e5f79; padding: 9px 14px; }
  .x-tbl .x-wave th { background: #fffaf4; font: 600 13px var(--font-text); letter-spacing: 0.05em; text-transform: uppercase; color: #4a3d55; }
  .x-empty td { padding: 18px 14px; color: #4a3d55; font-size: 14px; }
  .x-clear { background: none; border: 0; padding: 0 4px; font: inherit; font-weight: 600; color: #a85a0c; cursor: pointer; text-decoration: underline; min-height: 44px; }
  .x-cue { display: none; align-items: center; gap: 6px; font-size: 13px; color: #4a3d55; }
  .x-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: #4a3d55; }
  .x-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .x-legend i { display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 22px; border-radius: 5px; font: 500 13px var(--font-mono); font-style: normal; border: 1px solid #eadfd3; }
  .x-legend .l-coming { color: #2f62d9; background: #f4f7fe; }
  .x-legend .l-planned { color: #2f62d9; background: #fff; font-style: italic; border: 1px dashed #afc2f2; }
  .x-legend .l-none { color: #6e5f79; }
  .x-legend .l-no { color: #b4233c; background: repeating-linear-gradient(135deg, #fcf1f3 0 6px, #fff 6px 12px); font-weight: 700; }
  .x-legend .l-unv { color: #8a5300; background: #fff8ea; font-weight: 700; }
  .x-contrib { display: flex; flex-wrap: wrap; gap: 6px; }
  .x-contrib code { font: 13px var(--font-mono); background: #fff; border: 1px solid #eadfd3; border-radius: 6px; padding: 4px 8px; color: #140c1b; }
  @media (max-width: 1000px) { .x-hero { grid-template-columns: 1fr; gap: 22px; } }
  @media (max-width: 760px) {
    .x-cue { display: flex; }
    .x-body { grid-template-columns: 1fr; gap: 0; }
    .x-hero { padding: 26px 0 20px; }
    .x-tbl tbody th { min-width: 132px; padding: 10px; }
    .x-aside { display: none; position: static; padding-bottom: 8px; }
    .x-aside.x-open { display: block; }
  }
</style>
