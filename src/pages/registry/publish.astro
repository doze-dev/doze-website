<script>
  // "On this page": mark the section being read. Print: just the checklist.
  const toc = document.querySelector<HTMLElement>("[data-pb-toc]");
  const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")] : [];
  const secs = links.map((a) => document.getElementById(a.hash.slice(1))).filter((s): s is HTMLElement => !!s);
  const mark = () => {
    let cur = secs[0];
    for (const s of secs) if (s.getBoundingClientRect().top < window.innerHeight * 0.3) cur = s;
    for (const a of links) a.classList.toggle("pb-cur", a.hash === `#${cur?.id}`);
  };
  if (secs.length) {
    addEventListener("scroll", mark, { passive: true });
    mark();
  }
  document.querySelector("[data-pb-print]")?.addEventListener("click", () => window.print());
</script>

