---
// doze Kafka. Its own identity first (yellow on its own night), then the
// real console's tape, what it does as a sequence, alone or inside doze,
// what it isn't, install, and the family it belongs to.
import "../components/product/product.css";
import VCarousel from "../components/motion/VCarousel.astro";
import Cmd from "../components/product/Cmd.astro";
import Endorse from "../components/product/Endorse.astro";
import Family from "../components/product/Family.astro";
import Shot from "../components/product/Shot.astro";
import SubNav from "../components/product/SubNav.astro";
import Page from "../layouts/Page.astro";

const install = "curl -fsSL https://raw.githubusercontent.com/doze-dev/doze-kafka/main/install.sh | sh";
const clients = [
  "franz-go",
  "Sarama",
  "Java client",
  "Kafka Streams",
  "Spring Kafka",
  "librdkafka",
  "kcat",
  "confluent-kafka",
  "KafkaJS",
];
const slides = ["Clients", "The console", "Schema registry", "Transactions", "Durable and small"];
const pad = (n: number) => String(n).padStart(2, "0");
const step = (i: number) => `${pad(i + 1)} / ${pad(slides.length)} · ${slides[i]}`;
---
<Page notice title="doze Kafka" description="doze Kafka wakes a Kafka broker. No JVM to put to bed. One Go binary on 127.0.0.1:9092, single node, disk-backed, with a console, a schema registry and transactions." theme="kafka" current="kafka">
<div class="pp pp-kafka kf">
  <SubNav name="doze Kafka" icon="/brand/doze-kafka.svg" links={[["The tape", "#console"], ["What it does", "#features"], ["Alone or in doze", "#run"], ["What it isn't", "#not"], ["Install", "#install"], ["Docs", "/docs/kafka/"], ["Changelog", "/changelog/"]]} />

  <!-- Hero: its own identity -->
  <section class="pp-hero">
    <div class="pp-wrap kf-hero">
      <div class="kf-hero-say">
        <span class="pp-lockup"><img src="/brand/doze-kafka.svg" alt="" width="112" height="112" /><b>doze Kafka</b></span>
        <h1 class="pp-h1 kf-h1">Wakes a Kafka broker. <span class="pp-soft">No JVM to put to bed.</span></h1>
        <Endorse />
        <p class="pp-lede">A native broker that boots in milliseconds, sits quiet until a client connects, keeps your data on disk, and shuts down cleanly. One Go binary, single node: no JVM, no ZooKeeper, no KRaft quorum, no Docker.</p>
        <div class="pp-chips" aria-label="What it replaces"><span class="pp-chip">-Xmx1G</span><span class="pp-chip">waiting for controller quorum…</span><span class="pp-chip">all you wanted was one topic</span></div>
        <div class="kf-cta">
          <a class="pp-btn pp-btn-acc" href="#install">Install doze Kafka</a>
          <a class="pp-btn pp-btn-ghost" href="/docs/kafka/">Getting started</a>
        </div>
      </div>
      <div class="kf-hero-term">
        <div class="pp-term-head"><span>on its own</span><span>loopback only</span></div>
        <pre class="pp-term"><span class="c">$</span> <span class="w">doze-kafka</span>
  broker   <span class="a">127.0.0.1:9092</span>
  console  <span class="a">http://127.0.0.1:9093/_console/</span>

<span class="c">$</span> <span class="w">kcat -b 127.0.0.1:9092 -t orders.placed -P</span>
<span class="c">$</span> <span class="w">kcat -b 127.0.0.1:9092 -t orders.placed -C -e</span>
&#123;"order_id": "[id]", "total": "[amount]"&#125;</pre>
      </div>
    </div>
  </section>

  <!-- The real console: the tape -->
  <section class="pp-sec" id="console">
    <div class="pp-wrap">
      <div class="pp-head pp-head-c" data-reveal>
        <span class="pp-eyebrow">The console</span>
        <h2 class="pp-h2">See every record. And why it's there.</h2>
        <p class="pp-lede">Topics, the tape of records on disk, messages decoded, and underneath, the requests that touched them. On by default.</p>
      </div>
      <div class="kf-shot" data-reveal>
        <Shot src="/media/kafka-orders.webp" alt="The doze Kafka console for Larder: the orders.placed topic, its tape of 38 records across three partitions, the messages, the newest order decoded as JSON, and the requests underneath" title="doze Kafka · /_console" glow />
        <div class="pp-float kf-float"><b>The tape</b>Each mark is one record on disk, taller is bigger, newest on the right.</div>
      </div>
      <p class="pp-cap kf-cap">The real console, with Larder's four topics, its events and its four consumer groups: payments answers every order placed, on payments.settled or payments.failed.</p>
    </div>
  </section>

  <!-- What it does, as a sequence -->
  <section class="pp-sec pp-sec-tint" id="features">
    <div class="pp-wrap kf-wide">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">What it does</span>
        <h2 class="pp-h2">If your client can't tell, it's Kafka.</h2>
        <p class="pp-lede">Built to behave like Kafka to any client on the socket, and to leave out what no client can observe. Five things, one at a time.</p>
      </div>
      <VCarousel label="What doze Kafka does" height="min(720px, 84vh)" class="pp-vc">
        <div data-slide data-label={slides[0]} class="pp-slide">
          <div class="pp-slide-top">
            <div><span class="pp-step">{step(0)}</span><h3>Tested against your client, in CI, on every change.</h3></div>
            <div class="pp-slide-say"><p>One binary speaks the Kafka wire protocol 1 to 4; pick which with <code class="kf-c">--kafka-version</code> (default 4). Consumer groups use the classic protocol or KIP-848, chosen by the client.</p></div>
          </div>
          <div class="pp-slide-media"><div class="pp-slide-panel kf-panel">
            <span class="kf-k">Clients in CI</span>
            <ul class="kf-pills">{clients.map((c) => <li>{c}</li>)}</ul>
            <div class="kf-rows">
              <div><span>Wire protocol</span><b>Kafka 1 – 4</b></div>
              <div><span>Consumer groups</span><b>classic · KIP-848</b></div>
              <div class="kf-opt"><span>Default</span><b class="kf-mono">--kafka-version 4</b></div>
            </div>
          </div></div>
        </div>

        <div data-slide data-label={slides[1]} class="pp-slide">
          <div class="pp-slide-top">
            <div><span class="pp-step">{step(1)}</span><h3>A console that explains.</h3></div>
            <div class="pp-slide-say"><p>Topics, messages, lag, and why a group keeps rebalancing, with the Kafka error names. Here Larder takes orders: each one shows up in the traffic, payments answers it, and it lands on the topic's tape.</p>
              <span class="pp-also">the real console, with Larder's topics and events</span></div>
          </div>
          <div class="pp-slide-media"><Shot src="/media/kafka-live.webm" alt="Larder's orders arrive live: the Traffic page fills with the orders service producing, payments fetching and answering, and the consumer groups committing; then the orders.placed topic's tape grows mark by mark" title="doze Kafka · /_console" /></div>
        </div>

        <div data-slide data-label={slides[2]} class="pp-slide">
          <div class="pp-slide-top">
            <div><span class="pp-step">{step(2)}</span><h3>A schema registry, built in.</h3></div>
            <div class="pp-slide-say"><p>Confluent-compatible, for Avro, JSON Schema and Protobuf. Stock serializers need only <code class="kf-c">schema.registry.url</code>, and <code class="kf-c">doze-kafka env</code> prints it for you.</p></div>
          </div>
          <div class="pp-slide-media"><div class="pp-slide-panel kf-panel">
            <ul class="kf-pills kf-pills-on"><li>Avro</li><li>JSON Schema</li><li>Protobuf</li></ul>
            <pre class="pp-term kf-term"><span class="c">$</span> <span class="w">eval "$(doze-kafka env)"</span>
<span class="c">$</span> <span class="w">env | grep -E 'KAFKA|SCHEMA'</span>
KAFKA_BOOTSTRAP_SERVERS=<span class="a">127.0.0.1:9092</span>
KAFKA_BROKERS=<span class="a">127.0.0.1:9092</span>
SCHEMA_REGISTRY_URL=<span class="a">[the registry's address]</span>

<span class="c"># your serializer's config, and nothing else</span>
schema.registry.url = $SCHEMA_REGISTRY_URL</pre>
          </div></div>
        </div>

        <div data-slide data-label={slides[3]} class="pp-slide">
          <div class="pp-slide-top">
            <div><span class="pp-step">{step(3)}</span><h3>Transactions, SASL and TLS.</h3></div>
            <div class="pp-slide-say"><p>Transactional producers and read-committed consumers, so the exactly-once code you ship runs here first. SASL and TLS when you want to test them, off when you don't.</p></div>
          </div>
          <div class="pp-slide-media"><div class="pp-slide-panel kf-panel">
            <div class="kf-rows kf-rows-big">
              <div><span>Producers</span><b>transactional</b></div>
              <div><span>Consumers</span><b class="kf-mono">read_committed</b></div>
              <div><span>SASL</span><b>PLAIN · SCRAM-256 · SCRAM-512</b></div>
              <div><span>TLS</span><b>when you want it</b></div>
              <div><span>Under SASL</span><b class="kf-mono">doze-kafka env</b><em>prints KAFKA_SASL_MECHANISM, never a password</em></div>
            </div>
          </div></div>
        </div>

        <div data-slide data-label={slides[4]} class="pp-slide">
          <div class="pp-slide-top">
            <div><span class="pp-step">{step(4)}</span><h3>Durable, flat, embeddable.</h3></div>
            <div class="pp-slide-say"><p>Stop it with Ctrl-C: topics, messages and committed offsets are all there next time. And in Go tests it is a library.</p></div>
          </div>
          <div class="pp-slide-media"><div class="pp-slide-panel kf-panel kf-trio">
            <div class="kf-fact"><span class="kf-k">Durable</span><b>acks=all</b><p>An acknowledged write is fsynced before the ack.</p></div>
            <div class="kf-fact"><span class="kf-k">Flat memory</span><b>tens of MB</b><p>Idle memory stays there however much data sits on disk.</p></div>
            <div class="kf-fact"><span class="kf-k">In Go tests</span><b class="kf-mono">server.New(...)</b><p>Starts a broker on a free port, with nothing to clean up.</p></div>
          </div></div>
        </div>
      </VCarousel>
    </div>
  </section>

  <!-- Alone, or inside doze -->
  <section class="pp-sec" id="run">
    <div class="pp-wrap">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Works alone</span>
        <h2 class="pp-h2">On its own, or inside a doze stack.</h2>
        <p class="pp-lede">The same broker either way. On its own it answers on loopback, so nothing on your network can reach it. Inside doze it gets a name, so two projects can both have their 9092.</p>
      </div>
      <div class="kf-two">
        <div class="kf-way" data-reveal>
          <span class="kf-way-tag">On its own</span>
          <h3 class="pp-h3">One command, on loopback.</h3>
          <p>Run <code>doze-kafka</code>: the broker listens on <code class="kf-hi">127.0.0.1:9092</code> and its console on <code class="kf-hi">127.0.0.1:9093/_console/</code>. Linux and macOS, amd64 and arm64, Intel Macs included.</p>
          <pre class="pp-term"><span class="c">$</span> <span class="w">doze-kafka</span>
  broker   <span class="a">127.0.0.1:9092</span>
  console  <span class="a">http://127.0.0.1:9093/_console/</span>
<span class="c">^C</span>
<span class="c"># topics, messages and offsets are there next time</span></pre>
        </div>
        <div class="kf-way" data-reveal>
          <span class="kf-way-tag kf-way-doze"><img src="/brand/doze.svg" alt="" width="18" height="18" />Inside doze</span>
          <h3 class="pp-h3">The topics are the contracts.</h3>
          <p><code>doze add kafka</code>, and in <a href="/examples/">Larder</a>, our made-up example project, doze names it <code class="kf-hi">kafka.larder.doze</code>. Services in Go, Python and TypeScript (franz-go, confluent-kafka, KafkaJS) talk through four topics declared in doze.hcl, not created by whichever client writes first. doze itself needs Apple silicon on a Mac.</p>
          <pre class="pp-term"><span class="c"># doze.hcl, from the Larder example</span>
<span class="a">module</span> kafka <span class="w">"kafka"</span> &#123;
  version            = 4
  port               = 9092
  auto_create_topics = false

  topic <span class="w">"users.signed-up"</span>  &#123; partitions = 3 &#125;
  topic <span class="w">"orders.placed"</span>    &#123; partitions = 3 &#125;
  topic <span class="w">"payments.settled"</span> &#123; partitions = 3 &#125;
  topic <span class="w">"payments.failed"</span>  &#123; partitions = 3 &#125;
&#125;

<span class="c"># and in each app that uses it</span>
KAFKA_BROKERS = module.kafka.address</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- What it isn't -->
  <section class="pp-sec pp-sec-tint" id="not">
    <div class="pp-wrap kf-not">
      <div class="pp-head" data-reveal>
        <span class="pp-eyebrow">Honest by design</span>
        <h2 class="pp-h2">What it isn't, on purpose.</h2>
        <p class="pp-lede">A single node for development, not production. Anything a client can't observe through the socket is left out.</p>
      </div>
      <ul class="kf-not-list" data-reveal>
        <li><b>No replication,</b> ISR or controller quorum</li>
        <li><b>No byte-for-byte</b> on-disk segment compatibility</li>
        <li><b>No tiered storage</b> or quotas</li>
      </ul>
    </div>
  </section>

  <!-- Install -->
  <section class="pp-sec" id="install">
    <div class="pp-wrap">
      <div class="kf-inst" data-reveal>
        <div class="kf-inst-say">
          <h2 class="kf-inst-h">Kafka for your laptop. Hold the JVM.</h2>
          <span class="kf-inst-k">On its own: Linux and macOS, amd64 and arm64</span>
          <Cmd cmd={install} label="Copy the doze Kafka install command" />
          <span class="kf-inst-k">In a doze stack (Apple silicon on a Mac)</span>
          <Cmd cmd="doze add kafka" label="Copy doze add kafka" />
          <span class="kf-inst-more">More ways, and doze itself: <a href="/download/">Download</a> · <a href="/docs/kafka/">Docs</a></span>
        </div>
        <img class="kf-inst-icon" src="/brand/doze-kafka.svg" alt="" width="132" height="132" />
      </div>
    </div>
  </section>

  <p class="pp-wrap pp-small kf-tm">Apache Kafka is a trademark of the Apache Software Foundation. doze Kafka is not affiliated with it.</p>
  <Family current="kafka" />
</div>
</Page>

<style>
  .kf-hero { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  .kf-hero-say { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .kf-h1 { font-size: clamp(42px, 5.2vw, 72px); }
  .kf-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .kf-hero-term .pp-term { box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45); }

  .kf-shot { position: relative; max-width: 1180px; margin: 0 auto; }
  .kf-float { left: -12px; bottom: -28px; }
  .kf-cap { margin-top: 48px; }

  .kf-wide { max-width: 1340px; }
  .kf-c { font: 0.92em var(--font-mono); color: var(--t1); white-space: nowrap; }
  .kf-panel { display: flex; flex-direction: column; gap: 20px; justify-content: center; background: radial-gradient(120% 120% at 100% 0%, rgba(255, 214, 10, 0.07), transparent 60%), var(--well); }
  .kf-k { font: 500 12px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--t3); }
  .kf-pills { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .kf-pills li { padding: 10px 16px; border-radius: 999px; background: var(--g3); border: 1px solid var(--ln2); font-weight: 600; font-size: 15px; }
  .kf-pills-on li { background: var(--acc); color: var(--acc-ink); border-color: var(--acc); }
  .kf-rows { display: flex; flex-direction: column; border-top: 1px solid var(--ln); }
  .kf-rows div { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; padding: 14px 0; border-bottom: 1px solid var(--ln); }
  .kf-rows span { color: var(--t3); }
  .kf-rows b { font-size: 17px; }
  .kf-rows em { flex-basis: 100%; font-style: normal; font-size: 13.5px; color: var(--t3); text-align: right; }
  .kf-rows-big b { font-size: 19px; }
  .kf-mono { font-family: var(--font-mono); font-weight: 500; }
  .kf-term { font-size: 14px; }
  .kf-trio { flex-direction: row; align-items: stretch; gap: 14px; }
  .kf-fact { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; justify-content: center; padding: 24px; border-radius: 14px; background: var(--g2); border: 1px solid var(--ln); }
  .kf-fact b { font-family: var(--font-display); font-weight: 800; font-size: clamp(22px, 2.4vw, 32px); letter-spacing: -0.02em; color: var(--acc); }
  .kf-fact b.kf-mono { font-family: var(--font-mono); font-size: clamp(16px, 1.6vw, 21px); letter-spacing: 0; }
  .kf-fact p { margin: 0; color: var(--t2); line-height: 1.5; }

  .kf-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .kf-way { background: var(--g2); border: 1px solid var(--ln); border-radius: 22px; padding: 30px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .kf-way p { margin: 0; color: var(--t2); line-height: 1.6; }
  .kf-way code { font: 0.9em var(--font-mono); color: var(--t1); }
  .kf-way .kf-hi { color: var(--acc); }
  .kf-way .pp-term { font-size: 13px; }
  .kf-way-tag { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--acc); border: 1px solid var(--ln2); border-radius: 999px; padding: 6px 12px; }
  .kf-way-doze { color: #f0a24b; border-color: rgba(240, 162, 75, 0.4); }
  .kf-way-tag img { border-radius: 5px; }

  .kf-not { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .kf-not .pp-head { margin-bottom: 0; }
  .kf-not-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .kf-not-list li { padding: 18px 20px 18px 50px; position: relative; border-radius: 14px; background: var(--g); border: 1px solid var(--ln); color: var(--t2); font-size: 17px; }
  .kf-not-list li::before { content: "—"; position: absolute; left: 20px; color: var(--t3); }
  .kf-not-list b { color: var(--t1); font-weight: 600; }

  .kf-inst { background: var(--acc); color: var(--acc-ink); border-radius: 28px; padding: 48px; display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .kf-inst-say { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; max-width: 720px; }
  .kf-inst-h { margin: 0 0 8px; font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -0.025em; line-height: 1.05; }
  .kf-inst-k { font-weight: 600; font-size: 15px; margin-top: 4px; }
  .kf-inst :global(.pp-cmd) { background: #16150f; border-color: #16150f; }
  .kf-inst-more { font-size: 15px; }
  .pp .kf-inst-more a { color: var(--acc-ink); text-decoration: underline; font-weight: 600; display: inline-flex; min-height: 44px; align-items: center; }
  .kf-inst-icon { width: 132px; height: 132px; border-radius: 30px; box-shadow: 0 0 0 3px var(--acc-ink); flex: none; }
  .kf-tm { margin-top: -64px; padding-bottom: 40px; }

  @media (max-width: 1000px) {
    .kf-hero, .kf-two, .kf-not { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .kf-cta { flex-direction: column; align-items: stretch; width: 100%; }
    .kf-way { padding: 22px; }
    .kf-inst { padding: 26px; }
    .kf-inst-icon { display: none; }
    .kf-trio { flex-direction: column; }
    .kf-fact { padding: 16px; gap: 6px; }
    .kf-pills li { padding: 8px 12px; font-size: 13.5px; }
    .kf-rows div { padding: 10px 0; }
    .kf-rows b, .kf-rows-big b { font-size: 15px; }
    .kf-rows em { text-align: left; }
    .kf-term { font-size: 12px; }
    .kf-opt { display: none !important; }
    .kf-fact p { font-size: 14px; }
    .kf-panel { gap: 14px; }
    .kf-wide :global(.pp-vc .vc-frame), .kf-wide :global(.pp-vc .vc-frame > [data-slide]) { height: min(700px, 88vh); }
  }
</style>
