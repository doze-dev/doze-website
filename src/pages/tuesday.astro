---
// A Tuesday, honestly: the scroll-story version. One pinned stage (the
// laptop) and short beats that scroll beside it; each beat sets the stage to a
// complete state (see components/tuesday/steps.ts). The old click-through
// stays at /tuesday/ for comparison.
import Stage from "../components/tuesday/Stage.astro";
import { chapters, step } from "../components/tuesday/steps";
import Page from "../layouts/Page.astro";

// A beat's facts, as attributes the script reads: the stage it sets.
const b = (id: string) => {
  const s = step(id);
  return {
    id: `t-${id}`,
    "data-step": id,
    "data-ch": s.ch,
    "data-clock": s.clock,
    "data-light": s.light,
    "data-fan": String(s.fan),
    "data-heat": String(s.heat),
    "data-lid": s.lid ?? "open",
  };
};
---
<Page title="A Tuesday, honestly" theme="dark" current="none" description="One developer, one Tuesday, told twice: the way it goes, and the same day with doze.">
<div class="tn" data-tn data-light="dawn">

  <!-- the sky: the light of the day, behind everything -->
  <div class="tn-skyw" aria-hidden="true"><div class="tn-sky">
    <i data-l="dawn"></i><i data-l="morning"></i><i data-l="noon"></i><i data-l="afternoon"></i><i data-l="late"></i><i data-l="evening"></i><i data-l="dark"></i><i data-l="rewind"></i><i data-l="calm"></i><i data-l="calm-evening"></i><i data-l="night"></i>
  </div></div>

  <!-- the rail: the day's clock -->
  <nav class="tn-rail" aria-label="The day, by the clock">
    <span class="tn-rail-t">A Tuesday, honestly</span>
    <ol>
      {chapters.map((c) => (
        <li><a href={`#t-${c.id}`} data-rail={c.id} aria-label={`${c.label === "↺" ? "" : `${c.label}, `}${c.name}`}><span>{c.label}</span></a></li>
      ))}
    </ol>
    <button type="button" class="tn-snd" data-sound aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" /><path class="w" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
      <span class="tn-snd-l">Sound</span><span class="sr-only"> of the fan</span>
    </button>
    <i class="tn-prog" aria-hidden="true"></i>
  </nav>

  <!-- cold open -->
  <section class="tn-cold" id="t-0857" data-step="cold" data-ch="0857" data-clock="8:57" data-light="dawn" data-fan="1" data-heat="0.15" data-lid="open" aria-labelledby="tn-title">
    <p class="tn-cold-l" style="--d:0"><span class="tn-time">8:57</span></p>
    <p class="tn-cold-l" style="--d:1">The laptop opens.</p>
    <p class="tn-cold-l" style="--d:2">The fan is already spinning. <svg class="tn-cold-fan" viewBox="0 0 40 40" aria-hidden="true"><g><path d="M20 20 C 18 12, 20 5, 26 5 C 30 6, 27 14, 20 20Z" /><path d="M20 20 C 28 18, 35 20, 35 26 C 34 30, 26 27, 20 20Z" /><path d="M20 20 C 22 28, 20 35, 14 35 C 10 34, 13 26, 20 20Z" /><path d="M20 20 C 12 22, 5 20, 5 14 C 6 10, 14 13, 20 20Z" /></g></svg></p>
    <p class="tn-cold-l" style="--d:3">It never stopped. Not since yesterday.</p>
    <h1 class="tn-cold-h" id="tn-title" style="--d:4">A Tuesday, honestly.</h1>
    <p class="tn-cold-s" style="--d:5">One developer, a few projects, one ordinary day. Told twice.</p>
    <span class="tn-cue" aria-hidden="true" style="--d:6">Scroll</span>
  </section>

  <div class="tn-film">
    <Stage />

    <div class="tn-beats">

      <!-- ACT 1 -->
      <section class="tn-act" aria-labelledby="tn-a1">
        <div class="tn-ch" id="t-0902" tabindex="-1">
          <article class="tn-beat" {...b("0902a")}>
            <h2 class="tn-act-h" id="tn-a1"><span>Act one</span>Morning</h2>
            <p class="tn-time">9:02</p>
            <p>Coffee. Lid up.</p>
            <p>The tabs come back, one at a time.</p>
          </article>
          <article class="tn-beat" {...b("0902b")}>
            <p class="tn-list"><code>web · pnpm dev</code> <code>api · poetry run…</code> <code>worker · go run</code> <code>docker compose</code> <code>kafka.sh</code> <code>zsh (??)</code></p>
            <p>Six of them. You know what five are doing.</p>
            <p>Nobody knows what <code>zsh (??)</code> is doing. You leave it alone.</p>
          </article>
        </div>
        <div class="tn-ch" id="t-0920" tabindex="-1">
          <article class="tn-beat" {...b("0920a")}>
            <p class="tn-time">9:20</p>
            <p>You start the database. The first error of the day:</p>
            <p class="tn-line">Address already in use.</p>
          </article>
          <article class="tn-beat" {...b("0920b")}>
            <p>Whose address? You ask the machine.</p>
            <p>It's last week's client project. Its Postgres is still up, holding 5432, with the wrong data in it.</p>
          </article>
          <article class="tn-beat" {...b("0920c")}>
            <p>You open the README to see how this one is meant to start.</p>
            <p>It says <em>Getting started (2023)</em>. It was right, once.</p>
          </article>
          <article class="tn-beat" {...b("0920d")}>
            <p>You start writing ports down where you can see them.</p>
            <p>3000? 3001? 8000 or 8001? Your head is full, so the bezel gets the rest.</p>
          </article>
        </div>
      </section>

      <!-- ACT 2 -->
      <section class="tn-act" aria-labelledby="tn-a2">
        <div class="tn-ch" id="t-1130" tabindex="-1">
          <article class="tn-beat" {...b("1130a")}>
            <h2 class="tn-act-h" id="tn-a2"><span>Act two</span>Noon</h2>
            <p class="tn-time">11:30</p>
            <p>Orders can't reach its database. You ask the AI.</p>
          </article>
          <article class="tn-beat" {...b("1130b")}>
            <p>It answers before you've finished asking. Quick. Confident.</p>
          </article>
          <article class="tn-beat" {...b("1130c")}>
            <p>Wrong.</p>
            <p>“Apologies for the confusion! Try 5433.”</p>
          </article>
          <article class="tn-beat" {...b("1130d")}>
            <p>That's the other other one.</p>
            <p class="tn-line">It read every file. It can't see your machine.</p>
          </article>
        </div>
      </section>

      <!-- ACT 3 -->
      <section class="tn-act" aria-labelledby="tn-a3">
        <div class="tn-ch" id="t-1400" tabindex="-1">
          <article class="tn-beat" {...b("1400a")}>
            <h2 class="tn-act-h" id="tn-a3"><span>Act three</span>Afternoon</h2>
            <p class="tn-time">14:00</p>
            <p>A message. <em>can you look at billing?</em></p>
          </article>
          <article class="tn-beat" {...b("1400b")}>
            <p>A repo you haven't opened since spring. You wrote half of it.</p>
            <p><code>make dev</code>. No rule to make target.</p>
          </article>
          <article class="tn-beat" {...b("1400c")}>
            <p>There's a TypeScript service you've never seen. And a commit that says billing runs on the dev cluster now.</p>
            <p class="tn-line">Nothing is wrong, exactly. It just isn't familiar any more.</p>
          </article>
        </div>
        <div class="tn-ch" id="t-1530" tabindex="-1">
          <article class="tn-beat" {...b("1530a")}>
            <h3 class="tn-sub-h">How we got here</h3>
            <p class="tn-time">15:30</p>
            <p>Last year local development got too hard, so it moved. Every team got a dev environment in the cloud, run by the platform team.</p>
            <p>Which means tunnels. One port-forward per thing you need, and 5432 is still taken on this side.</p>
          </article>
          <article class="tn-beat" {...b("1530b")}>
            <p>Every save is a sync and a rebuild, somewhere else.</p>
            <p>The debugger waits for the tunnel. The tunnel waits for the debugger. Timed out.</p>
            <p>The logs are in another tool, in another tab.</p>
          </article>
          <article class="tn-beat" {...b("1530c")}>
            <p>Then <code>#platform</code>: <em>Dev environments degraded. Investigating. No ETA.</em></p>
            <p>Nobody on your team can run anything.</p>
          </article>
          <article class="tn-beat" {...b("1530d")}>
            <p>The platform team is on a production incident first, as they should be. Half of them are asleep in another timezone.</p>
            <p>You sit, and wait.</p>
            <p class="tn-line">You needed a platform team just to write code.</p>
            <p>And on your desk, the most powerful computer you've ever owned sits there, waiting for a cluster to come back.</p>
            <p>Local development didn't get fixed. It got moved.</p>
          </article>
        </div>
      </section>

      <!-- ACT 4 -->
      <section class="tn-act" aria-labelledby="tn-a4">
        <div class="tn-ch" id="t-1840" tabindex="-1">
          <article class="tn-beat" {...b("1840a")}>
            <h2 class="tn-act-h" id="tn-a4"><span>Act four</span>Evening</h2>
            <p class="tn-time">18:40</p>
            <p>Done. Before you go, you look.</p>
            <p>23 containers still up. Two node processes since yesterday.</p>
          </article>
          <article class="tn-beat" {...b("1840b")}>
            <p>You close the lid.</p>
            <p>None of it stops. Nothing stops on its own, so nothing stops.</p>
            <p>The bag is warm by the time you're home.</p>
          </article>
          <article class="tn-beat tn-silence" {...b("1840c")}>
            <p class="tn-line">You didn't design this.<br />It grew.</p>
          </article>
        </div>
      </section>

      <!-- THE TURN -->
      <section class="tn-act" aria-labelledby="tn-rw">
        <div class="tn-ch" id="t-rewind" tabindex="-1">
          <article class="tn-beat tn-turn" {...b("rewind")}>
            <h2 class="tn-turn-h" id="tn-rw">Rewind.</h2>
            <p class="tn-line">Same Tuesday. One file.</p>
          </article>
        </div>
      </section>

      <!-- ACT 5 -->
      <section class="tn-act tn-replay" aria-labelledby="tn-a5">
        <div class="tn-ch" id="t-doze" tabindex="-1">
          <article class="tn-beat" {...b("d0902")}>
            <h2 class="tn-act-h" id="tn-a5"><span>Act five</span>The same day, with doze</h2>
            <p class="tn-time">9:02</p>
            <p>Lid up. The fan is off. It was off all night.</p>
            <p><code>doze up</code>. The stack is Larder, our made-up grocery example: nine apps, four modules and a mail catcher, from one <code>doze.hcl</code>.</p>
          </article>
          <article class="tn-beat" {...b("d0920")}>
            <p class="tn-time">9:20</p>
            <p>Something holds 8000. You don't hunt for it; doze names it.</p>
            <p>Stop it, or give every service an address of its own, once, and stop counting ports.</p>
          </article>
          <article class="tn-beat" {...b("d1130")}>
            <p class="tn-time">11:30</p>
            <p>Orders is unhappy. Your agent asks doze what's running instead of guessing from the files.</p>
            <p>It's right the first time. It can see your machine now.</p>
          </article>
          <article class="tn-beat" {...b("d1400")}>
            <p class="tn-time">14:00</p>
            <p><em>can you look at billing?</em> <code>git pull && doze up</code>.</p>
            <p>The new TypeScript service is just there: whoever added it added it to <code>doze.hcl</code>. If that file were wrong, nothing would start, so it can't go stale.</p>
          </article>
          <article class="tn-beat" {...b("d1530")}>
            <p class="tn-time">15:30</p>
            <p>Billing runs here, on your laptop, as plain processes. A breakpoint just hits.</p>
            <p><code>#platform</code> has an outage. You keep working. Nobody's pager is involved.</p>
            <p>The platform team gets to build the platform, not babysit dev boxes.</p>
          </article>
          <article class="tn-beat" {...b("d1840")}>
            <p class="tn-time">18:40</p>
            <p>The menu bar. Billing went to sleep on its own, two minutes after you stopped calling it.</p>
            <p>Larder's workers read Kafka all day, so they never sleep. You stop the stack: one click.</p>
          </article>
          <article class="tn-beat tn-home" {...b("d1900")}>
            <p>You close the lid. Nothing is awake.</p>
            <p>The laptop is cool. You go home.</p>
          </article>
        </div>
      </section>
    </div>
  </div>

  <!-- ending -->
  <section class="tn-end" id="t-end" data-step="end" data-ch="doze" data-clock="18:41" data-light="night" data-fan="0" data-heat="0" data-lid="closed" aria-labelledby="tn-end-h">
    <img class="tn-end-moon" src="/brand/family-moon.svg" alt="" width="56" height="56" />
    <h2 class="tn-end-h" id="tn-end-h">The same Tuesday, twice.</h2>
    <div class="tn-tally">
      <div class="tn-tally-h" aria-hidden="true"><span></span><b>How it is</b><b>With doze</b></div>
      <dl>
        <div><dt>Commands to remember</dt><dd class="was">7</dd><dd class="now">1 <small>doze up</small></dd></div>
        <div><dt>Ports in your head</dt><dd class="was">8</dd><dd class="now">0 <small>every service has a name</small></dd></div>
        <div><dt>Files to read before you start</dt><dd class="was">9</dd><dd class="now">1 <small>doze.hcl</small></dd></div>
        <div><dt>Teams you wait on to run your code</dt><dd class="was">1</dd><dd class="now">0 <small>it runs on your laptop</small></dd></div>
        <div><dt>Still running when you close the lid</dt><dd class="was">23</dd><dd class="now">0 <small>asleep, or stopped</small></dd></div>
      </dl>
      <p class="tn-tally-n">These are the story's own numbers, not a benchmark. Yours will differ. Count yours.</p>
    </div>
    <p class="tn-family">Work hard. Then close the lid.</p>
    <div class="tn-cta">
      <a class="tn-btn" href="/download/">Get doze</a>
      <a class="tn-btn2" href="/examples/">Run the example <small>Larder: made up, real code</small></a>
    </div>
    <a class="tn-next" href="/the-long-way-round/">Next: how local development got moved, and how it comes back <span aria-hidden="true">→</span></a>
    <a class="tn-again" href="#t-0857">Start the day again</a>
  </section>
</div>
</Page>

<script>import "../scripts/tuesday.ts";</script>

<style is:global>
/* ── Skin: every colour, face and size the story uses. Re-skin here. ── */
.tn {
  --tn-ground: #140c1b;
  --tn-raised: #1e1328;
  --tn-line: #34233f;
  --tn-text: #f4ece4;
  --tn-text-2: #d6c8df;
  --tn-dim: #b3a3c0;
  --tn-amber: #f0a24b;
  --tn-amber-ink: #2a1534;
  --tn-good: #8be39b;
  --tn-bad: #ff9aa8;
  --tn-heat: #ff6a2b;
  --tn-paper: #f3e3a0;
  --tn-paper-ink: #3a2448;
  --tn-term: #120b18;
  --tn-term-text: #e9dff0;
  --tn-term-dim: #9c8aab;
  --tn-display: var(--font-display);
  --tn-body: var(--font-text);
  --tn-mono: var(--font-mono);
  /* the light of the day */
  --sky-dawn: linear-gradient(180deg, #1d2431 0%, #161420 60%, #140c1b 100%);
  --sky-morning: radial-gradient(120% 70% at 80% 0%, #2a3a4c 0%, transparent 60%), linear-gradient(180deg, #1c2733 0%, #151621 70%);
  --sky-noon: radial-gradient(70% 45% at 50% -5%, #4a4752 0%, transparent 70%), linear-gradient(180deg, #2f2d37 0%, #1b1822 80%);
  --sky-afternoon: radial-gradient(90% 60% at 100% 10%, #3a2c2a 0%, transparent 65%), linear-gradient(180deg, #2a2129 0%, #181320 80%);
  --sky-late: radial-gradient(90% 70% at 100% 30%, #4a2e22 0%, transparent 65%), linear-gradient(180deg, #2a1d25 0%, #170f1c 85%);
  --sky-evening: radial-gradient(100% 80% at 0% 100%, #6b2e14 0%, transparent 60%), linear-gradient(180deg, #2a1622 0%, #1d0f1c 100%);
  --sky-dark: #050307;
  --sky-rewind: radial-gradient(60% 50% at 50% 50%, #1a1224 0%, #08060b 100%);
  --sky-calm: linear-gradient(180deg, #1d1428 0%, #170f21 100%);
  --sky-calm-evening: radial-gradient(90% 70% at 0% 100%, #3a2030 0%, transparent 65%), linear-gradient(180deg, #1e1428 0%, #170f21 100%);
  --sky-night: radial-gradient(60% 50% at 85% 10%, #2a1e3a 0%, transparent 70%), linear-gradient(180deg, #100a18 0%, #0b0711 100%);
  --rail-h: 60px;
  --stage-h: calc(100svh - var(--rail-h));
}

/* ── Frame ── */
.tn { position: relative; isolation: isolate; color: var(--tn-text); font-family: var(--tn-body); }
.tn code, .tn pre { font-family: var(--tn-mono); font-variant-ligatures: none; }
.tn-skyw { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
.tn-sky { position: sticky; top: 0; height: 100svh; overflow: hidden; }
.tn-sky i { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s ease; }
.tn-sky i[data-l="dawn"] { background: var(--sky-dawn); }
.tn-sky i[data-l="morning"] { background: var(--sky-morning); }
.tn-sky i[data-l="noon"] { background: var(--sky-noon); }
.tn-sky i[data-l="afternoon"] { background: var(--sky-afternoon); }
.tn-sky i[data-l="late"] { background: var(--sky-late); }
.tn-sky i[data-l="evening"] { background: var(--sky-evening); }
.tn-sky i[data-l="dark"] { background: var(--sky-dark); }
.tn-sky i[data-l="rewind"] { background: var(--sky-rewind); }
.tn-sky i[data-l="calm"] { background: var(--sky-calm); }
.tn-sky i[data-l="calm-evening"] { background: var(--sky-calm-evening); }
.tn-sky i[data-l="night"] { background: var(--sky-night); }
.tn[data-light="dawn"] .tn-sky i[data-l="dawn"], .tn[data-light="morning"] .tn-sky i[data-l="morning"], .tn[data-light="noon"] .tn-sky i[data-l="noon"], .tn[data-light="afternoon"] .tn-sky i[data-l="afternoon"], .tn[data-light="late"] .tn-sky i[data-l="late"], .tn[data-light="evening"] .tn-sky i[data-l="evening"], .tn[data-light="dark"] .tn-sky i[data-l="dark"], .tn[data-light="rewind"] .tn-sky i[data-l="rewind"], .tn[data-light="calm"] .tn-sky i[data-l="calm"], .tn[data-light="calm-evening"] .tn-sky i[data-l="calm-evening"], .tn[data-light="night"] .tn-sky i[data-l="night"] { opacity: 1; }

/* ── Rail ── */
.tn-rail { position: sticky; top: 0; z-index: 20; height: var(--rail-h); display: flex; align-items: center; gap: 16px; padding: 0 24px; background: rgba(12, 8, 16, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.tn-rail-t { font: 700 15px/1 var(--tn-display); letter-spacing: -0.01em; color: var(--tn-text-2); white-space: nowrap; flex: 0 0 auto; }
.tn-rail ol { list-style: none; margin: 0 auto; padding: 0; display: flex; align-items: center; gap: 2px; position: relative; }
.tn-rail a { display: flex; align-items: center; justify-content: center; min-width: 52px; height: 44px; padding: 0 8px; border-radius: 10px; text-decoration: none; color: var(--tn-dim); font: 500 13px/1 var(--tn-mono); position: relative; transition: color 0.3s; }
.tn-rail a::before { content: ""; position: absolute; left: 50%; bottom: 5px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: currentColor; opacity: 0.45; transition: transform 0.3s, opacity 0.3s, background 0.3s; }
.tn-rail a:hover { color: var(--tn-text); }
.tn-rail a:focus-visible, .tn-snd:focus-visible, .tn-end a:focus-visible { outline: 2px solid var(--tn-amber); outline-offset: 2px; }
.tn-rail a.past { color: var(--tn-text-2); }
.tn-rail a[aria-current] { color: var(--tn-amber); }
.tn-rail a[aria-current]::before { opacity: 1; transform: scale(1.5); }
.tn-rail a[data-rail="doze"] span { font-family: var(--tn-display); font-weight: 700; font-size: 15px; }
.tn-snd { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.14); background: transparent; color: var(--tn-text-2); font: 500 13px/1 var(--tn-body); cursor: pointer; }
.tn-snd svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
.tn-snd .w { opacity: 0.25; }
.tn-snd[aria-pressed="true"] { color: var(--tn-amber); border-color: rgba(240, 162, 75, 0.5); }
.tn-snd[aria-pressed="true"] .w { opacity: 1; }
.tn-prog { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--tn-amber); transform-origin: 0 50%; transform: scaleX(0); opacity: 0.8; }

/* ── Cold open ── */
.tn-cold { min-height: calc(100svh - var(--rail-h)); display: flex; flex-direction: column; justify-content: center; max-width: 1100px; margin: 0 auto; padding: 72px 40px 96px; position: relative; scroll-margin-top: var(--rail-h); }
.tn-cold-l { margin: 0 0 10px; font: 500 clamp(22px, 2.6vw, 30px)/1.35 var(--tn-body); color: var(--tn-text-2); }
.tn-cold-l .tn-time { font-size: inherit; }
.tn-cold-h { margin: 40px 0 18px; font: 800 clamp(52px, 8vw, 112px)/0.95 var(--tn-display); letter-spacing: -0.035em; color: var(--tn-text); }
.tn-cold-s { margin: 0; font-size: 19px; color: var(--tn-text-2); max-width: 34ch; }
.tn-cold-fan { width: 0.9em; height: 0.9em; vertical-align: -0.12em; margin-left: 6px; fill: var(--tn-dim); }
.tn-cold-fan g { transform-origin: 20px 20px; animation: tn-spin 1.1s linear infinite; }
.tn-cue { position: absolute; left: 40px; bottom: 32px; font: 500 12px/1 var(--tn-mono); letter-spacing: 0.18em; text-transform: uppercase; color: var(--tn-dim); }
.tn-cue::after { content: ""; display: block; width: 1px; height: 36px; margin: 12px 0 0 4px; background: linear-gradient(var(--tn-dim), transparent); }
.tn-js .tn-cold [style*="--d"] { animation: tn-rise 0.9s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--d) * 0.55s + 0.15s); }

/* ── Film: beats beside (desktop) or under (phone) the pinned stage ── */
.tn-film { display: grid; grid-template-columns: minmax(300px, 400px) minmax(0, 1fr); column-gap: clamp(32px, 5vw, 80px); max-width: 1440px; margin: 0 auto; padding: 0 clamp(24px, 4vw, 56px); }
.tn-beats { grid-column: 1; grid-row: 1; }
.tn-stage { grid-column: 2; grid-row: 1; position: sticky; top: var(--rail-h); align-self: start; height: var(--stage-h); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; }
.tn:not(.tn-js) .tn-stage { display: none; }
.tn:not(.tn-js) .tn-film { grid-template-columns: minmax(0, 640px); justify-content: center; }

.tn-ch { scroll-margin-top: var(--rail-h); outline: none; }
.tn-beat { min-height: 88svh; display: flex; flex-direction: column; justify-content: center; padding: 8vh 0; opacity: 0.4; transition: opacity 0.6s ease; }
.tn-beat.on, .tn:not(.tn-js) .tn-beat, .tn-rm .tn-beat { opacity: 1; }
.tn-replay .tn-beat { min-height: 70svh; }
.tn-beat p { margin: 0 0 14px; font-size: 20px; line-height: 1.5; color: var(--tn-text-2); max-width: 34ch; text-wrap: pretty; }
.tn-beat p:first-of-type:not(.tn-time) { color: var(--tn-text); }
.tn-beat p code, .tn-end code { font-size: 0.86em; padding: 1px 6px; border-radius: 6px; background: rgba(255, 255, 255, 0.08); color: var(--tn-text); white-space: nowrap; }
.tn-beat em { font-style: normal; color: var(--tn-text); background: rgba(240, 162, 75, 0.14); padding: 0 4px; border-radius: 4px; }
.tn-time { font: 600 15px/1 var(--tn-mono) !important; letter-spacing: 0.04em; color: var(--tn-amber) !important; margin: 0 0 18px !important; }
.tn-line { font: 700 clamp(28px, 2.6vw, 36px)/1.15 var(--tn-display) !important; letter-spacing: -0.02em; color: var(--tn-text) !important; margin-top: 10px !important; max-width: 18ch !important; text-wrap: balance; }
.tn-list { display: flex; flex-wrap: wrap; gap: 6px; }
.tn-list code { white-space: nowrap; }
.tn-act-h { margin: 0 0 36px; font: 800 clamp(40px, 4vw, 52px)/1 var(--tn-display); letter-spacing: -0.03em; color: var(--tn-text); }
.tn-act-h span, .tn-sub-h { display: block; margin-bottom: 10px; font: 600 13px/1 var(--tn-body); letter-spacing: 0.16em; text-transform: uppercase; color: var(--tn-dim); }
.tn-sub-h { margin: 0 0 22px; }
.tn-silence { min-height: 120svh; }
.tn-silence .tn-line { font-size: clamp(34px, 3.6vw, 52px) !important; color: var(--tn-text-2) !important; }
.tn-turn { min-height: 110svh; }
.tn-turn-h { margin: 0 0 18px; font: 800 clamp(64px, 8vw, 120px)/0.9 var(--tn-display); letter-spacing: -0.04em; }
.tn-replay .tn-act-h span { color: var(--tn-amber); }
.tn-home { min-height: 90svh; }
.tn-home p:last-child { font: 700 30px/1.2 var(--tn-display); color: var(--tn-text); letter-spacing: -0.015em; }

/* ── Stage ── */
.tn-laptop { width: min(92%, 860px, calc((var(--stage-h) - 150px) * 1.5)); container-type: inline-size; position: relative; }
.tn-glow { position: absolute; left: 50%; top: 50%; width: 90%; aspect-ratio: 1.6; translate: -50% -42%; border-radius: 50%; background: radial-gradient(closest-side, var(--tn-heat), transparent); opacity: calc(var(--heat, 0) * 0.42); filter: blur(30px); transition: opacity 1.2s ease; pointer-events: none; }
.tn-lid { position: relative; aspect-ratio: 16 / 10.4; padding: 2.1cqi 2.1cqi 2.6cqi; border-radius: 2.4cqi 2.4cqi 0.8cqi 0.8cqi; background: linear-gradient(180deg, #19141d, #0c090e); box-shadow: inset 0 0 0 0.18cqi #3a3140, 0 3cqi 7cqi rgba(0, 0, 0, 0.45); transform-origin: 50% 100%; transition: transform 0.9s cubic-bezier(.6, 0, .2, 1); }
.tn-stage[data-lid="closed"] .tn-lid { transform: scaleY(0.035); }
.tn-screen { position: relative; height: 100%; overflow: hidden; border-radius: 0.6cqi; background: #0b0810; transition: opacity 0.6s ease; }
.tn-stage[data-lid="closed"] .tn-screen { opacity: 0; }
.tn-wall { position: absolute; inset: 0; background: linear-gradient(160deg, #2c2140 0%, #1c1328 55%, #15101d 100%); transition: opacity 1s; }
.tn-wall::after { content: ""; position: absolute; inset: 0; background: linear-gradient(160deg, #3d5370 0%, #1d2534 70%); opacity: 0; transition: opacity 1.2s; }
.tn-stage[data-light="noon"] .tn-wall::after { opacity: 0.55; }
.tn-stage[data-light="morning"] .tn-wall::after { opacity: 0.35; }
.tn-base { position: relative; width: 108%; margin-left: -4%; height: 2.3cqi; border-radius: 0.2cqi 0.2cqi 2.2cqi 2.2cqi; background: linear-gradient(180deg, #4a4150 0%, #2a2430 40%, #17131b 100%); box-shadow: 0 2.4cqi 4cqi rgba(0, 0, 0, 0.5); }
.tn-base i { position: absolute; left: 50%; top: 0; width: 15%; height: 0.9cqi; translate: -50% 0; border-radius: 0 0 1cqi 1cqi; background: #1b161f; }

.tn-mb { position: absolute; inset: 0 0 auto; z-index: 6; height: 3.4cqi; display: flex; align-items: center; gap: 1.6cqi; padding: 0 1.6cqi; font: 500 1.35cqi/1 var(--tn-body); color: rgba(255, 255, 255, 0.82); background: rgba(10, 6, 14, 0.5); backdrop-filter: blur(8px); }
.tn-mb b { font-weight: 700; }
.tn-mb-sp { flex: 1; }
.tn-mb-moon { width: 1.8cqi; height: 1.8cqi; }
.tn-mb-clock { font-variant-numeric: tabular-nums; min-width: 4cqi; text-align: right; }

/* Stage layers: shown when the step is theirs. Crossfade (opacity) only. */
.tn-stage [data-in] { opacity: 0; transition: opacity 0.45s ease, transform 0.6s cubic-bezier(.2, .7, .2, 1); }
.tn-stage [data-in].on { opacity: 1; }
.tn-tabs span[data-in] { transition-delay: calc(var(--i, 0) * 0.14s); }

.tn-win { position: absolute; border-radius: 1cqi; overflow: hidden; background: var(--tn-term); box-shadow: 0 0 0 0.12cqi rgba(255, 255, 255, 0.09), 0 2cqi 5cqi rgba(0, 0, 0, 0.5); }
.tn-wt { height: 3.2cqi; display: flex; align-items: center; padding: 0 1.4cqi 0 7cqi; font: 600 1.3cqi/1 var(--tn-body); color: #cbbfd4; background: #241a2d; position: relative; }
.tn-wt::before { content: ""; position: absolute; left: 1.4cqi; top: 50%; width: 1cqi; height: 1cqi; translate: 0 -50%; border-radius: 50%; background: #ff6b5f; box-shadow: 1.6cqi 0 #f6bd3b, 3.2cqi 0 #3fc950; }
.tn-term { left: 4%; top: 9.5%; width: 66%; height: 80%; }
.tn-tabs { height: 3.4cqi; display: flex; align-items: stretch; gap: 0.3cqi; padding: 0.5cqi 0.6cqi 0 6.4cqi; background: #241a2d; position: relative; overflow: hidden; }
.tn-tabs::before { content: ""; position: absolute; left: 1.4cqi; top: 50%; width: 1cqi; height: 1cqi; translate: 0 -40%; border-radius: 50%; background: #ff6b5f; box-shadow: 1.6cqi 0 #f6bd3b, 3.2cqi 0 #3fc950; }
.tn-tabs span { flex: 0 1 auto; min-width: 0; text-overflow: ellipsis; display: block; line-height: 2.9cqi; padding: 0 1.1cqi; border-radius: 0.7cqi 0.7cqi 0 0; font: 500 1.02cqi/2.9cqi var(--tn-mono); color: #a796b5; white-space: nowrap; background: rgba(255, 255, 255, 0.03); max-width: 0; padding-inline: 0; overflow: hidden; }
.tn-tabs span.on { max-width: 30cqi; padding-inline: 1.1cqi; }
.tn-tabs span.hi { background: var(--tn-term); color: #f4ece4; }
.tn-tb { position: relative; height: calc(100% - 3.4cqi); }
.tn-pg { position: absolute; inset: 0; margin: 0; padding: 1.8cqi 2cqi; font-size: 1.32cqi; line-height: 1.6; color: var(--tn-term-text); white-space: pre; overflow: hidden; }
.tn-pg i { font-style: normal; color: var(--tn-term-dim); }
.tn-pg b { font-weight: 500; color: var(--tn-bad); }
.tn-pg u { text-decoration: none; color: var(--tn-good); }
.tn-cur { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; background: var(--tn-term-text); animation: tn-blink 1.1s steps(2) infinite; }

.tn-readme { right: 3%; top: 22%; width: 36%; height: 46%; background: #fbf6ee; transform: translateY(2cqi); }
.tn-readme.on { transform: none; }
.tn-readme .tn-wt { background: #ebe2d6; color: #3a2d44; }
.tn-rb { display: flex; flex-direction: column; gap: 1.1cqi; padding: 2cqi; font: 500 1.4cqi/1.3 var(--tn-mono); color: #3a2d44; }
.tn-rb b { font-weight: 700; color: #1a1020; }
.tn-rb s { color: #8a7c94; }

.tn-chat { right: 3%; top: 12%; width: 44%; height: 80%; background: #1b1424; transform: translateY(2cqi); }
.tn-chat.on, .tn-chan.on, .tn-diff.on, .tn-ed.on { transform: none; }
.tn-cb { display: flex; flex-direction: column; gap: 1.2cqi; padding: 1.8cqi; }
.tn-cb p { margin: 0; max-width: 88%; padding: 1.1cqi 1.5cqi; border-radius: 1.4cqi; font: 400 1.4cqi/1.4 var(--tn-body); transform: translateY(1cqi); }
.tn-cb p.on { transform: none; }
.tn-cb .me { align-self: flex-end; background: #5b3b7a; color: #fff; border-bottom-right-radius: 0.4cqi; }
.tn-cb .ai { align-self: flex-start; background: #2d2338; color: #eee4f3; border-bottom-left-radius: 0.4cqi; }
.tn-cb code { font-size: 0.92em; padding: 0 0.4cqi; border-radius: 0.4cqi; background: rgba(255, 255, 255, 0.1); }
.tn-cb .tool { align-self: flex-start; background: transparent; padding: 0 0.4cqi; color: #a796b5; font-size: 1.2cqi; }
.tn-typing { display: flex; gap: 0.6cqi; }
.tn-typing i { width: 0.8cqi; height: 0.8cqi; border-radius: 50%; background: #a796b5; animation: tn-blink 1s infinite; }
.tn-typing i:nth-child(2) { animation-delay: 0.2s; }
.tn-typing i:nth-child(3) { animation-delay: 0.4s; }
.tn-agent .ai { border: 0.12cqi solid rgba(139, 227, 155, 0.5); }

.tn-toast { position: absolute; right: 2.4%; top: 6.5%; z-index: 5; display: flex; gap: 1.2cqi; align-items: center; width: 32%; padding: 1.3cqi 1.5cqi; border-radius: 1.4cqi; background: rgba(48, 38, 58, 0.94); box-shadow: 0 1.6cqi 4cqi rgba(0, 0, 0, 0.5); transform: translateX(4cqi); }
.tn-toast.on { transform: none; }
.tn-toast div { display: flex; flex-direction: column; gap: 0.4cqi; font: 400 1.35cqi/1.2 var(--tn-body); color: #eee4f3; }
.tn-toast b { font-weight: 700; }
.tn-av { flex: 0 0 auto; width: 3.6cqi; height: 3.6cqi; border-radius: 50%; display: grid; place-items: center; background: #3fa78a; color: #fff; font: 700 1.6cqi/1 var(--tn-body); }

.tn-chan { right: 3%; top: 14%; width: 48%; height: 70%; background: #1b1424; transform: translateY(2cqi); }
.tn-chan .bot { align-self: flex-start; background: #3a1f28; color: #ffdfe4; }
.tn-chan .bot b { display: block; margin-bottom: 0.3cqi; font-size: 1.15cqi; color: var(--tn-bad); text-transform: uppercase; letter-spacing: 0.08em; }
.tn-stage[data-step="d1530"] .tn-chan { opacity: 0.38; filter: saturate(0.4); top: 46%; height: 42%; right: 2%; width: 40%; }
.tn-wait { position: absolute; left: 4%; bottom: 6%; z-index: 4; display: flex; align-items: center; gap: 1.2cqi; padding: 1.2cqi 2cqi; border-radius: 99px; background: rgba(0, 0, 0, 0.6); font: 500 1.4cqi/1 var(--tn-body); color: #eee4f3; }
.tn-wait span { width: 1.8cqi; height: 1.8cqi; border-radius: 50%; border: 0.3cqi solid rgba(255, 255, 255, 0.2); border-top-color: #eee4f3; animation: tn-spin 0.9s linear infinite; }

.tn-diff { right: 3%; top: 40%; width: 50%; height: 44%; transform: translateY(2cqi); }
.tn-db { margin: 0; padding: 1.6cqi 2cqi; font-size: 1.28cqi; line-height: 1.6; white-space: pre; }
.tn-db ins { text-decoration: none; color: var(--tn-good); }
.tn-ed { right: 3%; top: 12%; width: 54%; height: 36%; background: #17111f; transform: translateY(2cqi); z-index: 3; }
.tn-eb { margin: 0; padding: 1.6cqi 0; font-size: 1.3cqi; line-height: 1.75; white-space: pre; color: #ddd2e6; }
.tn-eb i { display: inline-block; width: 5cqi; padding-right: 1.4cqi; text-align: right; font-style: normal; color: #7d6d8b; }
.tn-eb em { display: block; font-style: normal; background: rgba(240, 162, 75, 0.18); box-shadow: inset 0.4cqi 0 var(--tn-amber); }
.tn-eb em i { color: var(--tn-amber); }
.tn-paused { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.9cqi 2cqi; font: 600 1.2cqi/1 var(--tn-body); color: var(--tn-amber-ink); background: var(--tn-amber); }

.tn-menu { position: absolute; right: 9%; top: 3.8%; z-index: 7; width: 38%; padding: 0.8cqi; border-radius: 1.2cqi; background: rgba(40, 32, 48, 0.96); box-shadow: 0 0 0 0.12cqi rgba(255, 255, 255, 0.12), 0 2cqi 5cqi rgba(0, 0, 0, 0.55); font: 400 1.4cqi/1 var(--tn-body); color: #eee4f3; transform: translateY(-1cqi); }
.tn-menu.on { transform: none; }
.tn-menu-h { padding: 1cqi 1.2cqi 0.6cqi; font-weight: 700; font-size: 1.15cqi; color: #a796b5; }
.tn-menu-r { display: flex; justify-content: space-between; gap: 1cqi; padding: 1cqi 1.2cqi; border-radius: 0.6cqi; }
.tn-menu-r:nth-child(2) { background: rgba(255, 255, 255, 0.06); }
.tn-menu-r span { display: flex; align-items: center; gap: 1cqi; }
.tn-menu-r i { width: 1cqi; height: 1cqi; border-radius: 50%; background: #6d5d7b; }
.tn-menu-r i.g { background: transparent; box-shadow: inset 0 0 0 0.2cqi #a796b5; }
.tn-menu-r em { font-style: normal; color: #a796b5; }
.tn-menu hr { border: 0; height: 0.12cqi; background: rgba(255, 255, 255, 0.1); margin: 0.6cqi 0.4cqi; }

.tn-rw { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 2cqi; background: #08060b; }
.tn-rw svg { width: 26cqi; height: 26cqi; fill: none; stroke: var(--tn-text); stroke-linecap: round; }
.tn-rw circle { stroke-width: 1.2; opacity: 0.35; }
.tn-rw line { stroke-width: 2.6; transform-origin: 50px 50px; }
.tn-rw .h { transform: rotate(268.5deg); }
.tn-rw .m { transform: rotate(342deg); }
.tn-rw .m { stroke: var(--tn-amber); stroke-width: 1.8; }
.tn-rw.on .h { animation: tn-back-h 2.2s cubic-bezier(.5, 0, .2, 1) both; }
.tn-rw.on .m { animation: tn-back-m 2.2s cubic-bezier(.5, 0, .2, 1) both; }
.tn-rw span { font: 600 2.4cqi/1 var(--tn-mono); color: var(--tn-text-2); }

.tn-note { position: absolute; z-index: 8; left: var(--x); top: var(--y); max-width: 13cqi; padding: 0.8cqi 1cqi 1.1cqi; font: 600 1.35cqi/1.15 var(--tn-body); color: var(--tn-paper-ink); background: var(--tn-paper); box-shadow: 0 0.6cqi 1.4cqi rgba(0, 0, 0, 0.35); transform: rotate(var(--r)) translateY(-1.5cqi) scale(1.08); }
.tn-note.on { transform: rotate(var(--r)); }
.tn-stage[data-lid="closed"] .tn-note.on { opacity: 0; }
.tn-note:nth-of-type(odd) { background: #f6c9a8; }
.tn-note b { font-weight: inherit; }
.tn-note i { display: none; font-style: normal; }

.tn-moon { position: absolute; right: 4%; top: 8%; width: clamp(40px, 7%, 64px); height: auto; transform: translateY(60px); transition: opacity 1.6s ease, transform 2.4s cubic-bezier(.2, .7, .2, 1) !important; filter: drop-shadow(0 0 22px rgba(240, 162, 75, 0.45)); }
.tn-moon.on { transform: none; }

.tn-strip { display: flex; gap: clamp(16px, 3vw, 40px); align-items: center; padding: 10px 22px; border-radius: 999px; background: rgba(10, 6, 14, 0.5); border: 1px solid rgba(255, 255, 255, 0.07); }
.tn-st { display: flex; align-items: center; gap: 10px; }
.tn-st > span:last-child { display: flex; flex-direction: column; gap: 3px; }
.tn-st small { font: 500 11px/1 var(--tn-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--tn-dim); }
.tn-st b { font: 600 14px/1 var(--tn-mono); color: var(--tn-text); font-variant-numeric: tabular-nums; min-width: 6ch; }
.tn-fan { width: 30px; height: 30px; fill: var(--tn-text-2); }
.tn-fan circle { fill: #2a2030; }
.tn-fan g { transform-origin: 20px 20px; animation: tn-spin linear infinite paused; }
.tn-fan .a { animation-duration: 2.4s; }
.tn-fan .b { animation-duration: 1.1s; }
.tn-fan .c { animation-duration: 0.5s; }
.tn-stage[data-fan="1"] .tn-fan .a, .tn-stage[data-fan="2"] .tn-fan .a, .tn-stage[data-fan="2"] .tn-fan .b, .tn-stage[data-fan="3"] .tn-fan g { animation-play-state: running; }
.tn-stage[data-fan="3"] .tn-fan { fill: #ffb08a; }
.tn-stage[data-fan="0"] .tn-fan { fill: var(--tn-dim); }
.tn-clk { width: 30px; height: 30px; fill: none; stroke: var(--tn-text-2); stroke-linecap: round; }
.tn-clk circle { stroke-width: 1.6; opacity: 0.5; }
.tn-clk line { stroke-width: 2.4; transform-origin: 20px 20px; transition: transform 1.6s cubic-bezier(.5, 0, .2, 1); }
.tn-clk .h { transform: rotate(var(--ha, 0deg)); }
.tn-clk .m { transform: rotate(var(--ma, 0deg)); stroke: var(--tn-amber); stroke-width: 1.8; }
.tn-therm { width: 10px; height: 30px; border-radius: 6px; background: rgba(255, 255, 255, 0.1); position: relative; overflow: hidden; }
.tn-therm i { position: absolute; inset: 0; transform-origin: 50% 100%; transform: scaleY(calc(0.12 + var(--heat, 0) * 0.88)); background: linear-gradient(0deg, #f0a24b, var(--tn-heat)); transition: transform 1.2s ease; }

/* ── Ending ── */
.tn-end { position: relative; max-width: 980px; margin: 0 auto; padding: 18vh 40px 120px; text-align: center; scroll-margin-top: var(--rail-h); }
.tn-end-moon { width: 56px; height: 56px; margin-bottom: 26px; filter: drop-shadow(0 0 24px rgba(240, 162, 75, 0.45)); }
.tn-end-h { margin: 0 0 48px; font: 800 clamp(44px, 6vw, 80px)/1 var(--tn-display); letter-spacing: -0.035em; text-wrap: balance; }
.tn-tally { text-align: left; padding: 8px 28px 24px; border-radius: 22px; background: rgba(30, 19, 40, 0.75); border: 1px solid var(--tn-line); }
.tn-tally-h, .tn-tally dl > div { display: grid; grid-template-columns: minmax(0, 1fr) 120px 220px; gap: 16px; align-items: baseline; }
.tn-tally-h { padding: 18px 0 10px; font: 600 12px/1 var(--tn-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--tn-dim); }
.tn-tally-h b:last-child { color: var(--tn-amber); }
.tn-tally dl { margin: 0; }
.tn-tally dl > div { padding: 16px 0; border-top: 1px solid var(--tn-line); }
.tn-tally dt { font-size: 18px; color: var(--tn-text); }
.tn-tally dd { margin: 0; font: 800 34px/1 var(--tn-display); letter-spacing: -0.02em; }
.tn-tally .was { color: var(--tn-bad); }
.tn-tally .now { color: var(--tn-good); display: flex; align-items: baseline; gap: 12px; }
.tn-tally .now small { font: 500 13px/1.3 var(--tn-body); letter-spacing: 0; color: var(--tn-text-2); }
.tn-tally-n { margin: 16px 0 0; font-size: 15px; color: var(--tn-text-2); }
.tn-family { margin: 64px 0 28px; font: 700 26px/1.2 var(--tn-display); letter-spacing: -0.015em; color: var(--tn-text); }
.tn-cta { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
.tn-btn, .tn-btn2 { display: inline-flex; flex-direction: column; justify-content: center; min-height: 56px; padding: 0 26px; border-radius: 14px; text-decoration: none; font: 600 17px/1.15 var(--tn-body); }
.tn-btn { background: var(--tn-amber); color: var(--tn-amber-ink); }
.tn-btn2 { border: 1px solid rgba(255, 255, 255, 0.2); color: var(--tn-text); }
.tn-btn2 small { font-weight: 400; font-size: 13px; color: var(--tn-text-2); }
.tn-next { display: flex; width: fit-content; align-items: center; gap: 8px; min-height: 44px; margin: 36px auto 0; color: var(--amber); font-weight: 600; font-size: 17px; text-decoration: none; }
.tn-next:hover { text-decoration: underline; text-underline-offset: 4px; }
.tn-again { display: inline-flex; align-items: center; min-height: 44px; margin-top: 28px; color: var(--tn-text-2); font-size: 15px; }

/* ── Keyframes ── */
@keyframes tn-spin { to { transform: rotate(360deg); } }
@keyframes tn-blink { 50% { opacity: 0.2; } }
@keyframes tn-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
@keyframes tn-back-h { from { transform: rotate(585deg); } to { transform: rotate(268.5deg); } }
@keyframes tn-back-m { from { transform: rotate(7020deg); } to { transform: rotate(3222deg); } }
@keyframes tn-prog { to { transform: scaleX(1); } }

/* Continuous bits tied to the scroll, where the browser can. */
@supports (animation-timeline: scroll()) {
  .tn-prog { animation: tn-prog linear both; animation-timeline: scroll(root block); }
  .tn-act-h, .tn-turn-h, .tn-end-h, .tn-tally { animation: tn-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
}

/* ── Phone: the stage pinned on top, the beats beneath ── */
@media (max-width: 900px) {
  .tn { --rail-h: 52px; --stage-h: 46svh; }
  .tn-rail { padding: 0 6px; gap: 0; background: rgba(12, 8, 16, 0.96); }
