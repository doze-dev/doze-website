---
// Every marketing page: the shared head, header and footer.
import "../styles/tokens.css";
import "../styles/site.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  theme?: "doze" | "aws" | "kafka";
}
const { title, description = site.description, theme = "doze" } = Astro.props;
const fullTitle = title ? `${title} · doze` : `doze · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en" data-product={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/brand/doze.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#140C1B" />
  </head>
  <body>
    <Header current={theme} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
