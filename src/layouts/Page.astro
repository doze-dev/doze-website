---
// Every page outside the docs: head, header, footer, and the copy-button script.
import "../styles/tokens.css";
import "../styles/site.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader, { type Theme } from "../components/SiteHeader.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  theme?: Theme;
  current?: string;
  news?: string;
  newsHref?: string;
}
const { title, description = site.description, theme = "dark", current = "none", news, newsHref } = Astro.props;
const fullTitle = !title ? `doze · ${site.tagline}` : /\bdoze\b/.test(title) ? title : `${title} · doze`;
const canonical = new URL(Astro.url.pathname, site.url);
const ground = { dark: "#140C1B", aws: "#0C1320", kafka: "#16150F", light: "#FFFAF4" }[theme];
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/brand/doze.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content={ground} />
    <link rel="alternate" type="application/atom+xml" title="doze changelog" href="/changelog.xml" />
  </head>
  <body style={`background:${ground}`}>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader theme={theme} current={current} news={news} newsHref={newsHref} />
    <main id="main"><slot /></main>
    <SiteFooter theme={theme} />
    <script>import "../scripts/copy.ts";</script>
  </body>
</html>
