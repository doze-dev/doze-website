---
// One stack, three ways: Tiles, List, Map. Every view is rendered; the
// buttons only choose which shows (without script, Tiles stays).
import type { Picked } from "./media";

interface Props {
  views: { name: string; media: Picked; alt: string }[];
}
const { views } = Astro.props;
---
<div class="vw" data-vw>
  <div class="pp-win vw-win">
    <div class="pp-bar vw-bar"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
      <div class="vw-seg" role="group" aria-label="Show the stack as">
        {views.map((v, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-vw-btn={i}>{v.name}</button>)}
      </div>
    </div>
    {views.map((v, i) => (
      <div class="vw-pane" data-vw-pane={i} hidden={i !== 0}>
        {v.media.video ? <video src={v.media.src} aria-label={v.alt} muted loop playsinline preload="none" data-pp-video width="1440" height="900"></video> : <img src={v.media.src} alt={v.alt} width="1440" height="900" loading="lazy" decoding="async" />}
      </div>
    ))}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-vw]")) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>("[data-vw-btn]")];
    const panes = [...root.querySelectorAll<HTMLElement>("[data-vw-pane]")];
    for (const b of btns)
      b.addEventListener("click", () => {
        const i = Number(b.dataset.vwBtn);
        btns.forEach((o, j) => o.setAttribute("aria-pressed", String(j === i)));
        panes.forEach((p, j) => (p.hidden = j !== i));
      });
  }
</script>

<style>
  .vw { width: min(100cqw, (100cqh - 56px) * 1.6); max-width: 100%; }
  .vw-win { width: 100%; display: flex; flex-direction: column; }
  .vw-bar { height: 54px; position: relative; }
  .vw-seg { position: absolute; left: 50%; transform: translateX(-50%); display: flex; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 9px; padding: 2px; }
  .vw-seg button { min-height: 44px; min-width: 64px; padding: 0 12px; border: 0; border-radius: 7px; background: transparent; color: #a8a2c4; font: 500 13px var(--font-text); cursor: pointer; transition: background var(--t-mid), color var(--t-mid); }
  .vw-seg button[aria-pressed="true"] { background: #2b2542; color: #f4f1ff; }
  .vw-seg button:hover { color: #f4f1ff; }
  .vw-pane { aspect-ratio: 16 / 10; }
  .vw-pane img, .vw-pane video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  @media (max-width: 760px) {
    .vw { width: 100%; }
    .vw-seg { position: static; transform: none; margin-left: auto; }
    .vw-seg button { min-width: 52px; min-height: 44px; padding: 0 8px; font-size: 12px; }
  }
</style>
