---
// The menu bar, drawn from the app's own menu (internal/desk/app/tray.go):
// a line per stack with its quiet second half, then Open doze, Settings…,
// Check for Updates…, and Quit, which leaves the stacks running. Shown only
// until a capture of the real menu exists.
---
<div class="mb" role="img" aria-label="The doze menu: three stacks, larder running, then Open doze, Settings, Check for Updates, and Quit doze, stacks keep running">
  <div class="mb-strip" aria-hidden="true">
    <span class="mb-clock">Tue 18:42</span>
    <span class="mb-bat"><img src="/brand/doze.svg" alt="" width="18" height="18" /></span>
  </div>
  <div class="mb-menu" aria-hidden="true">
    <div class="mb-h">Stacks</div>
    <div class="mb-i"><span>●&#8194;larder</span><span class="mb-d">[n] awake · [MB]</span></div>
    <div class="mb-i"><span>●&#8194;acme</span><span class="mb-d">[n] awake</span></div>
    <div class="mb-i"><span>○&#8194;billing</span><span class="mb-d">up 3 days ago</span></div>
    <div class="mb-sep"></div>
    <div class="mb-i"><span>Open doze</span><span class="mb-d">⇧⌘D</span></div>
    <div class="mb-i"><span>Settings…</span><span class="mb-d">⌘,</span></div>
    <div class="mb-i"><span>Check for Updates…</span></div>
    <div class="mb-i mb-q"><span>Quit doze · stacks keep running</span></div>
  </div>
</div>

<style>
  .mb { position: relative; height: 100%; min-height: 300px; border-radius: 14px; overflow: hidden; border: 1px solid var(--ln2); background: radial-gradient(120% 90% at 80% 0%, #3a2448, #1a1022 60%, #120a18); display: flex; flex-direction: column; align-items: flex-end; }
  .mb-strip { align-self: stretch; height: 30px; display: flex; justify-content: flex-end; align-items: center; gap: 16px; padding: 0 16px; background: rgba(20, 12, 27, 0.55); backdrop-filter: blur(8px); font: 500 13px var(--font-text); color: #f4ece4; }
  .mb-strip { flex-direction: row-reverse; justify-content: flex-start; }
  .mb-bat { width: 26px; height: 22px; display: grid; place-items: center; border-radius: 5px; background: rgba(255, 255, 255, 0.16); }
  .mb-bat img { border-radius: 4px; }
  .mb-menu { margin: 6px 64px 24px 24px; width: min(360px, calc(100% - 48px)); background: rgba(243, 238, 246, 0.96); color: #2b2232; border-radius: 11px; padding: 6px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5); font-size: 13.5px; }
  .mb-h { padding: 6px 12px 3px; font-size: 11.5px; font-weight: 600; color: #6a5e76; }
  .mb-i { display: flex; justify-content: space-between; gap: 14px; padding: 5px 12px; border-radius: 6px; white-space: nowrap; }
  .mb-i:nth-child(2) { background: #7a4fe0; color: #fff; }
  .mb-i:nth-child(2) .mb-d { color: #e9e0ff; }
  .mb-d { color: #6a5e76; overflow: hidden; text-overflow: ellipsis; }
  .mb-sep { height: 1px; background: #ddd3e3; margin: 5px 8px; }
  @media (max-width: 760px) { .mb { min-height: 0; } .mb-menu { margin: 6px 12px 16px; width: calc(100% - 24px); font-size: 12.5px; } }
</style>
