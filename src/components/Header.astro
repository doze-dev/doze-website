---
import { nav, site } from "../site";

interface Props {
  current?: string;
}
const path = Astro.url.pathname;
---
<header class="top">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label="doze home">
      <img src="/brand/doze.svg" alt="" width="30" height="30" />
      <span>doze</span>
    </a>
    <nav aria-label="Site">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <a class="gh" href={site.github}>GitHub</a>
  </div>
</header>

<style>
  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--night) 88%, transparent); backdrop-filter: saturate(140%) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 28px; height: 64px; }
  .mark { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 800 21px var(--font-display); letter-spacing: -0.02em; }
  .mark img { border-radius: 8px; }
  nav { display: flex; gap: 22px; flex: 1; overflow-x: auto; }
  nav a { text-decoration: none; color: var(--text-2); font-weight: 500; white-space: nowrap; }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); }
  .gh { text-decoration: none; color: var(--text-2); font-weight: 500; }
  @media (max-width: 720px) { .gh { display: none; } .bar { gap: 16px; } }
</style>
