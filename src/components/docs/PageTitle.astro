---
// Starlight PageTitle override (boards Docs2Task, Docs2Home): a small
// breadcrumb (Docs › product › group), the title, and the page's description
// as its lede. The version is in the docs bar. Under 1180px, where the right
// rail is gone, a long page gets its "On this page" list here (Docs2Phone).
import { docsProducts, productFor } from "./products";

// Starlight links "Overview" in the contents to this id.
const PAGE_TITLE_ID = "_top";

const { entry, sidebar, toc } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const product = productFor(path) ?? docsProducts[0];
const isIndex = path === product.href;

type Entry = (typeof sidebar)[number];
// The groups that hold the current page: ["Guides", "Recipes"].
const trail = (entries: Entry[]): string[] | undefined => {
  for (const e of entries) {
    if (e.type === "link") {
      if (e.isCurrent) return [];
    } else {
      const inner = trail(e.entries);
      if (inner) return [e.label, ...inner];
    }
  }
  return undefined;
};
const groups = isIndex ? [] : (trail(sidebar) ?? []);
type TocItem = NonNullable<typeof toc>["items"][number];
const flat = (items: TocItem[]): TocItem[] => items.flatMap((i) => [i, ...flat(i.children)]);
const headings = toc ? flat(toc.items).filter((i) => i.slug !== PAGE_TITLE_ID && i.depth === 2) : [];
---
<div class="dz-head">
  <nav class="dz-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
    <a href="/docs/">Docs</a>
    <span aria-hidden="true">›</span>
    {isIndex ? <span aria-current="page" class="dz-crumb-now">{product.name}</span> : <a href={product.href}>{product.name}</a>}
    {groups.map((g) => (
      <>
        <span aria-hidden="true">›</span>
        <span>{g}</span>
      </>
    ))}
  </nav>
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  {entry.data.description && <p class="dz-lede">{entry.data.description}</p>}
  {headings.length >= 3 && (
    <details class="dz-otp print:hidden" data-pagefind-ignore>
      <summary>On this page <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
      <ul>{headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
    </details>
  )}
</div>
