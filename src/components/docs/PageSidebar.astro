---
// Starlight PageSidebar override: the right rail (Docs2Task): "On this page",
// then "Edit this page". Hidden under 1180px (PageTitle and Footer carry both).
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";
import EditLink from "./EditLink.astro";

const { toc, editUrl } = Astro.locals.starlightRoute;
---
{toc && <TableOfContents />}
{editUrl && <div class="dz-rail-edit"><EditLink /></div>}
