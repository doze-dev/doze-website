---
// Starlight TwoColumnContent override: the article, then the right rail
// beside it (boards: 740px article, 200px rail, hidden under 1180px).
const { toc, editUrl } = Astro.locals.starlightRoute;
---
<div class="dz-cols">
  <div class="dz-main"><slot /></div>
  {(toc || editUrl) && <div class="dz-toc print:hidden"><slot name="right-sidebar" /></div>}
</div>
