---
// Starlight Footer override (the end of the article, not the site footer):
// previous/next cards. The edit link lives in the right rail; under 1180px,
// where the rail is hidden, it shows here instead.
import EditLink from "./EditLink.astro";
import Pagination from "./Pagination.astro";

const { editUrl, entry } = Astro.locals.starlightRoute;
---
{!entry.data.hero && <Pagination />}
{editUrl && (
  <div class="dz-meta">
    <EditLink />
  </div>
)}
