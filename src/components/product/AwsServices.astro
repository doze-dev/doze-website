---
// The doze AWS console, service by service, as a vertical carousel: each
// slide a real screen of the console with what it shows. Captures are from
// the console's demo stack until they are re-taken with Larder.
import VCarousel from "../motion/VCarousel.astro";
import Shot from "./Shot.astro";

const list = [
  {
    name: "The map",
    title: "See how your stack is wired.",
    line: "A topic feeding a queue, its dead-letter queue, a rule targeting a function: every resource wired to another, and the wire between.",
    img: "/media/aws-map.webp",
    path: "map",
    alt: "The doze AWS map: order-events feeds jobs, which redrives to jobs-dlq; the receipts rule targets the resize function",
  },
  {
    name: "Lambda",
    title: "Functions are real host processes.",
    line: "Invoke one and see the response and its log tail: here a Node function in 2.32 ms. No Docker. Warm, and it sleeps after 10 idle minutes.",
    img: "/media/aws-lambda.webp",
    path: "lambda/resize",
    alt: "The resize Lambda: triggers, warm state, a successful invoke with its response and log tail",
  },
  {
    name: "DynamoDB",
    title: "Browse and query tables.",
    line: "Scan, query, get and PartiQL, the way you would on AWS. GSIs, transactions and TTL underneath.",
    img: "/media/aws-dynamodb.webp",
    path: "ddb/orders",
    alt: "The orders table: six items with scan, query, get and PartiQL",
  },
  {
    name: "S3",
    title: "Buckets on your disk.",
    line: "Browse and upload, with event notifications to SQS, SNS and Lambda, as on AWS.",
    img: "/media/aws-s3.webp",
    path: "s3/uploads",
    alt: "The uploads bucket with three receipts",
  },
  {
    name: "SQS",
    title: "Peek at a queue without consuming it.",
    line: "What feeds it, where its dead letters go, and every message. FIFO, DLQ redrive and long polling.",
    img: "/media/aws-sqs.webp",
    path: "sqs/jobs",
    alt: "The jobs queue: five messages, fed by order-events, dead letters to jobs-dlq",
  },
  {
    name: "EventBridge",
    title: "A rule, its pattern, its targets.",
    line: "The full pattern language, cron and rate schedules, input transformers, and what each rule drains to.",
    img: "/media/aws-eventbridge.webp",
    path: "eb/default/rule/receipts",
    alt: "The receipts rule with its event pattern and its Lambda target",
  },
  {
    name: "Step Functions",
    title: "Follow a state machine.",
    line: "Standard and Express, JSONata, task tokens and Map runs, with every execution, succeeded and failed.",
    img: "/media/aws-stepfunctions.webp",
    path: "sfn",
    alt: "The checkout state machine with a succeeded and a failed execution",
  },
  {
    name: "IAM",
    title: "The policy your tests actually needed.",
    line: "Real policy evaluation, on by default in soft mode: evaluated and logged, never blocked. Run your tests, then generate the least-privilege policy they used.",
    img: "/media/aws-iam.webp",
    path: "iam",
    alt: "The IAM access log: every action recorded, a policy generator and a simulator",
  },
];
const pad = (n: number) => String(n).padStart(2, "0");
---
<VCarousel label="The doze AWS console, service by service" height="min(780px, 86vh)" class="pp-vc">
  {list.map((s, i) => (
    <div data-slide data-label={s.name} class="pp-slide">
      <div class="pp-slide-top">
        <div>
          <span class="pp-step">{pad(i + 1)} / {pad(list.length)} · {s.name}</span>
          <h3>{s.title}</h3>
        </div>
        <div class="pp-slide-say">
          <p>{s.line}</p>
          <span class="pp-also"><span class="pp-pending">the real console, from its demo stack · re-capture with Larder</span></span>
        </div>
      </div>
      <div class="pp-slide-media">
        <Shot src={s.img} alt={s.alt} title={`doze AWS · /_console/${s.path}`} />
      </div>
    </div>
  ))}
</VCarousel>
