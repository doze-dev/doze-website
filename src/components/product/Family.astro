---
// The endorsement every product page carries, as a closing strip: the three
// products as equals, this one marked. No moon here: the moon is the
// family's own mark and never sits inside a product (design/BRAND.md).
interface Props {
  current: "doze" | "aws" | "kafka";
}
const { current } = Astro.props;
const products = [
  {
    id: "doze",
    name: "doze",
    icon: "/brand/doze.svg",
    line: "Wakes your stack when you start. Sleeps it when you stop.",
    href: "/doze/",
    docs: "/docs/doze/",
    colour: "#F0A24B",
  },
  {
    id: "aws",
    name: "doze AWS",
    icon: "/brand/doze-aws.svg",
    line: "Wakes AWS on your laptop. No account, no bill.",
    href: "/aws/",
    docs: "/docs/aws/",
    colour: "#5BB8E8",
  },
  {
    id: "kafka",
    name: "doze Kafka",
    icon: "/brand/doze-kafka.svg",
    line: "Wakes a Kafka broker. No JVM to put to bed.",
    href: "/kafka/",
    docs: "/docs/kafka/",
    colour: "#FFD60A",
  },
];
---
<section class="pf" aria-labelledby="pf-h">
  <div class="pp-wrap pf-in">
    <div class="pf-say">
      <h2 class="pf-h" id="pf-h">Part of the doze family. <span>Works alone.</span></h2>
      <p class="pf-p">Three products, each its own download, each happy on its own. Together, doze runs the other two inside your stack and gives them names.</p>
    </div>
    <div class="pf-cards">
      {products.map((p) => (
        <a class={`pf-card${p.id === current ? " is-here" : ""}`} href={p.id === current ? p.docs : p.href} style={`--c:${p.colour}`} aria-current={p.id === current ? "page" : undefined}>
          <img src={p.icon} alt="" width="40" height="40" />
          <span class="pf-name">{p.name}{p.id === current && <em>you're here · docs →</em>}</span>
          <span class="pf-line">{p.line}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pf { padding: 88px 0; border-top: 1px solid var(--ln); background: var(--g2); }
  .pf-in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 40px; align-items: center; }
  .pf-say { display: flex; flex-direction: column; gap: 12px; }
  .pf-h { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 3vw, 38px); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .pf-h span { color: var(--acc); }
  .pf-p { margin: 0; color: var(--t2); line-height: 1.6; }
  .pf-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .pf-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: 16px; border: 1px solid var(--ln); background: var(--g); color: var(--t1) !important; min-height: 44px; transition: transform var(--t-mid) var(--ease-out), border-color var(--t-mid); }
  .pf-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--c) 60%, transparent); }
  .pf-card.is-here { border-color: color-mix(in srgb, var(--c) 70%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 35%, transparent) inset; }
  .pf-card img { width: 40px; height: 40px; border-radius: 10px; }
  .pf-name { font-weight: 700; font-size: 17px; display: flex; flex-direction: column; gap: 2px; }
  .pf-name em { font-style: normal; font: 500 11.5px var(--font-mono); color: var(--c); letter-spacing: 0.04em; }
  .pf-line { font-size: 14px; color: var(--t2); line-height: 1.45; }
  @media (max-width: 960px) { .pf-in { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .pf { padding: 64px 0; } .pf-cards { grid-template-columns: minmax(0, 1fr); } .pf-card { flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 14px; } .pf-line { flex-basis: 100%; } }
</style>
