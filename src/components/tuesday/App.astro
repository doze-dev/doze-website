---
// The doze app on the Tuesday laptop (Act five), drawn in HTML from the app's
// own screens, so the second Tuesday is told in the window, not a terminal.
// Every word is the app's (internal/desk/frontend/src: titlebar.tsx,
// pages/library.tsx, overview.tsx's strip, instance.tsx's PortClash card,
// logs.tsx; internal/desk/view/away.go's "crashed in"), laid out as the
// boards in doze/docs/design/desktop/boards draw them (Library, MapFlow,
// MapFlowSelected, PortClash, InstanceLogs, MenuBar). The palette is the
// app's default dark theme, the same as components/doze/appdraw.css.
// Larder's figures are MapFlow's own; billing's are the story's.
// Decorative, inside the aria-hidden stage: the beats say it all in words.
import FlowMap, { type FlowData } from "./FlowMap.astro";
import { on } from "./steps";

// Where each page of the window shows.
const home = on("d0902", "d1400", "d1842");
const larderMap = on("d0903", "d1130");
const billingMap = on("d1406", "d1530");
const gateway = on("d0905");
const orders = on("d1131", "d1133");
const larderTrouble = on(["d0903", "d1133"]);

// Larder as the app maps it: boxes and paths from doze's golden
// (internal/desk/view/testdata/larder-map.json); the figures are MapFlow's.
const larder: FlowData = {
  w: 1430,
  h: 674,
  band: 534,
  caps: [
    { text: "Who calls whom", sub: "left to right, the way a request travels", x: 24, y: 16 },
    { text: "Nobody calls these", sub: "they work from events", x: 24, y: 420 },
    {
      text: "Shared by the stack",
      sub: "one line each would be 17 lines; the chips on each card say who uses what",
      x: 24,
      y: 544,
    },
  ],
  cards: [
    { n: "storefront", x: 24, y: 192, w: 214, h: 74, lang: "ts", mb: "61 MB", quiet: "no shared services", tone: "y" },
    {
      n: "gateway",
      x: 310,
      y: 192,
      w: 214,
      h: 74,
      lang: "go",
      mb: "46 MB",
      chips: ["redis"],
      bad: "port taken",
      badIn: on("d0903"),
    },
    { n: "identity", x: 596, y: 52, w: 250, h: 74, lang: "go", mb: "42 MB", chips: ["postgres", "kafka"] },
    { n: "fulfilment", x: 596, y: 192, w: 250, h: 74, lang: "py", mb: "52 MB", chips: ["kafka", "aws"] },
    {
      n: "recommendations",
      x: 596,
      y: 332,
      w: 250,
      h: 74,
      lang: "py",
      mb: "58 MB",
      chips: ["postgres", "kafka", "redis"],
    },
    {
      n: "orders",
      x: 918,
      y: 192,
      w: 214,
      h: 74,
      lang: "go",
      mb: "47 MB",
      chips: ["postgres", "kafka"],
      bad: "crashing",
      badIn: on("d1130"),
    },
    { n: "catalog", x: 1204, y: 192, w: 214, h: 74, lang: "go", mb: "47 MB", chips: ["postgres", "aws"] },
    { n: "payments", x: 24, y: 444, w: 214, h: 74, lang: "go", mb: "47 MB", chips: ["postgres", "kafka", "redis"] },
    { n: "notifications", x: 310, y: 444, w: 214, h: 74, lang: "ts", mb: "45 MB", chips: ["kafka", "mailpit"] },
    {
      n: "mailpit",
      x: 24,
      y: 570,
      w: 214,
      h: 88,
      mb: "24 MB",
      what: "brought in by you",
      used: "used by 1",
      only: "notifications",
    },
    { n: "redis", x: 310, y: 570, w: 214, h: 88, mb: "5 MB", what: "valkey 9", used: "used by 3" },
    { n: "kafka", x: 596, y: 570, w: 250, h: 88, mb: "24 MB", what: "kafka 4", used: "used by 6" },
    { n: "postgres", x: 918, y: 570, w: 214, h: 88, mb: "13 MB", what: "postgres 18", used: "used by 5" },
    { n: "aws", x: 1204, y: 570, w: 214, h: 88, mb: "25 MB", what: "aws", used: "used by 2" },
  ],
  edges: [
    "M238 229 C 274 229, 256 229, 292 229 L 300 229",
    "M524 229 L 536 229 Q 548 229, 548 217 L 548 107 Q 548 89, 566 89 L 586 89",
    "M524 229 C 560 229, 542 229, 578 229 L 586 229",
    "M524 229 L 536 229 Q 548 229, 548 241 L 548 351 Q 548 369, 566 369 L 586 369",
    "M496 192 L 496 175.5 Q 496 159, 512.5 159 L 929.5 159 Q 946 159, 946 175.5 L 946 182",
    "M496 266 L 496 282.5 Q 496 299, 512.5 299 L 1215.5 299 Q 1232 299, 1232 282.5 L 1232 276",
    "M846 229 C 882 229, 864 229, 900 229 L 908 229",
    "M846 369 L 1316 369 Q 1334 369, 1334 351 L 1334 276",
    "M1132 229 C 1168 229, 1150 229, 1186 229 L 1194 229",
  ],
};

// billing: the repo from spring, with the TypeScript service nobody told you
// about, laid out with flow.go's constants (one row; the middle column 250).
const billing: FlowData = {
  w: 1430,
  h: 290,
  band: 150,
  caps: [
    { text: "Who calls whom", sub: "left to right, the way a request travels", x: 24, y: 16 },
    { text: "Shared by the stack", sub: "the chips on each card say who uses what", x: 24, y: 160 },
  ],
  cards: [
    { n: "portal", x: 24, y: 52, w: 214, h: 74, lang: "ts", mb: "58 MB", quiet: "no shared services" },
    { n: "invoices", x: 310, y: 52, w: 214, h: 74, lang: "ts", mb: "44 MB", chips: ["postgres"] },
    { n: "notifications", x: 596, y: 52, w: 250, h: 74, lang: "ts", mb: "41 MB", chips: ["mailpit"], sel: on("d1406") },
    {
      n: "postgres",
      x: 24,
      y: 186,
      w: 214,
      h: 88,
      mb: "12 MB",
      what: "postgres 18",
      used: "used by 1",
      only: "invoices",
    },
    {
      n: "mailpit",
      x: 310,
      y: 186,
      w: 214,
      h: 88,
      mb: "asleep",
      what: "brought in by you",
      used: "used by 1",
      only: "notifications",
      tone: "off",
    },
  ],
  edges: ["M238 89 C 274 89, 256 89, 292 89 L 300 89", "M524 89 C 560 89, 542 89, 578 89 L 586 89"],
};

// The sidebar of a Larder service page.
const side: [string, [string, string, string?][]][] = [
  [
    "Apps",
    [
      ["storefront", "dozing"],
      ["gateway", "46 MB", gateway],
      ["identity", "42 MB"],
      ["catalog", "47 MB"],
      ["orders", "47 MB", orders],
      ["payments", "47 MB"],
      ["fulfilment", "52 MB"],
      ["recommendations", "58 MB"],
      ["notifications", "45 MB"],
    ],
  ],
  [
    "Modules",
    [
      ["postgres", "13 MB"],
      ["redis", "5 MB"],
      ["kafka", "24 MB"],
      ["aws", "25 MB"],
    ],
  ],
  ["Outside", [["mailpit", "24 MB"]]],
];
const sideBad: Record<string, [string, string]> = { gateway: ["port taken", gateway], orders: ["crashing", orders] };

// The Library's rows: name, folder, what each says at each step it shows.
type Cell = { in: string; fig: string; sub: string; when: string; busy?: boolean };
const rows: { n: string; dir: string; on: string; sel: string; cells: Cell[] }[] = [
  {
    n: "larder",
    dir: "~/code/larder · 14 declared",
    on: on("d0902", "d1400"),
    sel: on("d0902", "d1842"),
    cells: [
      {
        in: on("d0902"),
        fig: "<i class=g>5 awake</i> · <i class=c>7 waking</i> · 2 asleep",
        sub: "212 MB · 6 connections",
        when: "starting…",
        busy: true,
      },
      {
        in: on("d1400"),
        fig: "<i class=g>13 awake</i> · <i class=y>1 dozing</i>",
        sub: "536 MB · 21 connections",
        when: "up 5h",
      },
      { in: on("d1842"), fig: "stopped", sub: "last time: everything", when: "up 9h ago" },
    ],
  },
  {
    n: "billing",
    dir: "~/code/billing · 5 declared",
    on: on("d1400", "d1842"),
    sel: on("d1400"),
    cells: [
      { in: on("d0902"), fig: "stopped", sub: "last time: everything", when: "up 7 months ago" },
      {
        in: on("d1400"),
        fig: "<i class=g>2 awake</i> · <i class=c>2 waking</i> · 1 asleep",
        sub: "70 MB · 1 connection",
        when: "starting…",
        busy: true,
      },
      { in: on("d1842"), fig: "5 asleep", sub: "no connections", when: "up 4h" },
    ],
  },
  {
    n: "client-site",
    dir: "~/work/client-site · 3 declared",
    on: "",
    sel: "",
    cells: [{ in: home, fig: "stopped", sub: "last time: everything", when: "up 7 days ago" }],
  },
];

const house =
  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 7.2 8 2.5l5.5 4.7" /><path d="M4 6.2v7h3v-3.6h2v3.6h3v-7" /></svg>';
---
<div class="tn-win tn-app" data-in={on(["d0902", "d1530"], "d1842")}>
  <!-- the title bar: Home, a tab per running stack, ⌘K -->
  <div class="ta-tb">
    <i></i><i></i><i></i>
    <span class="ta-tab" data-hi={home}><Fragment set:html={house} />Home</span>
    <span class="ta-tab ta-tab-x" data-in={on(["d0902", "d1530"])} data-hi={on("d0903", "d0905", ["d1130", "d1133"])}>
      <b class="ta-d g" data-in={on("d0902", ["d1400", "d1530"])}></b><b class="ta-d r" data-in={larderTrouble}></b>larder<span class="ta-badge" data-in={larderTrouble}>1</span>
    </span>
    <span class="ta-tab ta-tab-x" data-in={on(["d1400", "d1530"], "d1842")} data-hi={on("d1406", "d1530")}><b class="ta-d g on"></b>billing</span>
    <span class="ta-sp"></span>
    <span class="ta-cmd"><kbd>⌘K</kbd> Search or do</span>
  </div>

  <!-- Home: every stack on this machine, a switch each -->
  <div class="ta-pg ta-home" data-in={home}>
    <div class="ta-hd">
      <img src="/brand/doze.svg" alt="" width="40" height="40" />
      <div class="ta-brand"><b>doze</b><span>starts a service when something connects, and puts it to sleep when nothing does · 3 stacks · 1 up</span></div>
      <span class="ta-sp"></span>
      <span class="ta-btn">Open folder… <kbd>⌘O</kbd></span>
    </div>
    <div class="ta-lib">
      <div class="ta-lr ta-lh"><span></span><span>Stack</span><span>Running</span><span class="rt">Last</span><span></span></div>
      {rows.map((r) => (
        <div class="ta-lr" data-hi={r.sel}>
          <span class="ta-ldot" data-hi={r.on}></span>
          <div class="ta-nm"><b>{r.n}</b><span>{r.dir}</span></div>
          <div class="ta-x">
            {r.cells.map((c) => (
              <div class="ta-fig" data-in={c.in}><span set:html={c.fig} /><span class="ta-dim">{c.sub}</span></div>
            ))}
          </div>
          <div class="ta-x r">
            {r.cells.map((c) => <span class:list={["ta-when", { c: c.busy }]} data-in={c.in}>{c.when}</span>)}
          </div>
          <span class="ta-sw" data-hi={r.on}><i></i></span>
        </div>
      ))}
    </div>
    <div class="ta-model">Drop a project folder anywhere in this window, or press ⌘O, to add it.</div>
    <div class="ta-machine"><b>Machine</b><span><b class="ta-d g"></b>names</span><span><b class="ta-d g"></b>network daemon</span><span class="ta-sp"></span><span class="ta-dim">Doctor</span></div>
  </div>

  <!-- larder's overview, as a map -->
  <div class="ta-pg ta-ov" data-in={larderMap}>
    <div class="ta-oh">
      <b>larder</b><span class="ta-path">~/code/larder · up 1m</span>
      <span class="ta-sp"></span>
      <span class="ta-seg"><span>Tiles</span><span>List</span><span class="on">Map</span><span>Grid</span></span>
      <span class="ta-up">Up</span><span class="ta-sw hi"><i></i></span>
    </div>
    <div class="ta-strip">
      <div class="ta-st w"><span class="v"><span class="ta-x"><span data-in={on("d0903")}>490 MB</span><span data-in={on("d1130")}>489 MB</span></span><small>resident</small></span><span class="ta-bar"><i style="width:12%"></i><i style="width:11%"></i><i style="width:10%"></i><i style="width:42%"></i></span><span class="s">storefront 61 · recommendations 58 · fulfilment 52 · +10 more</span></div>
      <div class="ta-st"><span class="v">0.01<small>cores</small></span><span class="s">notifications 0.9% · the rest quiet</span></div>
      <div class="ta-st"><span class="v">12<small>awake</small></span><span class="s"><i class="y">1 dozing</i> · <i class="r">1 crashing</i></span></div>
      <div class="ta-st"><span class="v"><span class="ta-x"><span data-in={on("d0903")}>19</span><span data-in={on("d1130")}>20</span></span><small>connections</small></span><span class="s">tasks ✓ 9 done · 1 not run</span></div>
    </div>
    <div class="ta-map"><FlowMap m={larder} /></div>
  </div>

  <!-- billing's overview, as a map -->
  <div class="ta-pg ta-ov" data-in={billingMap}>
    <div class="ta-oh">
      <b>billing</b><span class="ta-path"><span class="ta-x"><span data-in={on("d1406")}>~/code/billing · up 6m</span><span data-in={on("d1530")}>~/code/billing · up 1h</span></span></span>
      <span class="ta-sp"></span>
      <span class="ta-seg"><span>Tiles</span><span>List</span><span class="on">Map</span><span>Grid</span></span>
      <span class="ta-up">Up</span><span class="ta-sw hi"><i></i></span>
    </div>
    <div class="ta-strip">
      <div class="ta-st w"><span class="v">155 MB<small>resident</small></span><span class="ta-bar"><i style="width:37%"></i><i style="width:28%"></i><i style="width:27%"></i></span><span class="s">portal 58 · invoices 44 · notifications 41 · postgres 12</span></div>
      <div class="ta-st"><span class="v">0.01<small>cores</small></span><span class="s">the rest quiet</span></div>
      <div class="ta-st"><span class="v">4<small>awake</small></span><span class="s">1 asleep</span></div>
      <div class="ta-st"><span class="v">3<small>connections</small></span><span class="s">tasks ✓ 3 done</span></div>
    </div>
    <div class="ta-map"><FlowMap m={billing} /></div>
  </div>

  <!-- a Larder service: the sidebar, and the page of the one in trouble -->
  <div class="ta-pg ta-svc" data-in={on("d0905", "d1131", "d1133")}>
    <nav class="ta-side">
      <span class="ta-sh0">Overview</span>
      {side.map(([h, items]) => (
        <>
          <span class="ta-sh">{h}</span>
          {items.map(([n, v, sel]) => (
            <span class="ta-si" data-hi={sel ?? ""}>
              <span class="n">{n}</span>
              {sideBad[n] ? (
                <span class="ta-x r"><span data-in={on("d0905", "d1131", "d1133").split(" ").filter((s) => !sideBad[n][1].split(" ").includes(s)).join(" ")}>{v}</span><span class="r" data-in={sideBad[n][1]}>{sideBad[n][0]}</span></span>
              ) : (
                <span class:list={["v", { y: v === "dozing" }]}>{v}</span>
              )}
            </span>
          ))}
        </>
      ))}
      <span class="ta-ver">doze 0.2</span>
    </nav>

    <!-- 9:05: gateway's port, and who holds it -->
    <div class="ta-main" data-in={gateway}>
      <div class="ta-ih"><b>gateway</b><span class="ta-path">go run ./apps/gateway · <i class="r">port taken</i></span></div>
      <div class="ta-tabs2"><span class="on">Overview</span><span>Logs</span></div>
      <section class="ta-card ta-clash">
        <h5>Port 8000 is taken <span>· gateway cannot listen while python3, pid 5387 has it</span></h5>
        <div class="ta-opt">
          <span class="k">1</span>
          <div class="t"><b>Stop pid 5387 and start gateway</b><span>doze sends it a polite TERM. It is not one of doze's; doze looks again that it still holds the port first.</span></div>
          <span class="ta-btn pri">Stop python3</span>
        </div>
        <div class="ta-opt">
          <span class="k">2</span>
          <div class="t"><b>Use another port</b><span>Change port = 8000 in doze.hcl; gateway's name keeps working on whatever you pick.</span></div>
          <span class="ta-btn">Edit doze.hcl</span>
        </div>
        <div class="ta-dim">doze never stops a process it did not start without asking, which is why this is a question and not a thing that happened.</div>
      </section>
    </div>

    <!-- 11:31: orders' Logs tab, this run -->
    <div class="ta-main" data-in={orders}>
      <div class="ta-ih"><b>orders</b><span class="ta-path">go run ./services/orders · <i class="r">crashing · try 2 of 5</i> · next in 8 s</span><span class="ta-sp"></span><span class="ta-btn">Stop trying <kbd>s</kbd></span><span class="ta-btn">Try now <kbd>r</kbd></span></div>
      <div class="ta-tabs2"><span>Overview</span><span class="on">Logs</span></div>
      <div class="ta-lf">
        <span class="ta-seg"><span>Debug</span><span class="on">Info+</span><span>Warn+</span><span>Errors</span></span>
        <span class="ta-seg"><span class="on">This run</span><span>All 2 runs</span></span>
        <span class="ta-seg"><span class="on">Relative</span><span>Clock</span></span>
      </div>
      <div class="ta-logs">
        <div class="ta-run">run 2 · started 11:31:04 · exit 1 after 0.6 s · 3 lines</div>
        <div class="ln"><i>-2s</i><span class="lv">INF</span>orders starting · connecting to postgres as orders</div>
        <div class="ln err"><i>-2s</i><span class="lv">ERR</span>failed to connect to `user=orders database=postgres`: password authentication failed for user "orders" (SQLSTATE 28P01)</div>
        <div class="ln doze"><i>-2s</i><span class="lv"></span>doze: orders exited 1 after 0.6 s · try 2 of 5 · next in 8 s</div>
      </div>
    </div>
  </div>
</div>

<!-- 11:30: the notification, one per episode -->
<div class="ta-note" data-in={on("d1130")}>
  <img src="/brand/doze.svg" alt="" width="28" height="28" />
  <div><small>doze</small><b>orders crashed in larder</b><span>try 2 of 5 · password authentication failed for user "orders"</span></div>
  <span class="ta-btn">Show</span>
</div>

<style is:global>
/* The doze app, drawn: the app's default dark theme (as appdraw.css), sized
   in cqi of the laptop so it scales with the stage; px on small phones. */
.tn-win.tn-app {
  --a-bg: #15131d; --a-side: #110f18; --a-panel: #1b1927; --a-line: #2c2840; --a-line2: #37324b;
  --a-text: #cfcbe3; --a-dim: #9893b5; --a-bright: #f4f1ff; --a-acc: #bd93f9; --a-good: #7ee787;
  --a-cool: #82aaff; --a-warn: #f2c879; --a-bad: #ff7a93; --a-track: #262236; --a-sel: #2b2542;
  left: 3%; top: 8.5%; width: 94%; height: 88%;
  background: var(--a-bg); color: var(--a-text); font: 400 1.22cqi/1.4 var(--tn-body);
  box-shadow: 0 0 0 0.12cqi var(--a-line2), 0 2cqi 5cqi rgba(0, 0, 0, 0.5);
}
.tn-app *, .ta-note * { box-sizing: border-box; }
.tn-app i { font-style: normal; }
.tn-app kbd, .ta-note kbd { font: 0.9em var(--tn-mono); opacity: 0.75; }
.tn-app .g { color: var(--a-good); }
.tn-app .c { color: var(--a-cool); }
.tn-app .y { color: var(--a-warn); }
.tn-app .r { color: var(--a-bad); }
.ta-sp { flex: 1; }
.ta-dim { color: var(--a-dim); }
.ta-x { display: grid; min-width: 0; }
.ta-x > * { grid-area: 1 / 1; min-width: 0; }
.ta-x.r { justify-items: end; }

.ta-tb { height: 3.6cqi; display: flex; align-items: center; gap: 0.5cqi; padding: 0 1.2cqi; background: var(--a-side); border-bottom: 0.12cqi solid var(--a-line); }
.ta-tb > i { width: 1cqi; height: 1cqi; border-radius: 50%; background: #ff5f57; flex: none; margin-right: 0.3cqi; }
.ta-tb > i:nth-child(2) { background: #febc2e; }
.ta-tb > i:nth-child(3) { background: #28c840; margin-right: 1.4cqi; }
.ta-tab { display: inline-flex; align-items: center; gap: 0.6cqi; height: 2.6cqi; padding: 0 1.2cqi; border-radius: 0.7cqi; font-size: 1.15cqi; color: var(--a-dim); white-space: nowrap; transition: background 0.3s, color 0.3s; }
.ta-tab svg { width: 1.3cqi; height: 1.3cqi; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.ta-tab.hi { background: var(--a-panel); color: var(--a-bright); font-weight: 600; }
.tn-stage .ta-tab-x[data-in]:not(.on) { display: none; }
.ta-d { position: relative; display: inline-block; flex: none; width: 0.8cqi; height: 0.8cqi; border-radius: 50%; background: var(--a-dim); }
.ta-tab .ta-d { position: absolute; }
.ta-tab-x { position: relative; padding-left: 2.4cqi; }
.ta-tab-x .ta-d { left: 1.1cqi; top: calc(50% - 0.4cqi); }
.ta-d.g { background: var(--a-good); }
.ta-d.r { background: var(--a-bad); }
.ta-tab .ta-badge { display: inline-grid; place-items: center; min-width: 1.6cqi; height: 1.6cqi; padding: 0 0.4cqi; border-radius: 0.8cqi; background: var(--a-bad); color: #1b1220; font: 700 1cqi/1 var(--tn-body); }
.tn-stage .ta-tab .ta-badge:not(.on) { display: none; }
.ta-cmd { display: inline-flex; align-items: center; gap: 0.6cqi; height: 2.5cqi; padding: 0 1cqi; border-radius: 0.6cqi; border: 0.12cqi solid var(--a-line2); font-size: 1.1cqi; color: var(--a-bright); white-space: nowrap; }

.ta-pg { position: absolute; inset: 3.6cqi 0 0; display: flex; flex-direction: column; gap: 1.4cqi; padding: 1.8cqi 1.8cqi; overflow: hidden; }
.ta-btn { display: inline-flex; align-items: center; gap: 0.6cqi; height: 2.5cqi; padding: 0 1.1cqi; border-radius: 0.6cqi; border: 0.12cqi solid var(--a-line2); background: var(--a-panel); color: var(--a-bright); font: 600 1.1cqi/1 var(--tn-body); white-space: nowrap; flex: none; }
